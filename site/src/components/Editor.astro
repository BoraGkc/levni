  .lv-mini button:hover { background: rgba(255,255,255,.12); }
  .lv-mini button[aria-pressed='true'] { color: var(--lime) !important; }
  .lv-drop { position: absolute; inset: 8px; display: grid; place-items: center; border: 2px dashed var(--accent); background: rgba(75,47,214,.06); color: var(--accent-text); font-weight: 700; pointer-events: none; }
  .lv-allsizes { display: grid; gap: 2px; width: 100%; margin-top: 8px; padding: 10px 12px; border: 1.5px dashed var(--indigo); background: transparent; text-align: left; cursor: pointer; color: var(--indigo); }
  .lv-allsizes:hover { background: var(--soft); }
  .lv-allsizes b { font: 700 14px/1.2 var(--display); }
  .lv-allsizes span { font-size: 12px; color: var(--ink-soft); }
  .lv-tpl-cell { position: relative; }
