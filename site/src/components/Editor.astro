    pose: ['standing', 'walking', 'running', 'sitting', 'pointing', 'waving', 'holding', 'carrying', 'reading', 'phone', 'thinking', 'cheering', 'kneeling', 'leaning'].map((p) => [p, p[0].toUpperCase() + p.slice(1)]),
    facing: [['right', 'Right'], ['left', 'Left']], tail: [['left', 'Left'], ['right', 'Right']], mode: [['glyph', 'Characters'], ['block', 'Blocks'], ['dot', 'Dots']],
    content: [['lines', 'Lines'], ['dots', 'Dots'], ['heart', 'Heart'], ['none', 'Empty']], kind: [['confetti', 'Confetti'], ['rain', 'Rain'], ['stars', 'Stars']],
  };
  const COLOR_KEYS = new Set(['color', 'fill', 'rayColor', 'leafColor', 'potColor', 'highlight', 'outline', 'under', 'accent', 'textColor', 'wordColor', 'kickerColor', 'background', 'cardColor']);
  const BOOL_KEYS = new Set(['flip', 'shadow', 'crop', 'overprint', 'card', 'showValues', 'horizontal', 'area', 'dots', 'baseline']);
  const SKIP = new Set(['type', 'name', 'prop', 'variant', 'x', 'y', 'hidden', 'locked', 'elements', 'paths', 'objects', 'area', 'points', 'from', 'to', 'colors', 'id', 'in', 'src']);
  const NUMS = new Set(['size', 'w', 'h', 'r', 'n', 'count', 'radius', 'bend', 'weight', 'depth', 'cell', 'labelSize', 'hole', 'unit']);
  const propsEl = $('props');
  let editCommitted = false, liveT = 0;
  function setField(key: string, value: any, target: 'el' | 'scene' = 'el', keepFalse = false) {
    if (!editCommitted) { commit(); editCommitted = true; }
    const o = target === 'el' ? cur() : scene;
    if (!o) return;
    if (value === undefined || value === '' || (value === false && !keepFalse)) delete o[key]; else o[key] = value;
    clearTimeout(liveT);
    liveT = window.setTimeout(() => { render(); renderLayers(); syncTop(); syncCode(); if (key === 'color' || key === 'fill' || key === 'background') renderCtx(); persist(); }, 90);
  }
  const endEdit = () => { editCommitted = false; };
  let fid = 0;
  function field(label: string, control: HTMLElement, wide = false) {
    const row = document.createElement('div'); row.className = `lv-field${wide ? ' wide' : ''}`;
    const id = `f${++fid}`;
    const focusable = control.matches('input,select,textarea') ? control : null;
    const lab = Object.assign(document.createElement(focusable ? 'label' : 'span'), { textContent: label, className: 'lv-flabel' }) as HTMLLabelElement;
    if (focusable) { focusable.id = id; lab.htmlFor = id; } else { lab.id = id; control.setAttribute('aria-labelledby', id); }
    row.append(lab, control);
    return row;
  }
  function numInput(v: number, on: (n: number) => void, step = 1) {
    const i = Object.assign(document.createElement('input'), { type: 'number', value: String(v), step: String(step), inputMode: 'decimal' });
    i.addEventListener('input', () => { if (i.value !== '' && Number.isFinite(+i.value)) on(+i.value); });
    i.addEventListener('change', endEdit);
    return i;
  }
  function inlineSwatches(current: any, on: (c: string) => void) {
    const pal = palette(scene);
    const wrap = document.createElement('div'); wrap.className = 'lv-swatches'; wrap.setAttribute('role', 'radiogroup');
    for (const name of SWATCHES) {
      const b = document.createElement('button'); b.type = 'button'; b.style.setProperty('--c', pal[name]);
      b.title = name.replace('-', ' '); b.setAttribute('role', 'radio'); b.setAttribute('aria-label', name.replace('-', ' ')); b.setAttribute('aria-checked', String(current === name));
      b.addEventListener('click', () => { on(name); endEdit(); renderProps(); });
      wrap.append(b);
    }
    wrap.append(customColor(current, on, () => { endEdit(); renderProps(); }));
    return wrap;
  }
  function control(key: string, v: any, set: (v: any) => void): HTMLElement {
    if (COLOR_KEYS.has(key)) return inlineSwatches(v, set);
    if (ENUMS[key]) {
      const s = document.createElement('select');
      for (const [val, lab] of ENUMS[key]) s.add(new Option(lab, val, false, val === (v ?? ENUMS[key][0][0])));
      s.addEventListener('change', () => { set(s.value); endEdit(); });
      return s;
    }
    if (BOOL_KEYS.has(key) || typeof v === 'boolean') {
      const i = Object.assign(document.createElement('input'), { type: 'checkbox', checked: !!v, className: 'lv-switch' });
      i.addEventListener('change', () => { set(i.checked); endEdit(); });
      return i;
    }
    if (key === 'rot') {
      const wrap = document.createElement('div'); wrap.className = 'lv-range';
      const i = Object.assign(document.createElement('input'), { type: 'range', min: '-180', max: '180', step: '1', value: String(v ?? 0) }); i.setAttribute('aria-label', 'Rotation');
      const out = Object.assign(document.createElement('output'), { textContent: `${v ?? 0}°` });
      i.addEventListener('input', () => { out.textContent = `${i.value}°`; set(+i.value || undefined); });
      i.addEventListener('change', endEdit);
      wrap.append(i, out);
      return wrap;
    }
    if (typeof v === 'number' || NUMS.has(key)) return numInput(v ?? 0, set, key === 'bend' || key === 'depth' ? 0.02 : key === 'hole' ? 0.05 : 1);
    if (key === 'text') {
      const t = Object.assign(document.createElement('textarea'), { value: v ?? '', rows: Math.min(5, String(v ?? '').split('\n').length + 1) });
      t.addEventListener('input', () => set(t.value)); t.addEventListener('change', endEdit);
      return t;
    }
    const i = Object.assign(document.createElement('input'), { type: 'text', value: v ?? '' });
    i.addEventListener('input', () => set(i.value)); i.addEventListener('change', endEdit);
    return i;
  }
  function renderProps() {
    const e = cur();
    propsEl.replaceChildren();
    if (panel === 'edit') $('fly-h').textContent = e ? `${TYPE_NAMES[e.type] || 'Part'} settings` : 'Canvas settings';
    if (!e) {
      propsEl.append(Object.assign(document.createElement('p'), { className: 'lv-help wide', textContent: 'Canvas settings. Select a part of the picture to edit it.' }));
      propsEl.append(field('Background', inlineSwatches(scene.background ?? 'paper', (c) => setField('background', c === 'paper' ? undefined : c, 'scene')), true));
      propsEl.append(field('Seed (the hand)', numInput(scene.seed ?? 1, (n) => setField('seed', Math.max(1, R(n)), 'scene'))));
      return;
    }
