  .lv-page.on .lv-page-b img { box-shadow: 0 0 0 2px var(--sel); }
  .lv-page-n { font: 600 10px/1 var(--mono); letter-spacing: .04em; color: var(--ink-soft); white-space: nowrap; }
  .lv-page-tools { display: flex; gap: 2px; }
