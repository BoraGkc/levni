  .lv-field input[type=number], .lv-field input[type=text], .lv-field select, .lv-field textarea { width: 100%; box-sizing: border-box; font: 14px/1.3 var(--serif); padding: 8px 9px; border: 1.5px solid var(--line); border-radius: 0; background: #fff; color: var(--ink); }
