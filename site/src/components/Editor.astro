  const ICON_DICE = '<svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="4"/><circle cx="8.5" cy="8.5" r="1.2" fill="currentColor"/><circle cx="15.5" cy="15.5" r="1.2" fill="currentColor"/><circle cx="12" cy="12" r="1.2" fill="currentColor"/></svg>';

  // ---------- contextual toolbar ----------
  const ctx = $('ctx');
  const TYPE_NAMES: Record<string, string> = { prop: 'Drawing', type: 'Text', label: 'Label', panel: 'Panel', disc: 'Circle', block: 'Pill', marks: 'Sparkles', sunburst: 'Sun rays', iso: '3D world', person: 'Person', people: 'People', seal: 'Seal', stub: 'Ticket', meshgrad: 'Gradient', dither: 'Dither', bubble: 'Speech bubble', window: 'Window', confetti: 'Confetti', waves: 'Waves', halftone: 'Halftone', arrow: 'Arrow', cloud: 'Cloud', tree: 'Tree', plant: 'Plant', extrude3d: '3D icon', glyphfill: 'ASCII', echo: 'Echo', image: 'Image', amtone: 'Riso screen', camo: 'Camo', grain: 'Grain', shapegrid: 'Bauhaus grid', dotmatrix: 'Dot matrix', furniture: 'Poster frame', terrain: 'Terrain', ridgelines: 'Ridgelines', engrave: 'Etching', flowfield: 'Flow lines', hatch: 'Hatching', rose: 'Flower', spiro: 'Guilloche', flag: 'Flag', badge: 'Badge', ringtext: 'Ring text', ticks: 'Ticks', sheet: 'Sheet', stack: 'Paper stack', crowd: 'Crowd', isotype: 'Pictograms', soft3d: '3D cover', ribbon: 'Ribbon', tube: 'Tube', ribbon3d: '3D ribbon', tube3d: '3D tube', torus3d: '3D ring', sphere3d: '3D ball', capsule3d: '3D pill', blob3d: '3D blob', cubes3d: '3D blocks', bars: 'Bar chart', linechart: 'Line chart', pie: 'Pie chart', donut: 'Donut chart', isochart: 'Icon chart', hills: 'Hills', glyphs: 'Glyph field', line: 'Line', shape: 'Shape', brush: 'Brush stroke' };
  function layerName(e: any) {
    if (!e) return '';
    const dn = drawingName(e);
    if (dn) return String(dn).replace(/-/g, ' ') + (e.type !== 'prop' ? ` (${DRAW_STYLES.find((d) => d.id === styleOf(e))?.label})` : '');
    if (e.type === 'image') return `Image ${String(e.src).split('/').pop()}`;
    if (typeof e.text === 'string' && e.text.trim()) { const t = e.text.replace(/\*\*|__/g, '').split('\n').join(' '); return `“${t.slice(0, 24)}${t.length > 24 ? '…' : ''}”`; }
    return (TYPE_NAMES[e.type] || e.type) + (e.preset ? ` (${e.preset})` : '');
  }
  const COLOR_KEY: Record<string, string> = { type: 'color', label: 'color', panel: 'color', disc: 'color', block: 'color', sunburst: 'color', cloud: 'color', waves: 'color', bubble: 'color', seal: 'fill', stub: 'fill', halftone: 'color', dither: 'color', arrow: 'color', person: 'color', glyphfill: 'color' };
  function ctxButton(label: string, fn: (b: HTMLButtonElement) => void, opts: { cls?: string; pressed?: boolean; html?: string; title?: string } = {}) {
    const b = Object.assign(document.createElement('button'), { type: 'button', className: `lv-cb ${opts.cls || ''}`, title: opts.title || label });
    if (opts.html) b.innerHTML = opts.html; else b.textContent = label;
    if (opts.html) b.setAttribute('aria-label', label);
    if (opts.pressed !== undefined) b.setAttribute('aria-pressed', String(opts.pressed));
    b.addEventListener('click', (ev) => { ev.stopPropagation(); fn(b); });
    return b;
  }
  const sep = () => Object.assign(document.createElement('span'), { className: 'lv-csep' });
  function colorButton(key: string, target: 'el' | 'scene', label = 'Colour') {
    const o = target === 'el' ? cur() : scene;
    const v = o?.[key] ?? (key === 'background' ? 'paper' : 'ink');
    return ctxButton(label, (b) => openColor(b, v, (c) => setField(key, key === 'background' && c === 'paper' ? undefined : c, target)), { cls: 'lv-cb-color', html: `<span class="lv-chip" style="--c:${hexOf(v)}"></span><span class="lv-cb-l">${label}</span>`, title: label });
  }
  function renderCtx() {
    const e = cur();
    const parts: HTMLElement[] = [];
    if (!e) {
      parts.push(Object.assign(document.createElement('span'), { className: 'lv-ctx-t', textContent: 'Canvas' }));
      parts.push(colorButton('background', 'scene', 'Background'));
      parts.push(ctxButton('Re-ink', () => { change((s) => { s.seed = Math.floor(Math.random() * 9000) + 1; }); say('Re-inked: same layout, a new hand.'); }, { title: 'Same layout, a new hand: the ink wobble, plates and grain change', html: `${ICON_DICE}Re-ink` }));
      if (els().some((x) => drawingName(x))) parts.push(ctxButton('Draw all as…', (b) => openStyleAll(b), { title: 'Turn every drawing on this page into ink, 3D, ASCII, dots or echo' }));
      parts.push(sep(), ctxButton('Layers', () => { openPanel('layers'); setPosTab('layers'); }));
      parts.push(Object.assign(document.createElement('span'), { className: 'lv-ctx-hint', textContent: 'Click a part to edit it' }));
      return ctx.replaceChildren(...parts);
    }
    const dn = drawingName(e);
    if (dn) {
      const rep = ctxButton('Replace', startReplace, { cls: 'lv-cb-thumb', title: 'Replace the drawing' });
      rep.prepend(thumb(fileFor(dn) || dn, e.variant ?? 0, 26));
      parts.push(rep);
      const row = index.find((p) => p.name === fileFor(dn));
      if (row && row.variants > 1) parts.push(ctxButton(`Variant ${(e.variant ?? 0) + 1}/${row.variants}`, (b) => openVariants(b, row)));
      parts.push(ctxButton('Effects', () => openPanel('effects'), { pressed: panel === 'effects' && !lv.classList.contains('closed') }));
      if (e.type === 'prop') parts.push(ctxButton('Flip', () => change(() => { if (cur().flip) delete cur().flip; else cur().flip = true; }), { pressed: !!e.flip, title: 'Mirror' }));
    }
    if (e.type === 'type') {
      const f = document.createElement('select'); f.className = 'lv-cselect'; f.setAttribute('aria-label', 'Font');
      for (const [v, l] of [['grotesk', 'Grotesk'], ['black', 'Heavy'], ['mono', 'Mono'], ['pixel', 'Pixel']]) f.add(new Option(l, v, false, (e.font || 'grotesk') === v));
      f.addEventListener('change', () => { setField('font', f.value); endEdit(); });
      parts.push(f);
    }
    if (e.type === 'type' || e.type === 'label') {
      const size = e.size ?? (e.type === 'label' ? 16 : 120);
      const box = document.createElement('span'); box.className = 'lv-stepper';
      const n = Object.assign(document.createElement('input'), { type: 'number', value: String(R(size)), inputMode: 'numeric' }); n.setAttribute('aria-label', 'Font size');
      n.addEventListener('input', () => { if (+n.value > 0) setField('size', +n.value); });
      n.addEventListener('change', endEdit);
      const step = (d: number) => ctxButton(d > 0 ? 'Bigger' : 'Smaller', () => { const v = Math.max(4, R((cur().size ?? size) + d)); n.value = String(v); setField('size', v); endEdit(); }, { html: d > 0 ? '+' : '−' });
      box.append(step(-4), n, step(4));
      parts.push(box);
    }
    if (e.type === 'type' || e.type === 'label') parts.push(colorButton('color', 'el'));
    else if (SPEC[e.type]) parts.push(...quickControls(e));
