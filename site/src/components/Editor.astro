  @media (max-width: 1100px) { .lv { grid-template-columns: 70px 280px minmax(0, 1fr); } .lv-brand span { display: none; } }
  @media (max-width: 760px) {
    .lv, .lv.closed { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto minmax(0, 1fr) auto; grid-template-areas: 'top' 'work' 'rail'; }
    .lv-top { flex-wrap: nowrap; overflow-x: auto; padding: 6px 8px; gap: 2px; }
    .lv-brand, .lv-share, .lv-dd-k, .lv-cta-full { display: none; }
    .lv-dd { height: 38px; padding: 0 28px 0 10px; }
    .lv-check { font-size: 0 !important; width: 34px; padding: 0 !important; }
