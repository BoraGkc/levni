  .lv-cb-color { padding: 0 8px; }
  .lv-chip { display: block; width: 24px; height: 24px; border-radius: 50%; background: var(--c); box-shadow: inset 0 0 0 1px rgba(20,24,31,.25); }
  .lv-csep { flex: none; width: 1px; height: 22px; margin: 0 4px; background: var(--line); }
  .lv-cselect { height: 36px; padding: 0 8px; border: 1.5px solid var(--line); border-radius: 0; background: #fff; font: 600 14px/1 var(--serif); color: var(--ink); }
  .lv-stepper { display: inline-flex; align-items: center; height: 36px; border: 1.5px solid var(--line); border-radius: 0; background: #fff; overflow: hidden; }
  .lv-stepper .lv-cb { height: 33px; width: 32px; padding: 0; justify-content: center; border-radius: 0; font-size: 17px; }
  .lv-stepper input { width: 46px; height: 33px; border: 0; border-left: 1px solid var(--line); border-right: 1px solid var(--line); text-align: center; font: 600 14px/1 var(--serif); color: var(--ink); -moz-appearance: textfield; }
  .lv-stepper input::-webkit-inner-spin-button { -webkit-appearance: none; }
  .lv-scroll { position: relative; overflow: auto; display: grid; place-items: center; padding: 32px; min-height: 0;
    background: radial-gradient(circle, rgba(75,47,214,.16) 1px, transparent 1.2px) 0 0 / 18px 18px, var(--work); }
  .lv-stage { position: relative; margin: 0; flex: none; background: #fff; box-shadow: 0 1px 0 rgba(20,24,31,.06), 0 24px 60px -30px rgba(43,26,143,.5); user-select: none; -webkit-user-select: none; }
  .lv-stage.editing { touch-action: none; }
