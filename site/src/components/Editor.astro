    if (!drag) return;
    const p = toCanvas(ev), { start, box } = drag;
    if (!drag.committed) { if (Math.hypot(p.x - start.x, p.y - start.y) < 2) return; commit(); drag.committed = true; mini.hidden = true; }
    const c = { x: box.x + box.w / 2, y: box.y + box.h / 2 };
    if (drag.mode === 'move') {
      const dx = p.x - start.x, dy = p.y - start.y;
      els()[sel] = moved(drag.orig, dx, dy); showSel(dx, dy);
    } else if (drag.mode === 'size') {
      const k = Math.max(0.1, Math.min(8, Math.hypot(p.x - c.x, p.y - c.y) / Math.max(1, Math.hypot(start.x - c.x, start.y - c.y))));
      els()[sel] = rescaled(drag.orig, 1, 1, k, false); showSel(0, 0, k);
    } else {
      // turn by the angle swept since the handle was grabbed, so nothing jumps on the first move
      const ang = (q: { x: number; y: number }) => Math.atan2(q.y - c.y, q.x - c.x) * 180 / Math.PI;
      let a = (drag.orig.rot ?? 0) + ang(p) - ang(start);
      a = ((a + 180) % 360 + 360) % 360 - 180;
      if (ev.shiftKey) a = R(a / 15) * 15;
      const delta = R(a - (drag.orig.rot ?? 0));
      els()[sel] = { ...drag.orig, rot: R(a) || undefined }; showSel(0, 0, 1, delta);
    }
    quick();
  });
  const drop = () => { if (!drag) return; const did = drag.committed; drag = null; if (did) refresh(); else showSel(); };
  stage.addEventListener('pointerup', drop);
  stage.addEventListener('pointercancel', drop);
  scroll.addEventListener('pointerdown', (ev) => { if (ev.target === scroll && sel >= 0) select(-1); });
  new ResizeObserver(() => layoutStage()).observe(scroll);

  // mini action bar above the selection
  function renderMini() {
    const e = cur();
    if (!e) return mini.replaceChildren();
    const b = (label: string, svg: string, fn: () => void, pressed?: boolean) => {
      const x = Object.assign(document.createElement('button'), { type: 'button', title: label, innerHTML: svg });
      x.setAttribute('aria-label', label); if (pressed !== undefined) x.setAttribute('aria-pressed', String(pressed));
      x.addEventListener('click', (ev) => { ev.stopPropagation(); fn(); });
