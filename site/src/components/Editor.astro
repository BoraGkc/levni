  }
  @media (max-width: 480px) {
    .lv-rail-b { min-width: 44px; padding: 10px 2px; }
    .lv-rail-b span:last-child { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; } /* icons only; the label stays the accessible name */
  }
  @media (prefers-reduced-motion: reduce) { .lv-stage img { transition: none; } }

  /* Levni brand layer: indigo top bar, indigo rail, mono labels, chamfered promo card */
  .lv .lv-top { background: var(--indigo); border-bottom: 0; color: #fff; }
  .lv .lv-brand b { color: #fff; font-weight: 800; letter-spacing: -.01em; }
  .lv .lv-brand span { color: var(--mute-indigo); font-family: var(--mono); font-size: 10px; letter-spacing: .06em; text-transform: uppercase; }
  .lv .lv-top .lv-dd { background-color: #fff; border: 1.5px solid #fff; color: var(--indigo); }
  .lv .lv-top .lv-dd:hover, .lv .lv-top .lv-dd[aria-expanded='true'] { border-color: var(--lime); }
