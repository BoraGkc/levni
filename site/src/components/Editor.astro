  // ---------- adding things ----------
  function freeSpot(w: number, h = w) {
    const parts = boxes.filter((b) => b.w * b.h < cv.w * cv.h * 0.5);
    const m = Math.min(cv.w, cv.h) * 0.05;
    let best = { x: cv.w / 2, y: cv.h / 2, cost: Infinity };
    for (let gy = 1; gy <= 7; gy++) for (let gx = 1; gx <= 7; gx++) {
      const ax = Math.max(w / 2 + m, Math.min(cv.w - w / 2 - m, (cv.w * gx) / 8)), ay = Math.max(h / 2 + m, Math.min(cv.h - h / 2 - m, (cv.h * gy) / 8));
      let cost = Math.hypot(ax - cv.w / 2, ay - cv.h / 2) * 0.5;
      for (const b of parts) cost += Math.max(0, Math.min(ax + w / 2, b.x + b.w) - Math.max(ax - w / 2, b.x)) * Math.max(0, Math.min(ay + h / 2, b.y + b.h) - Math.max(ay - h / 2, b.y));
      if (cost < best.cost) best = { x: R(ax), y: R(ay), cost };
    }
    return best;
  }
  const unit = () => R(Math.min(cv.w, cv.h) * 0.3);
  type Add = { kind: 'prop'; name: string } | { kind: 'shape' | 'text'; id: string };
  // a colour that reads on this background and belongs to the picture: the most used ink of its parts
  // (drawings count double) that has enough contrast, else paper on dark grounds and ink on light ones
  function sceneInk(skip = -1): string {
    const bg = hexOf(scene.background ?? 'paper');
    const tally = new Map<string, number>();
    els().forEach((e, i) => {
      if (e.hidden || i === skip) return;
      for (const k of ['color', 'fill', 'accent']) if (typeof e[k] === 'string') tally.set(e[k], (tally.get(e[k]) || 0) + (drawingName(e) ? 2 : 1));
    });
    const ok = [...tally].filter(([c]) => contrast(hexOf(c), bg) >= 2.6).sort((a, b) => b[1] - a[1]);
    return ok[0]?.[0] ?? (luminance(bg) < 0.3 ? 'paper' : 'ink');
  }
  // a drawing in style `st`, looking like the other drawings already in that style (or, with no style given,
  // like the selected drawing, else the style most of the picture uses)
  function drawingIn(st: string | null, b: { name: string; variant?: number; x: number; y: number; size: number }, skip = -1) {
    const ds = els().map((e, i) => [e, i] as const).filter(([e, i]) => i !== skip && !e.hidden && drawingName(e));
    if (!st) {
      const s = cur();
      if (s && drawingName(s)) st = styleOf(s);
      else {
        const n = new Map<string, number>();
        ds.forEach(([e]) => n.set(styleOf(e), (n.get(styleOf(e)) || 0) + 1));
        st = [...n].sort((x, y) => y[1] - x[1])[0]?.[0] ?? 'ink';
      }
    }
    const pick = sel !== skip && cur() && drawingName(cur()) && styleOf(cur()) === st ? cur() : [...ds].reverse().find(([e]) => styleOf(e) === st)?.[0];
    if (pick) return likeDrawing(pick, b);
    const d = DRAW_STYLES.find((x) => x.id === st) || DRAW_STYLES[0];
    const was = els()[skip]; // switching ASCII and dots keeps the colour it had
    return d.to({ ...b, color: was?.type === 'glyphfill' && typeof was.color === 'string' ? was.color : sceneInk(skip) });
  }
  function makeEl(a: Add, x: number, y: number) {
    const s = unit();
    if (a.kind === 'prop') return drawingIn(null, { name: a.name, x, y, size: s });
    return ((a.kind === 'shape' ? SHAPES : TEXTS) as { id: string; make: Maker }[]).find((m) => m.id === a.id)!.make(x, y, s); // may be a list (text combos)
  }
  function unreflow(s: any) {
    const [w, h] = sizeOf(s), from = s.reflowFrom || [1200, 673];
    s.elements = (s.elements || []).map((e: any) => rescaled(e, w / from[0], h / from[1]));
    delete s.reflow; delete s.reflowFrom; delete s.format; s.canvas = [w, h];
  }
  const RECENT = 'levni-recent';
  const recent = (): string[] => { try { return JSON.parse(localStorage.getItem(RECENT) || '[]'); } catch { return []; } };
  function add(a: Add, at?: { x: number; y: number }) {
    const u = unit();
    const p = at || (a.kind === 'text' ? freeSpot(u * 2.4, u * 0.9) : freeSpot(u));
    change((s) => { if (s.reflow) unreflow(s); (s.elements ||= []).push(...[makeEl(a, R(p.x), R(p.y))].flat()); });
    if (a.kind === 'prop') try { localStorage.setItem(RECENT, JSON.stringify([a.name, ...recent().filter((n) => n !== a.name)].slice(0, 9))); } catch {}
    select(els().length - 1);
    if (window.innerWidth < 760) openPanel(null); // phones: show the canvas again
    say(`Added ${layerName(cur())}. Drag it into place.`);
  }
  const dropEl = $('drop');
  stage.addEventListener('dragover', (ev) => { if (ev.dataTransfer?.types.includes('application/x-levni')) { ev.preventDefault(); ev.dataTransfer.dropEffect = 'copy'; dropEl.hidden = false; } });
  stage.addEventListener('dragleave', (ev) => { if (!stage.contains(ev.relatedTarget as Node)) dropEl.hidden = true; });
  stage.addEventListener('drop', (ev) => {
    dropEl.hidden = true;
