  const DEFAULTS: Record<string, any> = { rot: 0, r: 120, w: 300, h: 200, n: 4, count: 6 };
  const LABELS: Record<string, string> = { w: 'Width', h: 'Height', r: 'Radius', rot: 'Rotation', size: 'Size', n: 'How many', count: 'How many', text: 'Text', font: 'Font', color: 'Colour', fill: 'Fill', rayColor: 'Rays', leafColor: 'Leaves', potColor: 'Pot', flip: 'Mirror', shadow: 'Shadow', pose: 'Pose', facing: 'Facing', tail: 'Tail', content: 'Inside', kind: 'Kind', bend: 'Bend', radius: 'Corners', word: 'Centre word', title: 'Title', weight: 'Weight', textColor: 'Text colour', wordColor: 'Word colour', depth: 'Depth', mode: 'Mode', cell: 'Cell size', highlight: 'Highlight', showValues: 'Show the numbers', horizontal: 'Sideways bars', prefix: 'Before each number', suffix: 'After each number', labelSize: 'Label size', area: 'Fill under the line', dots: 'Dots on points', baseline: 'Base line', hole: 'Hole (0 to 0.8)', unit: 'One icon counts' };
  const ENUMS: Record<string, [string, string][]> = {
