  .lv-sel { position: absolute; border: 2px solid var(--sel); border-radius: 0; box-shadow: 0 0 0 1px rgba(255,255,255,.8); pointer-events: none; transform-origin: 50% 50%; }
  .lv-sel.locked { border-style: dashed; }
