    pop.replaceChildren(Object.assign(document.createElement('p'), { className: 'lv-pop-h', textContent: 'Draw every drawing as' }), Object.assign(document.createElement('p'), { className: 'lv-pop-sub', textContent: 'They take one look, in inks that read on this background.' }), list);
    showPop(pop, anchor);
  }
  function styleAll(st: string) {
    let n = 0;
    change(() => {
      const list = els();
      for (let i = 0; i < list.length; i++) {
        const o = list[i], dn = drawingName(o);
        if (!dn || styleOf(o) === st) continue;
        const keep = { name: fileFor(dn) || dn, variant: o.variant, x: o.x, y: o.y, size: o.size ?? unit() };
        list[i] = { ...drawingIn(st, keep, i), ...(o.rot ? { rot: o.rot } : {}), ...(o.hidden ? { hidden: true } : {}), ...(o.locked ? { locked: true } : {}) };
        n++;
      }
    });
    effectThumbs.clear();
    say(n ? `${n} ${n === 1 ? 'drawing' : 'drawings'} now drawn as ${DRAW_STYLES.find((d) => d.id === st)!.label}.` : 'Every drawing is already in that style.');
  }
  function openVariants(anchor: HTMLElement, row: Row) {
