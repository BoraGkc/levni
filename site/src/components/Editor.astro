    if (!data) return;
    ev.preventDefault();
    const p = toCanvas(ev);
    add(JSON.parse(data), { x: Math.max(0, Math.min(cv.w, p.x)), y: Math.max(0, Math.min(cv.h, p.y)) });
  });
