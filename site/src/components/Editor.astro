    renderMini(); showSel();
    if (msg) say(msg);
  }

  // ---------- popovers ----------
  const tops = ['pick-size', 'pick-look', 'pick-notes', 'pick-export'];
  function showPop(pop: HTMLElement, anchor: HTMLElement) {
    closePops(pop);
    pop.hidden = false;
    const r = anchor.getBoundingClientRect(), host = lv.getBoundingClientRect();
    pop.style.top = `${r.bottom - host.top + 8}px`;
    pop.style.left = `${Math.max(8, Math.min(r.left - host.left, host.width - pop.offsetWidth - 8))}px`;
    (pop.querySelector('[aria-checked=true]') as HTMLElement | null || pop.querySelector('button') as HTMLElement | null)?.focus();
  }
  function closePops(except?: HTMLElement) {
    for (const p of lv.querySelectorAll<HTMLElement>('.lv-pop')) if (p !== except) p.hidden = true;
    for (const t of tops) $(t).setAttribute('aria-expanded', String(!$( $(t).getAttribute('aria-controls')! ).hidden));
  }
  function openPop(id: string, anchor?: HTMLElement) {
    const b = $(id), pop = $(b.getAttribute('aria-controls')!);
    if (!pop.hidden) return closePops();
    showPop(pop, anchor || b);
    b.setAttribute('aria-expanded', 'true');
  }
  for (const t of tops) $(t).addEventListener('click', (ev) => { ev.stopPropagation(); openPop(t); });
  document.addEventListener('click', (ev) => { if (!(ev.target as HTMLElement).closest('.lv-pop')) closePops(); });

  function syncTop() {
    const [w, h] = sizeOf(scene);
    const z = SIZES.find((s) => s.wh[0] === w && s.wh[1] === h);
    $('size-v').textContent = z ? z.label : `${w}×${h}`;
    const lk = lookOf(scene);
    $('look-v').textContent = lk?.label || 'Your inks';
    $('sizes').replaceChildren(...SIZES.map((s) => {
      const b = document.createElement('button'); b.type = 'button'; b.className = 'lv-opt'; b.setAttribute('role', 'radio'); b.setAttribute('aria-checked', String(s === z));
      const k = 44 / Math.max(...s.wh);
      const box = Object.assign(document.createElement('span'), { className: 'lv-size-box' });
      const shape = Object.assign(document.createElement('span'), { className: 'lv-size-shape' });
      shape.style.width = `${R(s.wh[0] * k)}px`; shape.style.height = `${R(s.wh[1] * k)}px`;
      box.append(shape);
      const txt = document.createElement('span');
      txt.append(Object.assign(document.createElement('b'), { textContent: s.label }), Object.assign(document.createElement('small'), { textContent: `${s.use} · ${s.wh[0]} × ${s.wh[1]}` }));
      b.append(box, txt);
      b.addEventListener('click', () => setSize(s.wh, s.label));
      return b;
    }));
    $('looks').replaceChildren(...LOOKS.map((l) => {
      const b = document.createElement('button'); b.type = 'button'; b.className = 'lv-opt'; b.setAttribute('role', 'radio'); b.setAttribute('aria-checked', String(l === lk));
      const pal: Record<string, string> = { ...COLORS, ...(l.style ? (STYLES as any)[l.style] : {}) };
      const dots = document.createElement('span'); dots.className = `lv-look-dots${l.finish ? ' soft' : ''}`;
      for (const c of ['paper', 'blue', 'coral', 'mustard', 'green']) { const i = document.createElement('i'); i.style.setProperty('--c', pal[c]); dots.append(i); }
      const txt = document.createElement('span');
      txt.append(Object.assign(document.createElement('b'), { textContent: l.label }), Object.assign(document.createElement('small'), { textContent: l.note }));
      b.append(dots, txt);
      b.addEventListener('click', () => { change((s) => { if (l.style) s.style = l.style; else delete s.style; if (l.finish) s.finish = l.finish; else delete s.finish; }); closePops(); effectThumbs.clear(); say(`Look: ${l.label}.`); });
      return b;
    }));
  }
  // the scene at another size: everything moves and scales with the canvas
  function resizeScene(s: any, wh: [number, number]) {
    const [w1, h1] = s.reflow ? (s.reflowFrom || [1200, 673]) : sizeOf(s);
    const [w2, h2] = wh;
    s.elements = (s.elements || []).map((e: any) => rescaled(e, w2 / w1, h2 / h1));
    if (Array.isArray(s.clip)) s.clip = [s.clip[0] * w2 / w1, s.clip[1] * h2 / h1, s.clip[2] * w2 / w1, s.clip[3] * h2 / h1].map(r1);
    delete s.format; delete s.reflow; delete s.reflowFrom;
    s.canvas = [w2, h2];
    return s;
  }
  $('all-sizes').addEventListener('click', () => {
    const [w, h] = sizeOf(scene);
    const list = SIZES.filter((z) => ['Link preview', 'Square', 'Story', 'YouTube', 'Poster'].includes(z.label) && !(z.wh[0] === w && z.wh[1] === h)).map((z) => resizeScene(structuredClone(scene), z.wh));
    closePops();
    addPages(list, `${list.length} sizes added as pages. Each one is yours to nudge.`);
  });
  function setSize(wh: [number, number], label: string) {
    const [w2, h2] = wh;
    change((s) => { resizeScene(s, wh); });
    closePops();
    say(`Resized to ${label}, ${w2} × ${h2}. Everything moved with it; nudge what needs it.`);
  }
  $('undo').addEventListener('click', undo);
  $('redo').addEventListener('click', redo);

  // zoom
  $<HTMLInputElement>('zoom').addEventListener('input', (ev) => { zoom = +(ev.target as HTMLInputElement).value / 100; layoutStage(); });
  $('fit').addEventListener('click', () => { zoom = 'fit'; layoutStage(); });

  // ---------- output ----------
  const save = (blob: Blob, file: string) => { const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = file; a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 1500); };
  const b64u = (bytes: Uint8Array) => btoa(Array.from(bytes, (b) => String.fromCharCode(b)).join('')).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
  const unb64u = (s: string) => Uint8Array.from(atob(s.replace(/-/g, '+').replace(/_/g, '/')), (c) => c.charCodeAt(0));
  const pack = async (t: string) => b64u(new Uint8Array(await new Response(new Blob([t]).stream().pipeThrough(new CompressionStream('deflate-raw'))).arrayBuffer()));
  const unpack = async (s: string) => new Response(new Blob([unb64u(s)]).stream().pipeThrough(new DecompressionStream('deflate-raw'))).text();
  $('pop-export').addEventListener('click', async (ev) => {
    const out = (ev.target as HTMLElement).closest('button')?.dataset.out;
    if (!out) return;
    closePops();
    if (out === 'png' || out === 'png2') { say('Preparing the PNG…'); save(await toBlob(lastSvg, { scale: out === 'png2' ? 2 : 1 }), 'levni.png'); say('PNG downloaded. Next time, ask your agent: Levni runs free in Claude and Codex (levni.dev/mcp).'); }
    if (out === 'svg') save(new Blob([lastSvg], { type: 'image/svg+xml' }), 'levni.svg');
    if (out === 'json') save(new Blob([JSON.stringify(visible(scene), null, 2)], { type: 'application/json' }), 'scene.json');
    if (out === 'all-png') {
      pages[page] = scene;
      for (let i = 0; i < pages.length; i++) {
        say(`Preparing page ${i + 1} of ${pages.length}…`);
        const vis = visible(pages[i]);
        await ensureAssets(vis);
        save(await toBlob((await compose(vis)).svg, { scale: 1 }), `levni-${String(i + 1).padStart(2, '0')}.png`);
        await new Promise((r) => setTimeout(r, 350)); // browsers drop downloads that come too close together
      }
      say(`${pages.length} PNGs downloaded.`);
    }
    if (out === 'all-json') save(new Blob([JSON.stringify({ pages: pages.map((p, i) => visible(i === page ? scene : p)) }, null, 2)], { type: 'application/json' }), 'pages.json');
  });
  $('open-full')?.addEventListener('click', async (ev) => { ev.preventDefault(); window.open(`/editor/#s=${await pack(JSON.stringify(docOut()))}`, '_top'); });
  $('share')?.addEventListener('click', async () => {
    const url = `${location.origin}/editor/#s=${await pack(JSON.stringify(docOut()))}`;
    history.replaceState(null, '', url);
    try { await navigator.clipboard.writeText(url); say('Share link copied. Anyone with it opens this design.'); } catch { say('The share link is in the address bar.'); }
  });

  // ---------- code ----------
  const src = $<HTMLTextAreaElement>('src');
  function syncCode(force = false) { if ((force || panel === 'code') && document.activeElement !== src) src.value = JSON.stringify(scene, null, 2); }
  let codeT = 0, codeCommitted = false;
  src.addEventListener('focus', () => { codeCommitted = false; });
  src.addEventListener('input', () => {
    clearTimeout(codeT);
    codeT = window.setTimeout(() => {
      try {
        const next = JSON.parse(src.value);
        if (!codeCommitted) { commit(); codeCommitted = true; }
        setScene(next); clampSel();
        render(); renderCtx(); renderLayers(); syncTop(); renderPages();
        persist();
      } catch (e: any) {
        const pos = Number(/position (\d+)/.exec(e.message)?.[1]);
        $('err').textContent = Number.isFinite(pos) ? `JSON error on line ${src.value.slice(0, pos).split('\n').length}` : 'JSON error';
      }
    }, 300);
  });
  src.addEventListener('keydown', (e) => { if (e.key === 'Tab' && !e.shiftKey) { e.preventDefault(); src.setRangeText('  ', src.selectionStart, src.selectionEnd, 'end'); } });

  // ---------- keyboard ----------
  document.addEventListener('keydown', (ev) => {
    const t = ev.target as HTMLElement;
    if (ev.key === 'Escape') {
      if ([...lv.querySelectorAll<HTMLElement>('.lv-pop')].some((p) => !p.hidden)) { closePops(); return; }
      if (replacing) { stopReplace(); return; }
      if (sel >= 0 && !t.closest('input,textarea,select')) { select(-1); return; }
    }
    if (t.closest('input, textarea, select, [contenteditable]')) return;
    const mod = ev.metaKey || ev.ctrlKey;
    if (mod && ev.key.toLowerCase() === 'z') { ev.preventDefault(); if (ev.shiftKey) redo(); else undo(); return; }
    if (mod && ev.key.toLowerCase() === 'y') { ev.preventDefault(); redo(); return; }
    if (sel < 0) return;
    if (mod && ev.key.toLowerCase() === 'd') { ev.preventDefault(); doAct('dup'); return; }
    if (ev.key === 'Delete' || ev.key === 'Backspace') { ev.preventDefault(); doAct('del'); return; }
    if (ev.key === ']') { doAct(ev.shiftKey ? 'top' : 'front'); return; }
    if (ev.key === '[') { doAct(ev.shiftKey ? 'bottom' : 'back'); return; }
    const step = ev.shiftKey ? 10 : 2;
    const d = ({ ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, -step], ArrowDown: [0, step] } as Record<string, number[]>)[ev.key];
    if (d && canMove(cur()) && !scene.reflow) { ev.preventDefault(); change(() => { els()[sel] = moved(cur(), d[0], d[1]); }); }
  });

  // the agent card: open or closed, remembered in this browser
  const cta = $('cta'), ctaBtn = $('cta-toggle');
  const setCta = (open: boolean) => { cta.classList.toggle('closed', !open); ctaBtn.setAttribute('aria-expanded', String(open)); };
  if (cta) try { setCta(localStorage.getItem('levni-cta') !== 'closed'); } catch {}
  ctaBtn?.addEventListener('click', () => { const open = cta.classList.contains('closed'); setCta(open); try { localStorage.setItem('levni-cta', open ? 'open' : 'closed'); } catch {} });

  // ---------- start ----------
  const hdr = document.querySelector('.site-header') as HTMLElement | null;
  const setHdr = () => lv.style.setProperty('--hdr', EMBED ? '0px' : `${hdr?.offsetHeight ?? 64}px`);
  setHdr(); window.addEventListener('resize', setHdr);
  if (window.innerWidth < 760 || EMBED) openPanel(null); else openPanel('drawings');
  (async () => {
    const h = new URLSearchParams(location.hash.slice(1)).get('s');
    const tpl = new URLSearchParams(location.search).get('tpl');
    const tplLoad = tpl && exampleFiles[`../../../examples/${tpl}.json`];
    const srcParam = new URLSearchParams(location.search).get('src'); // a gallery scene, e.g. /g/stickers/01-seal-sheet.json
    if (EMBED && srcParam && /^\/g\/[a-z0-9-]+\/[a-z0-9-]+\.json$/.test(srcParam)) { try { loadDoc(await (await fetch(srcParam)).json()); } catch {} }
    else if (EMBED && tplLoad) { try { loadDoc(structuredClone(await tplLoad())); } catch {} }
    else if (h) { try { loadDoc(JSON.parse(await unpack(h))); } catch { say('That share link is broken; here is the starter scene.'); } }
    else if (!EMBED) { try { const saved = localStorage.getItem('levni-editor'); if (saved) loadDoc(JSON.parse(saved)); } catch {} }
    if (!Array.isArray(scene.elements)) loadDoc(structuredClone(STARTER));
    cv = { w: sizeOf(scene)[0], h: sizeOf(scene)[1] };
    layoutStage();
    refresh();
    listDrawings();
  })();
</script>

