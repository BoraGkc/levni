  async function thumbUrl(s: any, crayon = false) {
    await ensureAssets(s);
    const { svg } = await compose(s);
    return URL.createObjectURL(new Blob([crayon ? svg : svg.replace(/ filter="url\(#crayon\)"/g, '')], { type: 'image/svg+xml' }));
  }
  const lazy = new IntersectionObserver((entries) => {
    for (const en of entries) if (en.isIntersecting) { lazy.unobserve(en.target); (en.target as any)._load?.(); }
  }, { rootMargin: '300px' });
  function tile(parent: HTMLElement, label: string, onClick: () => void, a?: Add) {
    const b = document.createElement('button');
    b.type = 'button'; b.className = 'lv-tile lv-tile-l';
    const pic = document.createElement('span'); pic.className = 'lv-pic';
    b.append(pic, Object.assign(document.createElement('span'), { className: 'lv-cap', textContent: label }));
