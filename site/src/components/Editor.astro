    const g = document.createElement('div'); g.className = 'lv-variants'; g.setAttribute('role', 'radiogroup'); g.setAttribute('aria-label', 'Variant');
    for (let k = 0; k < row.variants; k++) {
      const b = document.createElement('button'); b.type = 'button'; b.setAttribute('role', 'radio');
      b.setAttribute('aria-checked', String((cur()?.variant ?? 0) === k)); b.setAttribute('aria-label', `Variant ${k + 1}`);
      b.append(thumb(row.name, k, 56));
