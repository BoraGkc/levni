    const wrap = document.createElement('div'); wrap.className = 'lv-swatches'; wrap.setAttribute('role', 'radiogroup'); wrap.setAttribute('aria-label', 'Colour');
    for (const name of SWATCHES) {
      const b = document.createElement('button'); b.type = 'button'; b.style.setProperty('--c', pal[name]);
      b.title = name.replace('-', ' '); b.setAttribute('role', 'radio'); b.setAttribute('aria-label', name.replace('-', ' ')); b.setAttribute('aria-checked', String(current === name));
      b.addEventListener('click', () => { on(name); endEdit(); closePops(); renderCtx(); });
      wrap.append(b);
    }
    const lab = customColor(current, on, () => { endEdit(); renderCtx(); });
    pop.replaceChildren(Object.assign(document.createElement('p'), { className: 'lv-pop-h', textContent: 'Colour' }), Object.assign(document.createElement('p'), { className: 'lv-pop-sub', textContent: 'The inks of this look' }), wrap, lab);
    showPop(pop, anchor);
  }
  function openStyleAll(anchor: HTMLElement) {
    const pop = $('pop-style');
    const list = document.createElement('div'); list.className = 'lv-list';
    for (const d of DRAW_STYLES) {
      const b = Object.assign(document.createElement('button'), { type: 'button', className: 'lv-opt' });
