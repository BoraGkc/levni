  .lv-search { width: 100%; box-sizing: border-box; font: 15px/1.3 var(--serif); padding: 11px 12px; border: 1.5px solid var(--line); border-radius: 0; background: #fff; color: var(--ink); margin-bottom: 6px; }
  .lv-search:focus { border-color: var(--ink); }
  .lv-row { margin-top: 14px; }
