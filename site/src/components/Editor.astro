  #src { display: block; width: 100%; box-sizing: border-box; height: 56vh; resize: vertical; padding: 12px; border: 0; border-radius: 0; background: #fff; color: var(--ink); box-shadow: 0 0 0 1px var(--line); font: 12.5px/1.55 var(--mono); tab-size: 2; white-space: pre; }
  .lv-err { min-height: 1.2em; margin: 6px 0; font-size: 13px; color: var(--coral-deep); }

  /* workspace */
  .lv-work { grid-area: work; display: grid; grid-template-rows: auto minmax(0, 1fr) auto auto; min-width: 0; min-height: 0; }
  .lv-ctx { display: flex; align-items: center; gap: 4px; min-height: 52px; padding: 7px 12px; background: var(--paper); border-bottom: 1px solid var(--line); overflow-x: auto; scrollbar-width: thin; }
  .lv-ctx-hint { margin-left: auto; padding-left: 12px; font-size: 13px; color: var(--ink-soft); white-space: nowrap; }
  .lv-ctx-t { margin-right: 6px; font: 700 11px/1 var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--ink-soft); }
  .lv-cb { display: inline-flex; align-items: center; gap: 7px; height: 36px; padding: 0 11px; border: 0; border-radius: 0; background: transparent; font-weight: 600; font-size: 14px; white-space: nowrap; cursor: pointer; }
