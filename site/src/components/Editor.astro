  .lv-eye[aria-pressed='true'] { opacity: .4; }
  .lv-data { display: grid; gap: 6px; }
  .lv-clist { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .lv-dchip-add { display: grid; place-items: center; background: #fff; color: var(--indigo); font: 700 15px/1 var(--mono); }
  .lv-seed { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 6px; }
