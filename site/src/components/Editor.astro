  .lv-page-tools button:hover:not(:disabled) { background: var(--soft); }
  .lv-page-tools button:disabled { opacity: .3; cursor: default; }
  .lv-page-add { flex: none; align-self: center; height: 52px; padding: 0 14px; border: 1.5px dashed var(--line); background: transparent; font: 600 11px/1 var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--indigo); cursor: pointer; }
  .lv-page-add:hover { border-color: var(--indigo); background: #fff; }
  .lv-bottom { display: flex; align-items: center; gap: 10px; padding: 6px 14px; background: var(--paper); border-top: 1px solid var(--line); font-size: 13px; }
  .lv-status { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ink-soft); }
  .lv-fit { padding: 5px 10px; border: 1px solid var(--line); border-radius: 0; background: #fff; font-weight: 600; font-size: 12px; cursor: pointer; }
