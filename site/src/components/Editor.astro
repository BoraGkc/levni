---
// The Levni editor. Used full-page at /editor/ and, with `embed`, inside the /make/ pages (via /embed/editor/).
//   <Editor />          the full editor
//   <Editor embed />    a compact demo: loads ?tpl=<example> or ?s=<shared scene>, keeps nothing in this browser,
//                       and offers 'Open in the full editor' instead of Share
interface Props { embed?: boolean }
const { embed = false } = Astro.props;
import { SITE } from '../site';
import gallery from '../data/gallery.json';
import { existsSync } from 'node:fs';

// every gallery scene that is a plain scene (boards are board specs, drawn in Node), grouped like the gallery.
// NODE_ONLY: scenes the browser cannot draw (sharp textures, Tabler icons, image files); checked in the editor, Nov 2026
const NODE_ONLY = new Set(['posters/08-liquidity', 'covers/oa-orman', 'covers/oa-orna', 'soft3d/auto-01', 'soft3d/auto-09',
  ...['classroom', 'desk', 'office', 'room'].flatMap((w) => [`worlds/${w}-riso-2`, `worlds/${w}-riso-5`, `worlds/${w}-soft`]), 'worlds/room-miniature']);
const tplGroups = (gallery.groups as [string, string][]).filter(([g]) => g !== 'boards').map(([g, label]) => [g, label,
  (gallery.items as { group: string; id: string; title: string }[]).filter((i) => i.group === g && !NODE_ONLY.has(`${g}/${i.id}`) && existsSync(`public/g/${g}/${i.id}.json`))
    .map((i) => [i.id, i.title, existsSync(`public/g/${g}/${i.id}-s.webp`) ? `${i.id}-s.webp` : `${i.id}.webp`])] as const).filter((x) => x[2].length);

const jsonld = [
  { '@type': 'WebApplication', name: 'Levni editor', applicationCategory: 'DesignApplication', operatingSystem: 'Any (web browser)', url: `${SITE.url}/editor/`, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, publisher: { '@id': `${SITE.ortakAlan}/#organization` } },
];
const I: Record<string, string> = {
  undo: '<path d="M9 7H4V2M4.5 7A8 8 0 1 1 5 17"/>',
  redo: '<path d="M15 7h5V2M19.5 7A8 8 0 1 0 19 17"/>',
  templates: '<rect x="3.5" y="3.5" width="17" height="17" rx="3"/><path d="M3.5 9.5h17M9.5 9.5v11"/>',
  drawings: '<path d="M4 20l1.2-4.6L15.8 4.8a2 2 0 0 1 2.9 0l.5.5a2 2 0 0 1 0 2.9L8.6 18.8z"/><path d="M14 6.6l3.4 3.4"/>',
  shapes: '<circle cx="8" cy="8" r="4.5"/><path d="M13.5 20.5l4-7 4 7z"/><rect x="3.5" y="14" width="6.5" height="6.5" rx="1"/>',
  text: '<path d="M5 6V4.5h14V6M12 4.5v15M9 19.5h6"/>',
  layers: '<path d="M12 3.5l8.5 4.5-8.5 4.5L3.5 8z"/><path d="M3.5 12.5L12 17l8.5-4.5M3.5 16.5L12 21l8.5-4.5"/>',
  code: '<path d="M8.5 7L3.5 12l5 5M15.5 7l5 5-5 5"/>',
  dice: '<rect x="3.5" y="3.5" width="17" height="17" rx="4"/><circle cx="8.5" cy="8.5" r="1.2" fill="currentColor"/><circle cx="15.5" cy="15.5" r="1.2" fill="currentColor"/><circle cx="12" cy="12" r="1.2" fill="currentColor"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
};
const ico = (k: string, s = 22) => `<svg viewBox="0 0 24 24" width="${s}" height="${s}" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${I[k]}</svg>`;
const rail: [string, string][] = [['templates', 'Templates'], ['drawings', 'Drawings'], ['shapes', 'Shapes'], ['text', 'Text'], ['layers', 'Layers'], ['code', 'Code']];
---
<div class="lv" id="lv" data-embed={embed ? '1' : undefined}>
    <!-- top bar -->
    <div class="lv-top">
      {!embed && <div class="lv-brand"><b>Levni editor</b><span>Free, in your browser</span></div>}
      <button type="button" class="lv-dd" id="pick-size" aria-haspopup="true" aria-expanded="false" aria-controls="pop-size"><span class="lv-dd-k">Size</span><span id="size-v" class="lv-dd-v">Cover</span></button>
      <button type="button" class="lv-dd" id="pick-look" aria-haspopup="true" aria-expanded="false" aria-controls="pop-look"><span class="lv-dd-k">Look</span><span id="look-v" class="lv-dd-v">Riso, crayon</span></button>
      <div class="lv-hist" role="group" aria-label="History">
        <button type="button" class="lv-tb-i" id="undo" aria-label="Undo" title="Undo (⌘Z)" disabled set:html={ico('undo', 19)} />
        <button type="button" class="lv-tb-i" id="redo" aria-label="Redo" title="Redo (⇧⌘Z)" disabled set:html={ico('redo', 19)} />
      </div>
      <span class="lv-grow"></span>
      <button type="button" class="lv-check" id="pick-notes" hidden={embed} aria-haspopup="true" aria-expanded="false" aria-controls="pop-notes"><span id="notes-v">Checking…</span></button>
      {embed ? <a class="lv-share lv-full" id="open-full" href="/editor/" target="_top"><span class="lv-long">Open in the full editor →</span><span class="lv-short">Full editor →</span></a> : <button type="button" class="lv-share" id="share">Share link</button>}
      <button type="button" class="lv-dl" id="pick-export" aria-haspopup="true" aria-expanded="false" aria-controls="pop-export">Download</button>
    </div>

    <!-- popovers -->
    <div class="lv-pop" id="pop-size" hidden><p class="lv-pop-h">Resize</p><p class="lv-pop-sub">Everything on the canvas moves and scales with it.</p><div class="lv-list" id="sizes" role="radiogroup" aria-label="Canvas size"></div><button type="button" class="lv-allsizes" id="all-sizes"><b>Every size as a page</b><span>Link preview, square, story, YouTube and poster, from this design</span></button></div>
    <div class="lv-pop" id="pop-look" hidden><p class="lv-pop-h">Look</p><p class="lv-pop-sub">Colours and finish for the whole picture.</p><div class="lv-list" id="looks" role="radiogroup" aria-label="Look"></div></div>
    <div class="lv-pop" id="pop-notes" hidden><p class="lv-pop-h">Layout check</p><ul id="notes"></ul></div>
    <div class="lv-pop lv-pop-menu" id="pop-export" hidden>
      <button type="button" class="lv-menu" data-out="png"><b>PNG</b><span>Image at canvas size</span></button>
      <button type="button" class="lv-menu" data-out="png2"><b>PNG, 2×</b><span>Sharp on retina screens</span></button>
      <button type="button" class="lv-menu" data-out="svg"><b>SVG</b><span>Vector, opens in Figma or Illustrator</span></button>
      <button type="button" class="lv-menu" data-out="json"><b>Scene JSON</b><span>Render it again with npx @levni/levni</span></button>
      <button type="button" class="lv-menu" data-out="all-png" data-multi hidden><b>All pages, PNG</b><span>One image per page</span></button>
      <button type="button" class="lv-menu" data-out="all-json" data-multi hidden><b>All pages, JSON</b><span>Every page as a scene</span></button>
      <a class="lv-menu lv-menu-cta" href="/mcp/"><b>Make the next one from a prompt</b><span>Levni in Claude or Codex, on the plan you already have</span></a>
    </div>
    <div class="lv-pop lv-pop-sm" id="pop-color" hidden></div>
    <div class="lv-pop lv-pop-sm" id="pop-variant" hidden></div>
    <div class="lv-pop lv-pop-sm" id="pop-style" hidden></div>

    <!-- rail -->
    <nav class="lv-rail" aria-label="Editor panels">
      {rail.map(([id, label]) => <button type="button" class="lv-rail-b" data-panel={id} aria-pressed="false"><span set:html={ico(id)} /><span>{label}</span></button>)}
    </nav>

    <!-- flyout panel -->
    <aside class="lv-fly" id="fly" aria-labelledby="fly-h">
      <div class="lv-fly-head">
        <button type="button" class="lv-back" id="fly-back" aria-label="Back" hidden>←</button>
        <h2 id="fly-h">Drawings</h2>
        <button type="button" class="lv-x" id="fly-close" aria-label="Close panel" set:html={ico('close', 18)} />
      </div>
      <div class="lv-fly-body">
        <section data-p="templates" hidden>
          <details class="lv-brandf" id="brandf">
            <summary><b>Brand → 8 posters</b><span>A poster series from a name, a mark and your inks, added as pages</span></summary>
            <div class="lv-brandf-body">
              <label>Name<input id="bf-name" type="text" value="Kumru" maxlength="24" /></label>
              <label>Tagline<input id="bf-tag" type="text" value="Slow coffee for fast mornings" maxlength="80" /></label>
              <label>Mark, any drawing<input id="bf-mark" type="text" value="dove" placeholder="dove, tulip, rocket…" /></label>
              <label>Four words<input id="bf-words" type="text" value="Roast, Pour, Share, Brew" /></label>
              <span class="lv-brandf-inks" role="group" aria-label="Inks">
                <input type="color" value="#14181f" aria-label="Ink 1" /><input type="color" value="#1f3be0" aria-label="Ink 2" /><input type="color" value="#f0573a" aria-label="Ink 3" /><input type="color" value="#f1eee6" aria-label="Ink 4" />
              </span>
              <button type="button" class="lv-brandf-go" id="bf-go">Make the posters</button>
            </div>
          </details>
          <p class="lv-help">Start from a finished scene: click to put it on this page (Undo brings yours back), or <b>+</b> to add it as a new page.</p>
          <h3 class="lv-h3">Starters</h3>
          <div class="lv-grid lv-grid-2" id="templates"></div>
          <div id="gallery-tpls"></div>
        </section>
        <section data-p="drawings">
          <p class="lv-replace" id="replace-note" hidden>Pick a drawing to replace <b id="replace-name"></b>. <button type="button" id="replace-cancel">Cancel</button></p>
          <label class="sr" for="q">Search drawings</label>
          <input class="lv-search" id="q" type="search" placeholder="Search: cat, kahve, rocket…" autocomplete="off" />
          <div id="browse"></div>
        </section>
        <section data-p="shapes" hidden><p class="lv-help">Click to add, or drag onto the canvas. 3D shapes look best with Look: soft.</p><div id="shapes"></div></section>
        <section data-p="text" hidden><p class="lv-help">Type is drawn from bundled fonts, so it looks the same everywhere.</p><div class="lv-texts" id="texts"></div></section>
        <section data-p="layers" hidden>
          <div class="lv-seg2" role="tablist" aria-label="Position">
            <button type="button" role="tab" id="pos-arrange" aria-selected="false">Arrange</button>
            <button type="button" role="tab" id="pos-layers" aria-selected="true">Layers</button>
          </div>
          <div id="arrange" hidden></div>
          <div id="layerbox"><p class="lv-help">Top of the list is in front. Drag a row by its dots to move it up or down, or select it and use the arrows.</p><ol id="layers"></ol></div>
        </section>
        <section data-p="edit" hidden><div id="props"></div></section>
        <section data-p="effects" hidden><div id="effects"></div></section>
        <section data-p="code" hidden>
          <p class="lv-help">The scene as JSON, for agents and developers. The same scene renders with <code>npx @levni/levni render scene.json out.png</code>. Every field is in the <a href="/docs/">scene format</a>.</p>
          <label class="sr" for="src">Scene JSON</label>
          <textarea id="src" spellcheck="false" autocomplete="off" autocapitalize="off" wrap="off"></textarea>
          <p class="lv-err" id="err" role="status" aria-live="polite"></p>
        </section>
      </div>
      {!embed && (
      <div class="lv-cta" id="cta">
        <button type="button" class="lv-cta-t" id="cta-toggle" aria-expanded="true" aria-controls="cta-body">
          <span class="lv-cta-k">Free in your agent too</span>
          <svg class="lv-cta-chev" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
          <span class="sr">Show or hide</span>
        </button>
        <a class="lv-cta-body" id="cta-body" href="/mcp/">
          <b>Ask for this in plain words.</b>
          <span class="lv-cta-full">Add Levni to Claude or Codex and say “make me a poster for my café”. It draws on your machine, so even a $20 Claude or ChatGPT plan is enough: no image credits, no extra bill.</span>
          <span class="lv-cta-go">Set it up in a minute →</span>
        </a>
      </div>
      )}
    </aside>

    <!-- workspace -->
    <section class="lv-work" aria-label="Workspace">
      <div class="lv-ctx" id="ctx" role="toolbar" aria-label="Selection tools"></div>
      <div class="lv-scroll" id="scroll">
        <figure class="lv-stage" id="stage" tabindex="0" aria-busy="true" aria-label="Canvas. Click a part to select it, drag to move it, drag a corner to resize. Arrow keys nudge, Delete removes.">
          <img id="img" alt="Your design" draggable="false" />
          <div class="lv-sel" id="sel" hidden>
            <span class="lv-h" data-h="nw"></span><span class="lv-h" data-h="ne"></span><span class="lv-h" data-h="sw"></span><span class="lv-h" data-h="se"></span>
            <span class="lv-rot" data-h="rot" title="Rotate"></span>
          </div>
          <div class="lv-mini" id="mini" hidden></div>
          <div class="lv-drop" id="drop" hidden>Drop to add</div>
        </figure>
      </div>
      {!embed && <div class="lv-pages" id="pages" role="list" aria-label="Pages"></div>}
      <div class="lv-bottom">
        <span class="lv-status" id="status" role="status" aria-live="polite"></span>
        <button type="button" class="lv-fit" id="fit">Fit</button>
        <label class="sr" for="zoom">Zoom</label>
        <input type="range" id="zoom" min="10" max="200" value="100" />
        <output id="zoom-v">Fit</output>
      </div>
    </section>
  </div>

<script type="application/json" id="lv-gallery" set:html={JSON.stringify(tplGroups)}></script>
<script>
  import { compose, critique, registerProps, registerFont, registerFile, fontsFor, toBlob, COLORS, STYLES } from '../../../src/browser.mjs';
  import CATS from '../data/categories.json';
  import { DRAW_STYLES, drawingName, styleOf, likeDrawing, contrast, luminance } from '../lib/draw-styles';
  import { SPEC, SHAPES, SHAPE_CATS, type Field } from '../lib/element-spec';

  // ---------- assets, loaded on demand ----------
  const propFiles = import.meta.glob('../../../library/props/*.json', { import: 'default' });
  const exampleFiles = import.meta.glob('../../../examples/*.json', { import: 'default' });
  const assetUrls = import.meta.glob('../../../examples/*.svg', { query: '?url', import: 'default', eager: true }) as Record<string, string>;
  const fontUrls = import.meta.glob('../../../fonts/*.{ttf,otf}', { query: '?url', import: 'default', eager: true }) as Record<string, string>;
  const FONT_FILES: Record<string, string> = { grotesk: 'SpaceGrotesk-Variable.ttf', black: 'ArchivoBlack-Regular.ttf', mono: 'JetBrainsMono-Variable.ttf', pixel: 'DepartureMono-Regular.otf' };

  type Row = { name: string; cat: string; tags: string[]; aliases: string[]; variants: number };
  let index: Row[] = [];
  const indexReady = fetch('/props-index.json').then((r) => r.json()).then((rows) => {
    index = rows.map(([name, cat, tags, variants, aliases]: [string, string, string[], string[], string[]]) => ({ name, cat, tags: tags.map((t) => t.toLowerCase()), aliases, variants: variants.length }));
  });
  const fileFor = (q: string) => {
    const k = String(q).toLowerCase().trim();
    return (index.find((p) => p.name === k) || index.find((p) => p.aliases.includes(k)) || index.find((p) => p.tags.includes(k)))?.name;
  };
  const loaded = { props: new Set<string>(), fonts: new Set<string>(), files: new Set<string>() };
  function collect(v: any, out: { names: Set<string>; srcs: Set<string> }) {
    if (Array.isArray(v)) return v.forEach((x) => collect(x, out));
    if (!v || typeof v !== 'object') return;
    for (const k of ['name', 'prop', 'mark']) if (typeof v[k] === 'string') out.names.add(v[k]);
    if (typeof v.src === 'string') out.srcs.add(v.src);
    Object.values(v).forEach((x) => collect(x, out));
  }
  async function ensureAssets(s: any) {
    await indexReady;
    const want = { names: new Set<string>(), srcs: new Set<string>() };
    collect(s, want);
    const files = [...want.names].map(fileFor).filter((n): n is string => !!n && !loaded.props.has(n));
    const got = await Promise.all(files.map(async (n) => { const l = propFiles[`../../../library/props/${n}.json`]; return l ? ([n, await l()] as const) : null; }));
    const add = got.filter(Boolean) as (readonly [string, object])[];
    if (add.length) { registerProps(add.map(([, p]) => p)); add.forEach(([n]) => loaded.props.add(n)); }
    await Promise.all([...want.srcs].filter((p) => !loaded.files.has(p)).map(async (p) => {
      const url = Object.entries(assetUrls).find(([k]) => k.endsWith('/' + p.split('/').pop()))?.[1];
      if (url) { registerFile(p, await (await fetch(url)).arrayBuffer()); loaded.files.add(p); }
    }));
    await Promise.all(fontsFor(s).filter((f: string) => !loaded.fonts.has(f)).map(async (f: string) => {
      const url = Object.entries(fontUrls).find(([k]) => k.endsWith(FONT_FILES[f]))?.[1];
      if (url) { registerFont(f, await (await fetch(url)).arrayBuffer()); loaded.fonts.add(f); }
    }));
  }

  // ---------- sizes and looks ----------
  const SIZES: { label: string; use: string; wh: [number, number] }[] = [
    { label: 'Cover', use: 'Blog and article covers', wh: [1200, 673] },
    { label: 'Link preview', use: 'Open Graph, X, LinkedIn', wh: [1200, 630] },
    { label: 'GitHub', use: 'README and social preview', wh: [1280, 640] },
    { label: 'Square', use: 'Instagram and feeds', wh: [1080, 1080] },
    { label: 'Story', use: 'Stories, Reels, Shorts', wh: [1080, 1920] },
    { label: 'YouTube', use: 'Video thumbnails', wh: [1280, 720] },
    { label: 'Poster', use: 'Print and posters, 3:4', wh: [1200, 1600] },
  ];
  const FORMAT_WH: Record<string, [number, number]> = { cover: [1200, 673], og: [1200, 630], square: [1080, 1080], story: [1080, 1920], youtube: [1280, 720], poster: [1200, 1600], 'poster-tall': [1200, 1800], a4: [1240, 1754] };
  const LOOKS = [
    { style: '', finish: '', label: 'Riso, crayon', note: 'Hand-inked lines, misprinted colour plates, paper grain.' },
    { style: '', finish: 'soft', label: 'Riso, soft', note: 'Clean edges and a fine film grain. Best for 3D.' },
    { style: 'miniature', finish: '', label: 'Miniature, crayon', note: 'Tulip Era colours: lapis, vermilion, gold on warm paper.' },
    { style: 'miniature', finish: 'soft', label: 'Miniature, soft', note: 'The miniature palette with clean edges.' },
  ];
  const sizeOf = (s: any): [number, number] => s.canvas || FORMAT_WH[s.format] || [1200, 673];
  const lookOf = (s: any) => LOOKS.find((l) => l.style === (typeof s.style === 'string' ? s.style : s.style ? '?' : '') && l.finish === (s.finish ?? '')) || null;
  const palette = (s: any): Record<string, string> => ({ ...COLORS, ...(typeof s?.style === 'string' ? (STYLES as any)[s.style] : {}) });
  const SWATCHES = ['ink', 'blue', 'tone', 'coral', 'tone-coral', 'mustard', 'tone-mustard', 'green', 'tone-green', 'dark', 'paper', 'white'];
  const hexOf = (c: any) => (typeof c === 'string' && /^#/.test(c) ? c : palette(scene)[c] || '#14181f');

  // ---------- things to add (s: a size unit, 30 % of the short side) ----------
  type Maker = (x: number, y: number, s: number) => any;
  const R = Math.round;
  // text presets; a combo returns several elements, added together. Previews are drawn by Levni itself.
  const TEXTS: { id: string; label: string; make: Maker }[] = [
    { id: 'headline', label: 'Headline', make: (x, y, s) => ({ type: 'type', text: 'Big idea.', x: R(x - s * 1.2), y: R(y - s * 0.2), size: R(s * 0.45), font: 'black', color: 'ink' }) },
    { id: 'subhead', label: 'Subhead', make: (x, y, s) => ({ type: 'type', text: 'A line about it', x: R(x - s * 1.2), y: R(y - s * 0.07), size: R(s * 0.16), font: 'grotesk', color: 'ink' }) },
    { id: 'kicker-head', label: 'Kicker and headline', make: (x, y, s) => [
      { type: 'label', text: 'New / Issue 04', x: R(x - s * 1.2), y: R(y - s * 0.4), size: R(s * 0.08), color: 'coral' },
      { type: 'type', text: 'Slow mornings.', x: R(x - s * 1.2), y: R(y - s * 0.25), w: R(s * 2.4), font: 'black', color: 'ink' },
    ] },
    { id: 'head-sub', label: 'Headline and subhead', make: (x, y, s) => [
      { type: 'type', text: 'Big idea.', x: R(x - s * 1.2), y: R(y - s * 0.35), size: R(s * 0.42), font: 'black', color: 'ink' },
      { type: 'type', text: 'One line that says why it matters', x: R(x - s * 1.2), y: R(y + s * 0.2), w: R(s * 2.4), font: 'grotesk', color: 'ink' },
    ] },
    { id: 'two-weights', label: 'Light and heavy', make: (x, y, s) => ({ type: 'type', text: '__SLOW__ **COFFEE**', x: R(x - s * 1.2), y: R(y - s * 0.12), w: R(s * 2.4), font: 'grotesk', weight: 300, boldFont: 'black', color: 'blue' }) },
    { id: 'outline-solid', label: 'Outline over solid', make: (x, y, s) => [
      { type: 'type', text: 'BRIGHT', x: R(x - s * 1.2), y: R(y - s * 0.5), w: R(s * 2.0), font: 'black', outline: true, weight: 3, color: 'ink' },
      { type: 'type', text: 'IDEAS', x: R(x - s * 1.2), y: R(y + s * 0.02), w: R(s * 1.6), font: 'black', color: 'coral' },
    ] },
    { id: 'big-number', label: 'Big number', make: (x, y, s) => [
      { type: 'type', text: '42%', x: R(x - s * 1.2), y: R(y - s * 0.4), size: R(s * 0.7), font: 'black', color: 'coral' },
      { type: 'label', text: 'of readers come back', x: R(x - s * 1.17), y: R(y + s * 0.42), size: R(s * 0.08), color: 'ink' },
    ] },
    { id: 'quote', label: 'Quote', make: (x, y, s) => [
      { type: 'type', text: '“Good coffee,\nslow mornings.”', x: R(x - s * 1.2), y: R(y - s * 0.3), size: R(s * 0.2), font: 'grotesk', weight: 400, color: 'ink' },
      { type: 'label', text: '/ The menu', x: R(x - s * 1.2), y: R(y + s * 0.3), size: R(s * 0.08), color: 'coral' },
    ] },
    { id: 'pixel-caption', label: 'Pixel title and caption', make: (x, y, s) => [
      { type: 'type', text: 'GAME ON', x: R(x - s * 1.2), y: R(y - s * 0.4), w: R(s * 1.8), font: 'pixel', color: 'blue' },
      { type: 'type', text: 'PRESS START TO PLAY', x: R(x - s * 1.2), y: R(y + s * 0.3), size: R(s * 0.1), font: 'mono', weight: 700, color: 'coral' },
    ] },
