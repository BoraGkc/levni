  function customColor(current: any, onInput: (c: string) => void, onDone: () => void) {
    const lab = document.createElement('label'); lab.className = 'lv-anycol';
    const isHex = typeof current === 'string' && /^#[0-9a-f]{6}$/i.test(current);
    const ring = document.createElement('span'); ring.className = 'lv-anycol-ring'; if (isHex) { ring.style.setProperty('--c', current); ring.classList.add('on'); }
    const input = Object.assign(document.createElement('input'), { type: 'color', value: isHex ? current : '#e0532f', className: 'sr' });
    input.setAttribute('aria-label', 'Any colour');
    input.addEventListener('input', () => { ring.style.setProperty('--c', input.value); ring.classList.add('on'); onInput(input.value); });
    input.addEventListener('change', onDone);
    lab.append(input, ring, Object.assign(document.createElement('span'), { textContent: isHex ? current.toUpperCase() : 'Any colour' }));
    return lab;
  }

  // ---------- effects panel ----------
  const effectThumbs = new Map<string, string>();
  async function effectPic(key: string, el: any) {
    if (effectThumbs.has(key)) return effectThumbs.get(key)!;
