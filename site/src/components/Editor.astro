  .lv-drow { display: grid; grid-template-columns: 30px minmax(0, 1.4fr) minmax(0, 1fr) 30px; gap: 6px; align-items: center; }
  .lv-drow input { width: 100%; min-width: 0; box-sizing: border-box; font: 14px/1.3 var(--serif); padding: 7px 8px; border: 1.5px solid var(--line); border-radius: 0; background: #fff; color: var(--ink); }
  .lv-dhead span { font: 600 10px/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-soft); }
  .lv-dchip { width: 26px; height: 26px; border-radius: 50%; border: 2px solid #fff; box-shadow: 0 0 0 1.5px var(--line); background: var(--c); cursor: pointer; padding: 0; }
