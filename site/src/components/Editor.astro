  .lv-anycol-ring { position: relative; width: 26px; height: 26px; border-radius: 50%; background: conic-gradient(#f2603f, #f2c230, #1e783f, #3fa7d6, #0b57d0, #8f4fd8, #f2603f); box-shadow: inset 0 0 0 1px rgba(20,24,31,.2); }
  .lv-anycol-ring::after { content: '+'; position: absolute; inset: 5px; display: grid; place-items: center; border-radius: 50%; background: #fff; font: 700 13px/1 var(--mono); color: var(--ink); }
  .lv-anycol-ring.on::after { content: ''; background: var(--c); }
