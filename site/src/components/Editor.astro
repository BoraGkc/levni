  const thumb = (name: string, v = 0, size = 72) => Object.assign(document.createElement('img'), { src: `/props/${name}-${v}.webp`, alt: '', width: size, height: size, loading: 'lazy', draggable: false });
  function drawingTile(name: string) {
    const b = document.createElement('button');
    b.type = 'button'; b.className = 'lv-tile';
    const nm = name.replace(/-/g, ' ');
    b.title = nm; b.setAttribute('aria-label', replacing ? `Use ${nm}` : `Add ${nm}`);
    b.append(thumb(name));
    b.addEventListener('click', () => (replacing ? replaceWith(name) : add({ kind: 'prop', name })));
    draggable(b, { kind: 'prop', name });
    return b;
  }
  function row(title: string, names: string[], onAll?: () => void) {
    const sec = document.createElement('div'); sec.className = 'lv-row';
    const head = document.createElement('div'); head.className = 'lv-row-h';
    head.append(Object.assign(document.createElement('h3'), { textContent: title }));
    if (onAll) { const a = Object.assign(document.createElement('button'), { type: 'button', textContent: 'See all' }); a.addEventListener('click', onAll); head.append(a); }
    const g = document.createElement('div'); g.className = 'lv-grid';
    g.append(...names.map(drawingTile));
    sec.append(head, g);
    return sec;
  }
  const score = (p: Row, k: string) => p.name === k ? 5 : p.name.split('-').includes(k) || p.aliases.includes(k) ? 3 : p.tags.includes(k) ? 2.5 : p.name.includes(k) ? 1.5 : p.tags.some((t) => t.startsWith(k)) ? 1 : 0;
  async function listDrawings() {
    await indexReady;
    const k = q.value.trim().toLowerCase();
    $('fly-back').hidden = !(panel === 'drawings' && openShelf && !k);
    if (k || openShelf) {
      let rows = index.filter((p) => !openShelf || k || p.cat === openShelf);
      if (k) rows = rows.map((p) => [p, score(p, k)] as const).filter(([, s]) => s > 0).sort((a, b) => b[1] - a[1]).map(([p]) => p);
      const title = k ? `${rows.length} ${rows.length === 1 ? 'drawing' : 'drawings'} for “${q.value.trim()}”` : (CATS as Record<string, string>)[openShelf];
      const g = document.createElement('div'); g.className = 'lv-grid';
      g.append(...rows.slice(0, shown).map((p) => drawingTile(p.name)));
      const parts: HTMLElement[] = [Object.assign(document.createElement('p'), { className: 'lv-count', textContent: title }), g];
      if (!rows.length) parts.push(Object.assign(document.createElement('p'), { className: 'lv-help', textContent: 'Nothing here. Try another word, in English or Turkish (kedi, kahve).' }));
      if (rows.length > shown) { const m = Object.assign(document.createElement('button'), { type: 'button', className: 'lv-more', textContent: `Show more (${rows.length - shown})` }); m.addEventListener('click', () => { shown += 90; listDrawings(); }); parts.push(m); }
      return browse.replaceChildren(...parts);
    }
    const parts: HTMLElement[] = [];
    const rec = recent().filter((n) => index.some((p) => p.name === n));
    if (rec.length) parts.push(row('Recently used', rec.slice(0, 6)));
    for (const [id, label] of Object.entries(CATS as Record<string, string>)) {
      const names = index.filter((p) => p.cat === id).map((p) => p.name);
      parts.push(row(label, names.slice(0, 3), () => { openShelf = id; shown = 60; listDrawings(); fly.querySelector('.lv-fly-body')!.scrollTop = 0; }));
    }
    browse.replaceChildren(...parts);
  }
  $('fly-back').addEventListener('click', () => { openShelf = ''; listDrawings(); });
  let qt = 0;
