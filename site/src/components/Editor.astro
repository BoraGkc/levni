    parts.push(sep(),
      ctxButton('Settings', () => (typeof e.text === 'string' ? editText() : openPanel('edit')), { title: typeof e.text === 'string' ? 'Every setting, with the words first (or double-click the text)' : 'Every setting of this part', pressed: open('edit') }),
      ctxButton('Arrange', () => { openPanel('layers'); setPosTab('arrange'); }, { title: 'Order, align, layers', pressed: open('layers') }));
    ctx.replaceChildren(...parts);
  }

  // colour and variant popovers
