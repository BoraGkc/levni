  .lv-t-mono .lv-sample { font: 700 15px/1 var(--mono); color: var(--coral-deep); }
  .lv-t-pixel .lv-sample { font: 700 20px/1 var(--mono); letter-spacing: .1em; color: var(--accent); }
  .lv-t-label .lv-sample { font: 700 12px/1 var(--mono); letter-spacing: .08em; color: var(--coral-deep); }
  .lv-seg2 { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; padding: 3px; margin-bottom: 14px; border-radius: 0; background: var(--soft); }
