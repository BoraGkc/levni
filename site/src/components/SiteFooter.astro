---
import { getCollection } from 'astro:content';
import { SITE } from '../site';
const latest = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const gh = SITE.github;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="f-top">
      <div class="f-brand">
        <a class="f-mark" href="/" aria-label="Levni home"><img src="/props/pencil-0.webp" alt="" width="56" height="56" loading="lazy" /><span>Levni</span></a>
        <p>Your agent’s design studio: illustrations, brand assets, boards and posters from JSON. An open library and the engine that draws it.</p>
      </div>
      <nav class="f-cols" aria-label="Footer">
        <div>
          <h2>Product</h2>
          <ul>
            <li><a href="/features/">Features</a></li>
            <li><a href="/gallery/">Gallery</a></li>
            <li><a href="/library/">Library</a></li>
            <li><a href="/features/#boards">Brand boards</a></li>
            <li><a href="/features/#posters">Posters</a></li>
            <li><a href="/changelog/">Changelog</a></li>
          </ul>
        </div>
        <div>
          <h2>Use it</h2>
          <ul>
            <li><a href="/docs/">Docs</a></li>
            <li><a href="/docs/getting-started/">Getting started</a></li>
            <li><a href="/mcp/">MCP server</a></li>
            <li><a href="/docs/cli/">CLI</a></li>
            <li><a href={SITE.npm}>npm</a></li>
          </ul>
        </div>
        <div>
          <h2>Learn</h2>
          <ul>
            <li><a href="/blog/">All posts</a></li>
            {latest.map((p) => <li><a href={`/blog/${p.id}/`}>{p.data.title}</a></li>)}
            <li><a href="/blog/rss.xml">RSS</a></li>
          </ul>
        </div>
        <div>
          <h2>Open source</h2>
          <ul>
            <li><a href={gh}>GitHub</a></li>
            <li><a href={`${gh}/blob/main/LICENSE`}>Licence: MIT</a></li>
            <li><a href="https://creativecommons.org/licenses/by/4.0/">Folio: CC BY 4.0</a></li>
            <li><a href={`${gh}/blob/main/CONTRIBUTING.md`}>Submit a drawing</a></li>
            <li><a href={`${gh}/issues/new?template=prop-request.yml`}>Ask for a drawing</a></li>
            <li><a href={`${gh}/blob/main/CODE_OF_CONDUCT.md`}>Code of Conduct</a></li>
            <li><a href="https://openfontlicense.org/">Fonts: OFL</a></li>
          </ul>
        </div>
      </nav>
    </div>
    <div class="f-bottom">
      <p>© {year} Levni. Code MIT, Levni Folio drawings CC BY 4.0, bundled fonts SIL OFL.</p>
      <p>Powered by <a href={SITE.ortakAlan}>Ortak Alan</a></p>
    </div>
  </div>
</footer>

<style is:global>
  .site-footer { border-top: 2px solid var(--ink); margin-top: 72px; padding: 36px 0 28px; font-size: 0.98rem; color: var(--ink-soft); background: var(--paper-2); }
  .f-top { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr); gap: 32px 48px; }
  .f-brand p { margin: 10px 0 0; max-width: 28ch; line-height: 1.5; }
  .f-mark { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; color: var(--ink); }
  .f-mark span { font-family: var(--display); font-style: italic; font-weight: 600; font-size: 1.9rem; }
  .f-cols { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px 20px; }
  .f-cols h2 { font-family: var(--mono); font-size: 0.74rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink); margin: 0 0 8px; }
  .f-cols ul { list-style: none; margin: 0; padding: 0; }
  .f-cols a { display: block; white-space: normal; overflow-wrap: anywhere; color: var(--ink-soft); text-decoration: none; padding: 5px 0; line-height: 1.3; }
  .f-cols a:hover, .f-bottom a:hover { color: var(--accent-text); text-decoration: underline; }
  .f-bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px 24px; margin-top: 32px; padding-top: 16px; border-top: 1px solid var(--rule); font-size: 0.88rem; }
  .f-bottom p { margin: 0; }
  .f-bottom a { color: var(--ink); }
  @media (max-width: 62rem) {
    .f-top { grid-template-columns: minmax(0, 1fr); }
    .f-cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 400px) { .f-cols { grid-template-columns: minmax(0, 1fr); } .f-cols a { padding: 7px 0; } }
</style>
