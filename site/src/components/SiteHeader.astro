---
import { SITE } from '../site';
import Logo from './Logo.astro';
const path = Astro.url.pathname;
const here = (p: string) => path === p || path.startsWith(p);
const makes: [string, string, string][] = [
  ['Illustrations and covers', 'Scenes, styles, the critic', '/make/blog-covers-og-images/'],
  ['Brand boards', 'Nine tiles from one spec', '/make/brand-board/'],
  ['Branding posters', 'Eight posters in one series', '/make/branding-posters/'],
  ['Seals and stickers', 'Ring text, tickets, die-cuts', '/make/stickers-seals-tickets/'],
  ['Dither and mesh gradients', 'Backgrounds with a grain', '/make/dither-pixel-art/'],
  ['ASCII and dot-matrix art', 'Glyph fills from any drawing', '/make/ascii-art/'],
  ['Terrain and etching', 'Wireframes, ridgelines, engraving', '/make/wireframe-terrain-etching/'],
  ['3D and pixel icons', 'Soft 3D, extruded, pixel grids', '/make/3d-icons/'],
  ['Little 3D worlds', 'Iso dioramas from a preset', '/make/isometric-illustrations/'],
  ['Charts', 'Hand-inked bars, lines, donuts', '/make/hand-drawn-charts/'],
];
---
<header class="site-header">
  <div class="wrap header-row">
    <a class="wordmark" href="/" aria-label="Levni home">
      <Logo size={30} />
      <span>levni</span>
    </a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" hidden>
      <span class="menu-icon" aria-hidden="true"></span><span class="menu-label">Menu</span>
    </button>
    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul class="nav-main">
        <li class="has-mega">
          <a href="/features/" aria-current={path.startsWith('/features') ? 'page' : undefined}>What it makes</a>
          <button class="mega-toggle" type="button" aria-expanded="false" aria-controls="mega" aria-label="Show what Levni makes" hidden>
            <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
          </button>
          <div class="mega" id="mega">
            <ul>
              {makes.map(([t, d, h]) => <li><a href={h}><span class="m-t">{t}</span><span class="m-d">{d}</span></a></li>)}
            </ul>
            <p class="mega-foot"><a href="/make/">All free makers</a><a href="/features/">All features</a><a href="/gallery/">Browse the gallery</a><a href="/library/">The library</a></p>
          </div>
        </li>
        <li><a href="/gallery/" aria-current={here('/gallery') ? 'page' : undefined}>Gallery</a></li>
        <li><a href="/library/" aria-current={here('/library') ? 'page' : undefined}>Library</a></li>
        <li><a href="/editor/" aria-current={here('/editor') || here('/banner') ? 'page' : undefined}>Editor</a></li>
        <li><a href="/docs/" aria-current={here('/docs') ? 'page' : undefined}>Docs</a></li>
        <li><a href="/blog/" aria-current={here('/blog') ? 'page' : undefined}>Blog</a></li>
        <li><a href="/community/" aria-current={here('/community') ? 'page' : undefined}>Community</a></li>
        <li class="nav-agent"><a class="agent-link" href="/mcp/" aria-current={here('/mcp') ? 'page' : undefined}>Use with your agent</a></li>
      </ul>
      <ul class="nav-side">
        <li><a class="side-link" href={SITE.github} aria-label="Star Levni on GitHub"><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z" fill="currentColor"/></svg><span>Star<span class="long"> on GitHub</span></span></a></li>
        <li><a class="side-link" href={SITE.npm}><span>npm</span></a></li>
        <li><a class="ver" href="/changelog/" aria-label={`Version ${SITE.version}, see the changelog`}>v{SITE.version}</a></li>
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var root = document.documentElement;
    root.classList.add('js');
    var header = document.querySelector('.site-header');
    var btn = header.querySelector('.menu-btn');
    var nav = header.querySelector('#site-nav');
    var tog = header.querySelector('.mega-toggle');
    var grp = header.querySelector('.has-mega');
    btn.hidden = false; tog.hidden = false;
    var mq = window.matchMedia('(max-width: 62rem)');
    function setMenu(open, refocus) {
      btn.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('open', open);
      if (open) { nav.style.top = Math.round(header.getBoundingClientRect().bottom) + 'px'; nav.scrollTop = 0; }
      root.classList.toggle('menu-open', open && mq.matches);
      btn.querySelector('.menu-label').textContent = open ? 'Close' : 'Menu';
      if (!open && refocus) btn.focus();
    }
    function setMega(open, refocus) {
      tog.setAttribute('aria-expanded', String(open));
      grp.classList.toggle('open', open);
      if (!open && refocus) tog.focus();
    }
    btn.addEventListener('click', function () { setMenu(btn.getAttribute('aria-expanded') !== 'true'); });
    tog.addEventListener('click', function () { setMega(tog.getAttribute('aria-expanded') !== 'true'); });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        if (grp.classList.contains('open')) { setMega(false, true); }
        else if (nav.classList.contains('open')) { setMenu(false, true); }
        return;
      }
      if (e.key === 'Tab' && mq.matches && nav.classList.contains('open')) {
        var f = Array.prototype.filter.call(header.querySelectorAll('a[href], button'), function (el) { return el.offsetParent !== null; });
        var first = f[0], last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });
    document.addEventListener('click', function (e) {
      if (!grp.contains(e.target)) setMega(false);
      if (nav.classList.contains('open') && !header.contains(e.target)) setMenu(false);
    });
    nav.addEventListener('click', function (e) {
      if (e.target.closest && e.target.closest('a') && nav.classList.contains('open')) setMenu(false);
    });
    var onChange = function () { setMenu(false); setMega(false); };
    if (mq.addEventListener) mq.addEventListener('change', onChange);
  })();
</script>

<style is:global>
  /* indigo masthead: white mark, mono uppercase links, lime call to action */
  .site-header { position: relative; z-index: 20; background: var(--indigo); color: var(--on-indigo); border-bottom: 0; }
  .site-header .header-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: nowrap; gap: 20px; min-height: 72px; }
  .site-header .wordmark { display: flex; align-items: center; color: #fff; gap: 10px; text-decoration: none; flex: none; }
  .site-header .wordmark span { font-family: var(--display); font-style: normal; font-weight: 800; font-size: 1.55rem; letter-spacing: -0.04em; }
  .site-nav { display: flex; align-items: center; justify-content: flex-end; flex: 1; gap: 18px; flex-wrap: nowrap; font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .site-nav ul { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: 4px 6px; }
  .site-nav a { color: var(--on-indigo); text-decoration: none; padding: 10px 9px; white-space: nowrap; opacity: 0.85; }
  .site-nav a:hover { color: #fff; opacity: 1; background: none; }
  .site-nav a[aria-current='page'] { opacity: 1; box-shadow: inset 0 -2px 0 var(--lime); }
  .site-nav .agent-link { opacity: 1; background: var(--lime); color: var(--indigo); font-weight: 600; margin-left: 8px; padding: 10px 16px; clip-path: polygon(0 0, 100% 0, 100% calc(100% - 7px), calc(100% - 7px) 100%, 0 100%); }
  .site-nav .agent-link:hover { background: #fff; color: var(--indigo); }
  .site-nav .agent-link[aria-current='page'] { box-shadow: none; background: #fff; }
  .nav-side { gap: 2px 4px; padding-left: 14px; border-left: 1px solid rgba(255, 255, 255, 0.22); }
  .site-nav .side-link { display: inline-flex; align-items: center; gap: 6px; padding: 10px 7px; color: var(--mute-indigo); }
  .site-nav .ver { opacity: 1; font-size: 0.74rem; border: 1px solid var(--on-indigo); padding: 4px 8px; color: var(--on-indigo); }
  .site-nav .ver:hover { background: var(--lime); color: var(--indigo); border-color: var(--lime); }

  .has-mega { position: relative; display: flex; align-items: center; }
  .mega-toggle { appearance: none; border: 0; background: none; color: var(--on-indigo); width: 26px; height: 36px; margin-left: -8px; cursor: pointer; display: inline-grid; place-items: center; }
  .mega-toggle svg { transition: transform 0.15s; }
  .has-mega.open .mega-toggle svg { transform: rotate(180deg); }
  .mega { display: none; position: absolute; top: 100%; left: -10px; width: min(580px, calc(100vw - 40px)); background: var(--paper-2); color: var(--ink); padding: 14px; z-index: 30; clip-path: var(--chamfer); box-shadow: 0 30px 60px -30px rgba(27, 19, 64, 0.5); text-transform: none; letter-spacing: 0; font-family: var(--serif); font-size: 1rem; }
  .has-mega:hover .mega, .has-mega:focus-within .mega, .has-mega.open .mega { display: block; }
  .mega ul { display: grid; grid-template-columns: 1fr 1fr; gap: 2px 10px; }
  .site-nav .mega li a { display: flex; flex-direction: column; white-space: normal; padding: 8px 10px; color: var(--ink); opacity: 1; }
  .site-nav .mega li a:hover { background: var(--paper); color: var(--indigo); }
  .mega .m-t { font-weight: 700; line-height: 1.25; letter-spacing: -0.01em; }
  .mega .m-d { font-size: 0.82rem; color: var(--ink-soft); line-height: 1.35; }
  .mega-foot { display: flex; flex-wrap: wrap; gap: 4px 16px; margin: 10px 0 0; padding: 10px 10px 0; border-top: 1px solid var(--rule); font-family: var(--mono); font-size: 0.78rem; }
  .site-nav .mega-foot a { padding: 4px 0; color: var(--accent-text); opacity: 1; text-decoration: underline; text-underline-offset: 3px; }
  .menu-btn { display: none; }

  @media (max-width: 75rem) { .site-nav .long { display: none; } .site-nav a { padding-left: 6px; padding-right: 6px; } }

  @media (max-width: 62rem) {
    .site-header .header-row { flex-wrap: wrap; gap: 0 12px; min-height: 64px; padding-top: 8px; padding-bottom: 8px; }
    .site-nav { flex-basis: 100%; padding-top: 6px; flex-direction: column; align-items: stretch; justify-content: flex-start; gap: 0; font-size: 0.86rem; }
    .site-nav ul { flex-direction: column; align-items: stretch; }
    .site-nav li a { display: block; padding: 14px 2px; border-bottom: 1px solid rgba(255, 255, 255, 0.16); opacity: 1; }
    .site-nav a[aria-current='page'] { box-shadow: inset 3px 0 0 var(--lime); padding-left: 12px; }
    .has-mega { display: block; order: 3; }
    .site-nav .nav-agent { order: 2; }
    .has-mega > a { font-size: 0.72rem; color: var(--lime); padding: 18px 2px 6px; border-bottom: 0; }
    .mega-toggle { display: none; }
    .mega { display: block; position: static; width: auto; clip-path: none; box-shadow: none; background: none; color: var(--on-indigo); padding: 0 0 8px; }
    .mega ul { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .site-nav .mega li a { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2px; padding: 10px 2px; border-bottom: 1px solid rgba(255, 255, 255, 0.16); color: #fff; }
    .site-nav .mega li a:hover { background: none; color: var(--lime); }
    .mega .m-d { display: block; font-size: 0.84rem; color: var(--mute-indigo); }
    .mega-foot { display: none; }
    .site-nav .agent-link { margin: 18px 0 6px; padding: 15px; text-align: center; border-bottom: 0; }
    .site-nav .agent-link[aria-current='page'] { padding-left: 15px; }
    .site-nav .nav-side { flex-direction: row; flex-wrap: wrap; align-items: center; padding: 8px 0 4px; border-left: 0; gap: 6px 16px; }
    .site-nav .nav-side li a { display: inline-flex; align-items: center; border-bottom: 0; padding: 8px 2px; }
    .site-nav .nav-side li a.ver { padding: 4px 9px; line-height: 1.3; }
    .site-nav .nav-side .long { display: inline; }
    .js .menu-btn { display: inline-flex; align-items: center; gap: 10px; margin-left: auto; appearance: none; background: transparent; border: 1px solid var(--on-indigo); color: #fff; font: 600 0.78rem/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; padding: 8px 14px; cursor: pointer; min-height: 44px; }
    .js .menu-btn[aria-expanded='true'] { background: var(--lime); color: var(--indigo); border-color: var(--lime); }
    .menu-icon, .menu-icon::before { display: block; width: 18px; height: 2px; background: currentColor; position: relative; }
    .menu-icon::before { content: ''; top: 6px; box-shadow: 0 -12px 0 currentColor; }
    .js .site-nav:not(.open) { display: none; }
    .js .site-nav.open { position: fixed; left: 0; right: 0; bottom: 0; top: 64px; z-index: 40; background: var(--indigo); padding: 4px 20px calc(24px + env(safe-area-inset-bottom)); overflow-y: auto; overscroll-behavior: contain; }
    .js.menu-open, .js.menu-open body { overflow: hidden; }
  }
  @media (max-width: 62rem) and (prefers-reduced-motion: no-preference) {
    .js .site-nav.open { animation: sheet-in 0.16s ease-out; }
    @keyframes sheet-in { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
  }
</style>
