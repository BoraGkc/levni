---
// The three calls to action every page ends on, in this order: try it now (editor), keep using it free (MCP),
// help it grow (GitHub star).
//   <TryLevni />                    a dark band with a heading and the three actions (page ends, footer)
//   <TryLevni variant="row" />      the three buttons only (heroes, docs pages)
import { SITE } from '../site';

interface Props { variant?: 'band' | 'row'; title?: string; lede?: string; }
const {
  variant = 'band',
  title = 'Make one now. Keep making them for free.',
  lede = 'Try Levni in your browser, then add it to Claude or Codex: it draws on your machine, so the $20 plan you already have is enough. No image credits, no second bill.',
} = Astro.props;
const star = '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z" fill="currentColor"/></svg>';
const actions = [
  { href: '/editor/', label: 'Open the editor', note: 'Free, in your browser', cls: 'try-a try-primary' },
  { href: '/mcp/#setup', label: 'Add it to your agent', note: 'Claude, Codex, Cursor', cls: 'try-a' },
  { href: SITE.github, label: 'Star on GitHub', note: 'Open source, MIT', cls: 'try-a try-star', icon: star },
];
---
{variant === 'row' ? (
  <div class="try-row">
    {actions.map((a) => <a class={a.cls} href={a.href}>{a.icon && <Fragment set:html={a.icon} />}<span>{a.label}</span></a>)}
  </div>
) : (
  <div class="wrap try-wrap"><section class="try" aria-labelledby="try-title">
    <div class="try-text">
      <p class="try-k">Free, for real</p>
      <h2 id="try-title">{title}</h2>
      <p>{lede}</p>
    </div>
    <div class="try-actions">
      {actions.map((a) => (
        <a class={a.cls} href={a.href}>
          {a.icon && <Fragment set:html={a.icon} />}
          <span class="try-l"><b>{a.label}</b><small>{a.note}</small></span>
          <span class="try-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section></div>
)}

<style>
  .try-wrap { margin-top: clamp(48px, 7vw, 88px); margin-bottom: clamp(48px, 7vw, 88px); }
  .try { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 24px 48px; align-items: center; padding: clamp(28px, 4.5vw, 56px); background: var(--lime); color: var(--indigo); clip-path: polygon(0 0, 100% 0, 100% calc(100% - 24px), calc(100% - 24px) 100%, 0 100%); }
  .try-k { margin: 0 0 10px; font: 600 12px/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--indigo); }
  .try h2 { margin: 0 0 12px; color: var(--indigo); font-weight: 800; font-size: clamp(28px, 3.6vw, 46px); line-height: 1; text-wrap: balance; }
  .try-text p:last-child { margin: 0; color: var(--indigo-deep); }
  .try-actions { display: grid; gap: 10px; }
  .try-actions .try-a { display: flex; align-items: center; gap: 12px; padding: 14px 16px; background: var(--indigo); color: #fff; text-decoration: none; }
  .try-actions .try-a:hover { background: var(--indigo-deep); }
  .try-actions .try-primary { background: #fff; color: var(--indigo); }
  .try-actions .try-primary:hover { background: var(--paper); }
  .try-l { flex: 1; display: grid; gap: 2px; }
  .try-l b { font-size: 16px; }
  .try-l small { font-size: 13px; opacity: .75; }
  .try-arrow { font-size: 18px; }
  .try-row { display: flex; flex-wrap: wrap; gap: 10px; }
  .try-row .try-a { display: inline-flex; align-items: center; gap: 8px; padding: 12px 18px; border: 1.5px solid currentColor; color: var(--indigo); font: 600 0.82rem/1.2 var(--mono); letter-spacing: .06em; text-transform: uppercase; text-decoration: none; }
  .try-row .try-a:hover { background: var(--indigo); color: #fff; border-color: var(--indigo); }
  .try-row .try-primary { background: var(--indigo); border-color: var(--indigo); color: #fff; }
  .try-row .try-primary:hover { background: var(--lime); border-color: var(--lime); color: var(--indigo); }
  @media (max-width: 760px) { .try { grid-template-columns: minmax(0, 1fr); } }
</style>
