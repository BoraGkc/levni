---
import ToolPage from '../../components/tools/ToolPage.astro';
import { FREE_FAQ } from '../../data/tools';

const faq = [
  FREE_FAQ,
  { q: 'How do I use a wave as a section divider?', a: 'Copy the SVG code and paste it between two sections, or save the file and use it as an image. Tick “Stretch to any width” so the wave fills the full width of the page at any screen size. Match the fill colour to the next section’s background.' },
  { q: 'Is the SVG clean enough to edit?', a: 'Yes. Each layer is one path with one fill colour, with no filters, masks or embedded images. It opens in Figma, Illustrator or Inkscape, and you can change the colours in the code.' },
  { q: 'What is the scene JSON for?', a: 'It is the same shape as a Levni scene, with each layer as a draw element. Run npx @levni/levni render scene.json divider.png to draw it again on your machine, or give it to an agent with the Levni MCP server and ask it to add a drawing or a title on top.' },
];
const TYPES = { wave: 'Wave', layers: 'Layered waves', peaks: 'Peaks', blob: 'Blob' };
const PRESETS = {
  riso: { label: 'Riso', fills: ['#4B2FD6', '#FF3A44', '#D6E521'], ground: '#F3F1EA' },
  indigo: { label: 'Indigo', fills: ['#C3B9F7', '#4B2FD6', '#2B1A8F'], ground: '#F3F1EA' },
  sunset: { label: 'Sunset', fills: ['#F7C744', '#F28C38', '#FF3A44'], ground: '#FFF7EC' },
  sea: { label: 'Sea', fills: ['#66DCC2', '#58C4F6', '#0B57D0'], ground: '#F3F1EA' },
  mono: { label: 'Mono', fills: ['#1B1340'], ground: '#FFFFFF' },
};
const SIZES = { div: 'Divider 1440 × 240', divtall: 'Divider 1440 × 480', square: 'Square 800 × 800', og: 'OG card 1200 × 630', hd: 'Desktop 1920 × 1080' };
---
<ToolPage
  title="Free blob and wave SVG generator for dividers"
  description="Make smooth blobs, layered waves, peaks and section dividers as clean single-path SVG. Copy the code or download SVG and PNG. Free, no sign-up, no watermark."
  name="Levni blob and wave generator"
  eyebrow="Free tool"
  h1="Blob and wave generator"
  lede="Smooth blobs, waves and section dividers as clean SVG: one path per layer, no filters. Pick a shape and your colours, shuffle the seed, then copy the code or download SVG or PNG."
  faq={faq}
>
  <div class="tl-stage" id="bw" data-presets={JSON.stringify(PRESETS)}>
    <div class="tl-view">
      <figure class="tl-preview" id="bw-preview" aria-busy="true">
        <img id="bw-img" alt="Shape preview" />
      </figure>
      <p class="tl-meta" id="bw-meta" aria-live="polite"></p>
      <div class="tl-actions">
        <button type="button" class="tl-go" id="bw-copysvg">Copy SVG code</button>
        <button type="button" class="tl-ghost" id="bw-svg">Download SVG</button>
        <button type="button" class="tl-ghost" id="bw-png">PNG</button>
        <button type="button" class="tl-ghost" id="bw-png2">PNG 2×</button>
        <button type="button" class="tl-ghost" id="bw-json">Copy scene JSON</button>
        <button type="button" class="tl-ghost" id="bw-link">Copy link</button>
      </div>
      <div class="tl-code"><pre id="bw-code"></pre><button type="button" id="bw-code-copy">Copy</button></div>
    </div>

    <div class="tl-controls">
      <fieldset>
        <legend>Shape</legend>
        <div class="tl-chips" id="bw-types">{Object.entries(TYPES).map(([k, v]) => <button type="button" data-type={k} aria-pressed="false">{v}</button>)}</div>
      </fieldset>
      <fieldset>
        <legend>Colour presets</legend>
        <div class="tl-chips" id="bw-presets">
          {Object.entries(PRESETS).map(([k, p]) => (
            <button type="button" data-preset={k} aria-pressed="false"><span class="tl-sw" aria-hidden="true">{[p.ground, ...p.fills].map((c) => <i style={`background:${c}`}></i>)}</span>{p.label}</button>
          ))}
        </div>
      </fieldset>
      <fieldset>
        <legend>Fills</legend>
        <div class="tl-inks" id="bw-inks"></div>
      </fieldset>
      <label class="tl-check"><input type="checkbox" id="bw-clear" /> Transparent background</label>
      <label class="tl-check" id="bw-flip-wrap"><input type="checkbox" id="bw-flip" /> Flip (hang from the top)</label>
      <label class="tl-check"><input type="checkbox" id="bw-stretch" /> Stretch to any width</label>

      <div class="tl-field">
        <span class="tl-row2"><label for="bw-layers">Layers</label><output id="bw-layers-o" for="bw-layers"></output></span>
        <input id="bw-layers" type="range" min="1" max="6" step="1" />
      </div>
      <div class="tl-field">
        <span class="tl-row2"><label for="bw-points">Complexity</label><output id="bw-points-o" for="bw-points"></output></span>
        <input id="bw-points" type="range" min="3" max="20" step="1" />
      </div>
      <div class="tl-field">
        <span class="tl-row2"><label for="bw-height" id="bw-height-l">Height</label><output id="bw-height-o" for="bw-height"></output></span>
        <input id="bw-height" type="range" min="10" max="95" step="1" />
      </div>
      <div class="tl-field">
        <span class="tl-row2"><label for="bw-amp" id="bw-amp-l">Amplitude</label><output id="bw-amp-o" for="bw-amp"></output></span>
        <input id="bw-amp" type="range" min="0" max="100" step="1" />
      </div>
      <div class="tl-field">
        <label class="tl-lbl" for="bw-seed">Seed</label>
        <span class="tl-seed"><input id="bw-seed" type="number" min="1" max="9999" inputmode="numeric" /><button type="button" class="tl-ghost" id="bw-shuffle">Shuffle</button></span>
      </div>
      <div class="tl-field">
        <label class="tl-lbl" for="bw-size">Size</label>
        <select id="bw-size">{Object.entries(SIZES).map(([k, v]) => <option value={k}>{v}</option>)}</select>
      </div>
    </div>
  </div>

  <Fragment slot="about">
    <h2>How it works</h2>
    <p>Each layer is one smooth curve through a few random points, drawn as a single SVG path. The seed picks the points, so the same seed and settings always give the same shape, and the link in your address bar brings it back. Complexity sets how many points there are; amplitude sets how far they move.</p>
    <p>For a divider, use a wide size, tick “Stretch to any width” and paste the code at the edge of a section. Flip it to hang the wave from the top of the next section. For a blob, a square size works best; layers give a blob with rings around it.</p>
    <p>The paths are made by a small seeded script on this page, because Levni's own wave element is a hand-drawn line, not a filled edge. The scene JSON wraps the same paths as Levni <code>draw</code> elements, so <code>npx @levni/levni render scene.json divider.png</code> or an agent with the <a href="/mcp/">Levni MCP server</a> can draw it again and put a drawing or a title on top.</p>
  </Fragment>
</ToolPage>

<script>
  import { savePng, saveSvg, copy, readHash, writeHash, debounce, newSeed, clampInt, hexList, isHex, hex, showSvg } from '../../components/tools/engine';

  type Preset = { label: string; fills: string[]; ground: string };
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const PRESETS: Record<string, Preset> = JSON.parse($('bw').dataset.presets!);
  const SIZES: Record<string, [number, number]> = { div: [1440, 240], divtall: [1440, 480], square: [800, 800], og: [1200, 630], hd: [1920, 1080] };
  const TYPES = ['wave', 'layers', 'peaks', 'blob'];

  // Levni has no filled single-path divider (its `waves` element is a hand-drawn line), so the shapes are made
  // here: a small seeded RNG (mulberry32, the same one Levni uses) and Catmull-Rom curves. Deterministic by seed.
  function rng(seed: number) {
    let a = seed >>> 0;
    return () => { a = (a + 0x6d2b79f5) >>> 0; let t = a; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
  }
  const f = (n: number) => String(Math.round(n * 10) / 10);
  // smooth curve through points (Catmull-Rom as cubic Beziers); closed for blobs
  function curve(p: number[][], closed: boolean) {
    const n = p.length, at = (i: number) => (closed ? p[(i + n) % n] : p[Math.max(0, Math.min(n - 1, i))]);
    let s = '';
    for (let i = 0; i < (closed ? n : n - 1); i++) {
      const p0 = at(i - 1), p1 = at(i), p2 = at(i + 1), p3 = at(i + 2);
      s += `C${f(p1[0] + (p2[0] - p0[0]) / 6)} ${f(p1[1] + (p2[1] - p0[1]) / 6)} ${f(p2[0] - (p3[0] - p1[0]) / 6)} ${f(p2[1] - (p3[1] - p1[1]) / 6)} ${f(p2[0])} ${f(p2[1])}`;
    }
    return s;
  }
  // colours for n layers: the fills as given, or blended between the first and the last
  function layerColors(fills: string[], n: number) {
    if (fills.length >= n) return fills.slice(0, n);
    if (fills.length === 1) return Array(n).fill(fills[0]);
    const rgb = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
    const a = rgb(fills[0]), b = rgb(fills[fills.length - 1]);
    return Array.from({ length: n }, (_, k) => '#' + a.map((v, i) => Math.round(v + ((b[i] - v) * k) / (n - 1)).toString(16).padStart(2, '0')).join('').toUpperCase());
  }

  type Layer = { d: string; fill: string };
  function shapes(W: number, H: number): Layer[] {
    const r = rng(S.s), n = S.l, cols = layerColors(S.f, n), out: Layer[] = [];
    if (S.t === 'blob') {
      const R = (Math.min(W, H) / 2) * (S.h / 100), cx = W / 2, cy = H / 2, m = S.p;
      const jit = Array.from({ length: m }, () => r()); // one outline, scaled per layer: rings around the blob
      for (let k = 0; k < n; k++) {
        const rr = R * (1 - (k / Math.max(1, n)) * 0.72);
        const pts = jit.map((j, i) => { const a = (i / m) * Math.PI * 2 - Math.PI / 2, q = rr * (1 - (S.a / 100) * 0.55 * j); return [cx + Math.cos(a) * q, cy + Math.sin(a) * q]; });
        out.push({ d: `M${f(pts[0][0])} ${f(pts[0][1])}${curve(pts, true)}Z`, fill: cols[k] });
      }
      return out;
    }
    const m = S.p;
    for (let k = 0; k < n; k++) {
      // back layers reach higher, front layers lower; each layer has its own random points
      const top = H * (1 - (S.h / 100) * (1 - (k / Math.max(1, n)) * 0.75));
      const amp = (S.a / 100) * H * 0.5 * (S.t === 'wave' ? 1 : 1 / Math.sqrt(n));
      const pts = Array.from({ length: m }, (_, i) => [(i / (m - 1)) * W, Math.min(H, Math.max(0, top + (r() - 0.5) * 2 * amp))]);
      const edge = S.t === 'peaks' ? pts.slice(1).map(([x, y]) => `L${f(x)} ${f(y)}`).join('') : curve(pts, false);
      let d = `M0 ${f(H)}L0 ${f(pts[0][1])}${edge}L${f(W)} ${f(H)}Z`;
      if (S.fl) d = flipY(d, H);
      out.push({ d, fill: cols[k] });
      if (S.t === 'wave') break;
    }
    return out;
  }
  // mirror path data top to bottom (y -> H - y): every second number in M/L/C is a y
  const flipY = (d: string, H: number) => d.replace(/([MLC])([^MLCZ]+)/g, (_, c, nums) => c + nums.trim().split(/\s+/).map((v: string, i: number) => (i % 2 ? f(H - Number(v)) : v)).join(' '));

  function svgOf(layers: Layer[], W: number, H: number) {
    const bg = S.c ? '' : `\n  <rect width="${W}" height="${H}" fill="${S.g}"/>`;
    const par = S.st ? ' preserveAspectRatio="none"' : '';
    return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${W} ${H}" width="${W}" height="${H}"${par}>${bg}\n${layers.map((l) => `  <path fill="${l.fill}" d="${l.d}"/>`).join('\n')}\n</svg>`;
  }
  // the same picture as a Levni scene: each layer a `draw` element in a 0..100 box as big as the canvas' long side
  function sceneOf(layers: Layer[], W: number, H: number) {
    const B = Math.max(W, H), k = 100 / B;
    const conv = (d: string) => d.replace(/-?\d+(\.\d+)?/g, (v) => String(Math.round(Number(v) * k * 1000) / 1000));
    return { seed: S.s, finish: 'soft', grain: 0, hand: false, canvas: [W, H], background: S.c ? 'none' : S.g, elements: layers.map((l) => ({ type: 'draw', x: B / 2, y: B / 2, size: B, paths: [{ d: conv(l.d), fill: l.fill, stroke: 'none' }] })) };
  }

  const img = $<HTMLImageElement>('bw-img'), preview = $('bw-preview'), meta = $('bw-meta'), inksEl = $('bw-inks'), code = $('bw-code');
  const clearEl = $<HTMLInputElement>('bw-clear'), flipEl = $<HTMLInputElement>('bw-flip'), stretchEl = $<HTMLInputElement>('bw-stretch');
  const layersEl = $<HTMLInputElement>('bw-layers'), pointsEl = $<HTMLInputElement>('bw-points'), heightEl = $<HTMLInputElement>('bw-height'), ampEl = $<HTMLInputElement>('bw-amp');
  const seedEl = $<HTMLInputElement>('bw-seed'), sizeEl = $<HTMLSelectElement>('bw-size');

  const h = readHash();
  const S = {
    t: TYPES.includes(h.t) ? h.t : 'layers',
    f: hexList(h.f).slice(0, 3),
    g: isHex(h.g) ? hex(h.g) : PRESETS.indigo.ground,
    c: h.c === '1' ? 1 : 0, // transparent
    fl: h.fl === '1' ? 1 : 0,
    st: h.st === '1' ? 1 : 0,
    l: clampInt(h.l, 3, 1, 6),
    p: clampInt(h.p, 6, 3, 20),
    h: clampInt(h.h, 60, 10, 95),
    a: clampInt(h.a, 45, 0, 100),
    s: clampInt(h.s, 12, 1, 9999),
    sz: h.sz in SIZES ? h.sz : 'div',
  };
  if (!S.f.length) S.f = [...PRESETS.indigo.fills];

  const shown = { url: '' };
  let current = { svg: '', scene: null as any };
  function draw() {
    const t0 = performance.now();
    const [W, H] = SIZES[S.sz];
    const layers = shapes(W, H);
    const svg = svgOf(layers, W, H);
    current = { svg, scene: sceneOf(layers, W, H) };
    // the preview never stretches: show the true proportions
    showSvg(img, S.st ? svg.replace(' preserveAspectRatio="none"', '') : svg, shown);
    (window as any).__levniLastDraw = Math.round(performance.now() - t0);
    code.textContent = svg;
    img.alt = `${S.t === 'blob' ? 'Blob' : 'Wave'} with ${layers.length} ${layers.length === 1 ? 'layer' : 'layers'}, ${W} by ${H} pixels`;
    meta.textContent = `${W} × ${H} px · seed ${S.s} · ${(new Blob([svg]).size / 1024).toFixed(1)} KB`;
    preview.setAttribute('aria-busy', 'false');
    writeHash(S);
  }
  const drawSoon = debounce(draw, 30);

  function renderInks() {
    inksEl.replaceChildren();
    const mk = (val: string, label: string, aria: string, set: (v: string) => void) => {
      const lab = document.createElement('label'); lab.className = 'tl-ink';
      const inp = document.createElement('input'); inp.type = 'color'; inp.value = val.toLowerCase(); inp.setAttribute('aria-label', aria);
      inp.addEventListener('input', () => { set(hex(inp.value)); markPreset(); drawSoon(); });
      lab.append(inp, document.createTextNode(label));
      return lab;
    };
    S.f.forEach((c, k) => inksEl.append(mk(c, String(k + 1), `Fill ${k + 1}`, (v) => (S.f[k] = v))));
    inksEl.append(mk(S.g, 'ground', 'Background colour', (v) => (S.g = v)));
    const row = document.createElement('div'); row.className = 'tl-minirow';
    const add = document.createElement('button'); add.type = 'button'; add.className = 'tl-mini'; add.textContent = '+ Add fill'; add.disabled = S.f.length >= 3;
    add.addEventListener('click', () => { S.f.push(S.f[S.f.length - 1]); renderInks(); markPreset(); draw(); });
    const rm = document.createElement('button'); rm.type = 'button'; rm.className = 'tl-mini'; rm.textContent = '− Remove last'; rm.disabled = S.f.length <= 1;
    rm.addEventListener('click', () => { S.f.pop(); renderInks(); markPreset(); draw(); });
    row.append(add, rm); inksEl.append(row);
  }
  function markPreset() {
    for (const b of document.querySelectorAll<HTMLButtonElement>('#bw-presets button')) {
      const p = PRESETS[b.dataset.preset!];
      b.setAttribute('aria-pressed', String(p.ground === S.g && p.fills.join() === S.f.join()));
    }
  }
  function syncType() {
    for (const b of document.querySelectorAll<HTMLButtonElement>('#bw-types button')) b.setAttribute('aria-pressed', String(b.dataset.type === S.t));
    $('bw-flip-wrap').hidden = S.t === 'blob';
    $('bw-height-l').textContent = S.t === 'blob' ? 'Size' : 'Height';
    $('bw-amp-l').textContent = S.t === 'blob' ? 'Randomness' : 'Amplitude';
    layersEl.disabled = S.t === 'wave';
  }
  const out = (id: string, v: string) => ($(id).textContent = v);
  function syncControls() {
    clearEl.checked = !!S.c; flipEl.checked = !!S.fl; stretchEl.checked = !!S.st;
    layersEl.value = String(S.l); pointsEl.value = String(S.p); heightEl.value = String(S.h); ampEl.value = String(S.a);
    seedEl.value = String(S.s); sizeEl.value = S.sz;
    out('bw-layers-o', String(S.l)); out('bw-points-o', String(S.p)); out('bw-height-o', `${S.h}%`); out('bw-amp-o', `${S.a}%`);
    syncType(); renderInks(); markPreset();
  }

  $('bw-types').addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest('button'); if (!b) return; S.t = b.dataset.type!; if (S.t === 'blob' && S.sz.startsWith('div')) { S.sz = 'square'; sizeEl.value = S.sz; } syncType(); draw(); });
  $('bw-presets').addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest('button'); if (!b) return; const p = PRESETS[b.dataset.preset!]; S.f = [...p.fills]; S.g = p.ground; renderInks(); markPreset(); draw(); });
  clearEl.addEventListener('change', () => { S.c = clearEl.checked ? 1 : 0; draw(); });
  flipEl.addEventListener('change', () => { S.fl = flipEl.checked ? 1 : 0; draw(); });
  stretchEl.addEventListener('change', () => { S.st = stretchEl.checked ? 1 : 0; draw(); });
  layersEl.addEventListener('input', () => { S.l = +layersEl.value; out('bw-layers-o', String(S.l)); drawSoon(); });
  pointsEl.addEventListener('input', () => { S.p = +pointsEl.value; out('bw-points-o', String(S.p)); drawSoon(); });
  heightEl.addEventListener('input', () => { S.h = +heightEl.value; out('bw-height-o', `${S.h}%`); drawSoon(); });
  ampEl.addEventListener('input', () => { S.a = +ampEl.value; out('bw-amp-o', `${S.a}%`); drawSoon(); });
  seedEl.addEventListener('input', () => { S.s = clampInt(seedEl.value, S.s, 1, 9999); drawSoon(); });
  $('bw-shuffle').addEventListener('click', () => { S.s = newSeed(); seedEl.value = String(S.s); draw(); });
  sizeEl.addEventListener('change', () => { S.sz = sizeEl.value; draw(); });

  const file = () => { const [W, H] = SIZES[S.sz]; return `${S.t}-${W}x${H}-${S.s}`; };
  const pngSvg = () => current.svg.replace(' preserveAspectRatio="none"', '');
  $('bw-copysvg').addEventListener('click', (e) => copy(current.svg, e.currentTarget as HTMLElement));
  $('bw-code-copy').addEventListener('click', (e) => copy(current.svg, e.currentTarget as HTMLElement));
  $('bw-svg').addEventListener('click', () => saveSvg(current.svg, `${file()}.svg`));
  $('bw-png').addEventListener('click', () => savePng(pngSvg(), `${file()}.png`, 1));
  $('bw-png2').addEventListener('click', () => savePng(pngSvg(), `${file()}@2x.png`, 2));
  $('bw-json').addEventListener('click', (e) => copy(JSON.stringify(current.scene, null, 2), e.currentTarget as HTMLElement));
  $('bw-link').addEventListener('click', (e) => copy(location.href, e.currentTarget as HTMLElement));

  syncControls();
  draw();
</script>
