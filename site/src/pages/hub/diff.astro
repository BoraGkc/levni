---
// Levni Hub diff: two versions of a design side by side, as an overlay with a slider, and with the changed pixels
// marked; under it, what changed field by field, and the remix chain. Paste JSON, a Pen or editor link, or drop a PNG.
import Base from '../../layouts/Base.astro';
---
<Base title="Levni diff: see what changed between two versions of a design" description="Compare two versions of a Levni design: side by side, as an overlay with a slider, or with every changed pixel marked, plus a list of the fields that changed and the remix chain. Free, in your browser.">
  <div class="wrap hd">
    <header class="brand-hero">
      <p class="eyebrow">Levni Hub</p>
      <h1>See what changed.</h1>
      <p class="lede">A visual diff for designs. Paste two scenes, two Pen or editor links, or drop two Levni PNGs. You get them side by side, as an overlay with a slider, with every changed pixel marked, and a list of what changed and who changed it.</p>
    </header>

    <div class="hd-in">
      {['a', 'b'].map((k) => (
        <label class="hd-box">
          <span>{k === 'a' ? 'Before' : 'After'}</span>
          <textarea id={`hd-${k}`} spellcheck="false" placeholder="Scene JSON, a levni.dev/pen/#s=… link, or drop a PNG here"></textarea>
        </label>
      ))}
    </div>
    <p class="hd-actions"><button type="button" class="hd-go" id="hd-run">Compare</button> <button type="button" class="hd-ghost" id="hd-sample">Try a sample</button> <span id="hd-status" role="status" aria-live="polite"></span></p>

    <div id="hd-out" hidden>
      <div class="hd-tabs" role="tablist">
        <button type="button" role="tab" aria-selected="true" data-v="side">Side by side</button>
        <button type="button" role="tab" aria-selected="false" data-v="slide">Slider</button>
        <button type="button" role="tab" aria-selected="false" data-v="px">Changed pixels</button>
      </div>
      <div class="hd-view" data-v="side"><figure><img id="hd-ia" alt="Before" /><figcaption>Before</figcaption></figure><figure><img id="hd-ib" alt="After" /><figcaption>After</figcaption></figure></div>
      <div class="hd-view" data-v="slide" hidden>
        <div class="hd-slide" id="hd-slide"><img id="hd-sa" alt="Before" /><div class="hd-top" id="hd-top"><img id="hd-sb" alt="After" /></div></div>
        <input type="range" id="hd-pos" min="0" max="100" value="50" aria-label="Before and after" />
      </div>
      <div class="hd-view" data-v="px" hidden><canvas id="hd-px"></canvas><p class="hd-small" id="hd-pxn"></p></div>
      <div class="hd-cols">
        <section><h2>What changed</h2><ul class="hd-list" id="hd-list"></ul></section>
        <section><h2>Remix chain</h2><ol class="hd-chain" id="hd-chain"></ol></section>
      </div>
    </div>
  </div>
</Base>

<script>
  import { compose, registerProps, registerFont, fontsFor, propsFor, toCanvas, readStamp, sceneDiff } from '../../../../src/browser.mjs';
  import gallery from '../../data/gallery.json';

  const propFiles = import.meta.glob('../../../../library/props/*.json', { import: 'default' });
  const fontUrls = import.meta.glob('../../../../fonts/*.{ttf,otf}', { query: '?url', import: 'default', eager: true }) as Record<string, string>;
  const FONT_FILES: Record<string, string> = { grotesk: 'SpaceGrotesk-Variable.ttf', black: 'ArchivoBlack-Regular.ttf', mono: 'JetBrainsMono-Variable.ttf', pixel: 'DepartureMono-Regular.otf' };
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const say = (t: string) => ($('hd-status').textContent = t);
  const fonts = new Set<string>(), props = new Set<string>();
  const ensure = async (sc: any) => {
    await Promise.all(fontsFor(sc).filter((n: string) => !fonts.has(n)).map(async (n: string) => { const u = Object.entries(fontUrls).find(([k]) => k.endsWith(FONT_FILES[n]))?.[1]; if (u) { registerFont(n, await (await fetch(u)).arrayBuffer()); fonts.add(n); } }));
    await Promise.all(propsFor(sc).filter((n: string) => !props.has(n)).map(async (n: string) => { const l = propFiles[`../../../../library/props/${n}.json`]; if (l) { registerProps(await l() as object); props.add(n); } }));
  };
  const unb64u = (s: string) => Uint8Array.from(atob(s.replace(/-/g, '+').replace(/_/g, '/')), (c) => c.charCodeAt(0));
  const b64u = (b: Uint8Array) => btoa(Array.from(b, (x) => String.fromCharCode(x)).join('')).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
  const unpack = async (s: string) => new Response(new Blob([unb64u(s)]).stream().pipeThrough(new DecompressionStream('deflate-raw'))).text();
  const pack = async (t: string) => b64u(new Uint8Array(await new Response(new Blob([t]).stream().pipeThrough(new CompressionStream('deflate-raw'))).arrayBuffer()));

  // a box holds JSON or a link with #s=…; a dropped PNG is read for its stamp and its JSON put in the box
  async function read(text: string) {
    const t = text.trim();
    const m = /#s=([\w-]+)/.exec(t);
    const d = JSON.parse(m ? await unpack(m[1]) : t);
    if (Array.isArray(d?.pages)) return d.pages[d.page | 0];
    return d;
  }
  for (const k of ['a', 'b']) {
    const ta = $<HTMLTextAreaElement>(`hd-${k}`);
    ta.addEventListener('dragover', (e) => e.preventDefault());
    ta.addEventListener('drop', async (e) => {
      const f = e.dataTransfer?.files?.[0]; if (!f) return; e.preventDefault();
      const st = readStamp(new Uint8Array(await f.arrayBuffer()));
      if (!st) { say(`${f.name} carries no Levni scene.`); return; }
      ta.value = JSON.stringify(st.scene, null, 2); say(`Read the scene inside ${f.name}.`);
    });
  }

  const fmt = (v: unknown) => v === undefined ? '—' : typeof v === 'object' ? JSON.stringify(v).slice(0, 60) : String(v);
  let A: any = null, B: any = null;
  async function run() {
    try { A = await read($<HTMLTextAreaElement>('hd-a').value); B = await read($<HTMLTextAreaElement>('hd-b').value); }
    catch (e) { say(`Could not read one of the boxes: ${(e as Error).message}`); return; }
    say('Drawing both…');
    await ensure(A); await ensure(B);
    // compare the finished pictures: motion and camera are dropped, so entrances show their settled state
    const still = (sc: any) => ({ ...sc, t: 0, camera: undefined, elements: (sc.elements || []).map(({ motion, ...e }: any) => e) });
    const [ca, cb] = await Promise.all([toCanvas((await compose(still(A))).svg), toCanvas((await compose(still(B))).svg)]);
    for (const [c, ids] of [[ca, ['hd-ia', 'hd-sa']], [cb, ['hd-ib', 'hd-sb']]] as const) { const u = c.toDataURL('image/png'); ids.forEach((id) => ($<HTMLImageElement>(id).src = u)); }
    // changed pixels: B in pale grey, every pixel that differs from A in red
    const W = cb.width, H = cb.height, px = $<HTMLCanvasElement>('hd-px'); px.width = W; px.height = H;
    const g = px.getContext('2d')!;
    const a2 = document.createElement('canvas'); a2.width = W; a2.height = H; a2.getContext('2d')!.drawImage(ca, 0, 0, W, H);
    const da = a2.getContext('2d')!.getImageData(0, 0, W, H).data, db = cb.getContext('2d')!.getImageData(0, 0, W, H).data;
    const out = g.createImageData(W, H); let n = 0;
    for (let i = 0; i < da.length; i += 4) {
      const diff = Math.abs(da[i] - db[i]) + Math.abs(da[i + 1] - db[i + 1]) + Math.abs(da[i + 2] - db[i + 2]);
      const l = 0.3 * db[i] + 0.59 * db[i + 1] + 0.11 * db[i + 2];
      if (diff > 60) { out.data[i] = 255; out.data[i + 1] = 58; out.data[i + 2] = 68; n++; } else { const v = 200 + l * 0.2; out.data[i] = out.data[i + 1] = out.data[i + 2] = v; }
      out.data[i + 3] = 255;
    }
    g.putImageData(out, 0, 0);
    $('hd-pxn').textContent = `${Math.round((n / (W * H)) * 1000) / 10}% of the picture changed.`;
    // field by field
    const d = sceneDiff(A, B);
    const rows: HTMLElement[] = [];
    for (const c of d.scene) rows.push(Object.assign(document.createElement('li'), { className: 'ch', textContent: `scene ${c.key}: ${fmt(c.from)} → ${fmt(c.to)}` }));
    for (const r of d.elements.filter((x: any) => x.status !== 'same')) {
      const li = document.createElement('li'); li.className = r.status === 'added' ? 'ad' : r.status === 'removed' ? 'rm' : 'ch';
      li.textContent = `${r.status} ${r.type}${r.label ? ` ${r.label}` : ''}${r.changes.length ? `: ${r.changes.map((c: any) => `${c.key} ${fmt(c.from)} → ${fmt(c.to)}`).join(', ')}` : ''}`;
      rows.push(li);
    }
    if (!rows.length) rows.push(Object.assign(document.createElement('li'), { textContent: 'The two scenes are the same.' }));
    $('hd-list').replaceChildren(...rows);
    const chain = (B.credits || []).map((c: any) => Object.assign(document.createElement('li'), { textContent: `${c.at || ''} ${c.by ? c.by : 'started'}${c.from ? ` from ${c.from}` : ''}` }));
    $('hd-chain').replaceChildren(...(chain.length ? chain : [Object.assign(document.createElement('li'), { textContent: 'No remix chain yet. Fork it in the Pen to start one.' })]));
    $('hd-out').hidden = false;
    say(`${d.summary.changed} changed, ${d.summary.added} added, ${d.summary.removed} removed${d.summary.scene ? `, ${d.summary.scene} scene fields` : ''}.`);
    history.replaceState(null, '', `#a=${await pack(JSON.stringify(A))}&b=${await pack(JSON.stringify(B))}`);
  }
  $('hd-run').addEventListener('click', run);
  $('hd-sample').addEventListener('click', async () => {
    const item = (gallery as any).items.find((i: any) => i.group === 'motion' && i.id === '20-logo-sting');
    const base: any = await (await fetch(`/g/motion/${item.id}.json`)).json();
    const after = structuredClone(base);
    after.elements = after.elements.map((e: any) => e.type === 'prop' ? { ...e, name: 'rocket' } : e.type === 'type' && e.size === 90 ? { ...e, text: 'Lale & Co' } : e);
    after.credits = [{ at: '2026-11-28', from: 'levni.dev/gallery' }, { at: '2026-11-28', by: 'Ada' }];
    $<HTMLTextAreaElement>('hd-a').value = JSON.stringify(base, null, 2); $<HTMLTextAreaElement>('hd-b').value = JSON.stringify(after, null, 2);
    run();
  });
  document.querySelector('.hd-tabs')!.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button'); if (!b) return;
    document.querySelectorAll('.hd-tabs button').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
    document.querySelectorAll<HTMLElement>('.hd-view').forEach((v) => (v.hidden = v.dataset.v !== b.dataset.v));
  });
  $<HTMLInputElement>('hd-pos').addEventListener('input', (e) => ($('hd-top').style.clipPath = `inset(0 0 0 ${(e.target as HTMLInputElement).value}%)`));
  (async () => {
    const h = new URLSearchParams(location.hash.slice(1));
    if (h.get('a') && h.get('b')) { try { $<HTMLTextAreaElement>('hd-a').value = JSON.stringify(JSON.parse(await unpack(h.get('a')!)), null, 2); $<HTMLTextAreaElement>('hd-b').value = JSON.stringify(JSON.parse(await unpack(h.get('b')!)), null, 2); run(); } catch {} }
  })();
</script>

<style>
  .hd h1 { max-width: 14ch; }
  .hd .lede { max-width: 64ch; }
  .hd-in { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-top: 28px; }
  .hd-box { display: grid; gap: 6px; font: 600 12px/1 var(--mono); letter-spacing: .06em; text-transform: uppercase; }
  .hd-box textarea { min-height: 180px; resize: vertical; font: 12px/1.5 var(--mono); padding: 12px; border: 0; box-shadow: 0 0 0 1px var(--rule); background: #fff; color: var(--ink); text-transform: none; letter-spacing: 0; }
  .hd-box textarea:focus-visible, .hd-go:focus-visible, .hd-ghost:focus-visible, .hd-tabs button:focus-visible { outline: 3px solid var(--lime); outline-offset: 2px; }
  .hd-actions { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin: 14px 0 24px; }
  .hd-go, .hd-ghost, .hd-tabs button { font: 600 12px/1 var(--mono); letter-spacing: .05em; text-transform: uppercase; padding: 12px 16px; border: 0; cursor: pointer; }
  .hd-go { background: var(--indigo); color: #fff; }
  .hd-ghost { background: #fff; color: var(--ink); box-shadow: 0 0 0 2px var(--ink); }
  #hd-status { color: var(--ink-soft); }
  .hd-tabs { display: flex; gap: 8px; margin-bottom: 12px; flex-wrap: wrap; }
  .hd-tabs button { background: #fff; color: var(--ink); box-shadow: 0 0 0 1px var(--rule); }
  .hd-tabs button[aria-selected='true'] { box-shadow: 0 0 0 2px var(--indigo); }
  .hd-view[data-v='side'] { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .hd-view[hidden] { display: none; }
  .hd-view figure { margin: 0; background: #fff; padding: 8px; box-shadow: 0 0 0 1px var(--rule); }
  .hd-view img, .hd-view canvas { display: block; width: 100%; height: auto; }
  .hd-view figcaption { font: 600 11px/1 var(--mono); text-transform: uppercase; letter-spacing: .06em; padding-top: 8px; }
  .hd-slide { position: relative; background: #fff; padding: 8px; box-shadow: 0 0 0 1px var(--rule); }
  .hd-top { position: absolute; inset: 8px; clip-path: inset(0 0 0 50%); }
  .hd-top img { width: 100%; height: auto; }
  #hd-pos { width: 100%; margin-top: 10px; accent-color: var(--indigo); }
  .hd-small { color: var(--ink-soft); font-size: 14px; }
  .hd-cols { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 24px; margin: 28px 0 64px; }
  .hd-cols h2 { font-size: 1.3rem; margin: 0 0 10px; }
  .hd-list, .hd-chain { margin: 0; padding-left: 20px; font: 13px/1.6 var(--mono); }
  /* the change rows are built in the browser */
  .hd-list :global(li) { padding: 2px 0; }
  .hd-list :global(.ad) { color: #1E783F; } .hd-list :global(.rm) { color: #C0392B; } .hd-list :global(.ch) { color: var(--ink); }
  @media (max-width: 760px) { .hd-in, .hd-view[data-v='side'], .hd-cols { grid-template-columns: minmax(0, 1fr); } }
</style>
