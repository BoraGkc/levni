---
import Base from '../layouts/Base.astro';
import Editor from '../components/Editor.astro';
import { SITE } from '../site';

const jsonld = [
  { '@type': 'WebApplication', name: 'Levni editor', applicationCategory: 'DesignApplication', operatingSystem: 'Any (web browser)', url: `${SITE.url}/editor/`, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, publisher: { '@id': `${SITE.ortakAlan}/#organization` } },
];
---
<Base og="/og/editor.png" title="Levni editor: design with hand-inked drawings in your browser" description="A free design editor in your browser: drag 1,600 hand-inked drawings, shapes and type onto a canvas, turn them into 3D icons or ASCII art, arrange layers, and download PNG or SVG. No sign-up." jsonld={jsonld}>
  <Editor />
</Base>
