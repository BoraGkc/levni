  .new { background: rgba(255, 255, 255, 0.08); border: 0; color: var(--on-indigo); }
  .tiles img { background: #fff; border: 0; clip-path: polygon(0 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%); }
  .card { border: 0; background: #fff; clip-path: polygon(0 0, 100% 0, 100% calc(100% - 14px), calc(100% - 14px) 100%, 0 100%); }
