  .text-link { font-weight: 600; }
  @media (max-width: 860px) {
    .feature { grid-template-columns: minmax(0, 1fr); gap: 20px; margin-top: 56px; }
    .feature.flip .text { order: 0; }
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 480px) { .cards { grid-template-columns: minmax(0, 1fr); } .imgs.n2 { grid-template-columns: 1fr; } }
  .try-link { font-weight: 700; }

  /* rebrand: numbered kickers, ticket fields, indigo bands on every other feature */
  .num { font-family: var(--mono); font-size: 0.74rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--coral-deep); margin: 0 0 10px; }
  .feature h2 { color: var(--indigo); letter-spacing: -0.04em; }
  .fields code { background: #fff; border: 0; border-left: 3px solid var(--red); color: var(--indigo); padding: 9px 12px; }
  .links a { font-family: var(--mono); font-size: 0.76rem; font-weight: 500; letter-spacing: 0.05em; text-transform: uppercase; text-decoration: none; }
  .links a::after { content: ' →'; }
  .links a:hover { text-decoration: underline; }
  .feature.band { background: var(--indigo); box-shadow: 0 0 0 100vmax var(--indigo); clip-path: inset(0 -100vmax); padding-block: clamp(48px, 6vw, 80px); }
