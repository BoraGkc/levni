---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';
import folio from '../data/props.json';

const pixelCount = folio.filter((p) => p.name.startsWith('pixel-')).length;

const doc = (p) => `${SITE.github}/blob/main/${p}`;
const tiles = ['rocket', 'tulip', 'coffee-cup', 'bicycle', 'lighthouse', 'piggy-bank', 'camera', 'globe'];
const features = [
  { id: 'scenes', title: 'Scenes and the critic', gallery: 'covers', img: ['/gallery/cover-riso.webp', '/g/covers/cover-miniature-s.webp', '/g/covers/mix-riso-s.webp'], alt: ['A rocket before a sun on a blue panel, a faceless audience below', 'The same cover in the miniature pack', 'A rocket on a coral sun among a cat, a bulb, headphones and a bicycle'],
    text: 'A scene is a short JSON file: panels, props, textures and labels on a 1200 × 673 canvas, 55 element types in all. Levni inks every line with a pressure brush, prints each colour from a slightly misaligned riso plate and adds paper grain. Same seed, same picture. Every render returns the critic’s notes: elements off the canvas, accidental crops, lopsided weight, no focal point.',
    link: [doc('docs/scene.md'), 'Scene reference'] },
  { id: 'styles', title: 'Style packs and your own inks', gallery: 'covers', img: ['/gallery/spot-riso.webp', '/gallery/spot-miniature.webp'], alt: ['Books, a cup and a bulb in riso colours', 'The same drawing in miniature colours'],
    text: 'The same scene, printed with other inks. riso is Ortak Alan’s house look; miniature is inspired by Tulip Era painting. Pass your own colour map and every drawing in the library follows your brand.',
    link: ['/blog/style-packs/', 'About style packs'] },
  { id: 'soft', title: 'Soft 3D covers', gallery: 'soft3d', img: ['/features/soft3d-auto-aqua.webp', '/features/soft3d-auto-night.webp', '/g/soft3d/preset-mobius-s.webp'], alt: ['A glossy teal-to-indigo 3D ribbon looping off the edge of a pale blue cover, a title on the left', 'Interlocking mint 3D rings on a deep purple cover', 'A glossy Möbius band in peach and violet on a warm cover'],
    text: 'A real little 3D renderer in plain JavaScript: glossy ribbons that loop, twist and pass behind themselves, Möbius strips, interlocking rings, spheres, capsules, blobs and stacked blocks, lit with a key light, soft highlights and film grain. "preset": "auto" with a seed composes a whole cover: a different, balanced layout per seed, room for a title, a free corner for your logo.',
    link: [doc('docs/scene.md#soft-3d-v2-real-3d-shapes-use-with-finish-soft'), 'Soft 3D reference'] },
  { id: 'icons3d', title: 'Every drawing as a 3D icon', gallery: 'icons', img: ['/features/soft3d-icons.webp', '/g/icons/30-turkish-coffee-cup-s.webp', '/g/icons/08-piggy-bank-s.webp'], alt: ['Library drawings extruded into thick, lit 3D icons: a rocket, a bulb, a cup, a trophy and a heart', 'A Turkish coffee cup on its saucer as a 3D icon', 'A piggy bank as a 3D icon, recoloured'],
    text: 'extrude3d turns any of the 1,600+ library drawings into a thick, lit 3D icon: front faces keep their colours, sides are rounded and shaded, ink lines become a raised rim. Rotate it, recolour it, put several in one scene.',
    link: [doc('docs/scene.md#soft-3d-v2-real-3d-shapes-use-with-finish-soft'), 'The extrude3d element'] },
  { id: 'pixel', title: 'Pixel icons', gallery: 'pixel', img: ['/g/pixel/grid-riso-s.webp', '/g/pixel/grid-brand-s.webp'], alt: ['Twenty-one pixel icons in riso colours on paper', 'The same pixel icons in purple and teal brand inks'],
    text: `${pixelCount} pixel icons in four weights (regular, thin, solid, glyph): mail, charts, weather, files, arrows, people and more. They are Folio props like any other, so they sit in scenes, recolour with style packs and your inks, and work as 3D icons.`,
    link: ['/library/?q=pixel', 'Pixel icons in the Library'] },
  { id: 'iso', title: 'Little 3D worlds', gallery: 'worlds', img: ['/features/iso-cafe.webp', '/features/iso-city.webp', '/g/worlds/city-soft-s.webp'], alt: ['An isometric cafe diorama with a counter, tables, people and a window throwing sunlight', 'A floating island city with houses, towers, roads and trees', 'The city preset in the smooth soft style and pastel colours'],
    text: 'Isometric dioramas on a floating slab or island. One line lays out a whole seeded world: "preset": "room", "desk", "street", "city", "cafe", "office" or "classroom". Stairs, roofs, arches, fences, ponds, roads, trees, furniture, faceless people and pictures hung on the walls, with soft contact shadows. Hand-inked, or "style": "soft" for a clean toy look.',
    link: [doc('docs/scene.md#little-3d-worlds-iso'), 'Little 3D worlds reference'] },
  { id: 'people', title: 'Faceless people', gallery: 'covers', img: ['/features/people.webp'], alt: ['Pictogram people walking, cheering and handing over an object, no faces'],
    text: 'person draws a full-body pictogram in 15 poses: walking, running, sitting, pointing, reading, on the phone, cheering and more, holding any library object. people draws a row. Round heads with nothing on them, by design.',
    link: [doc('docs/scene.md'), 'person and people'] },
  { id: 'slots', title: 'Fusion slots', gallery: 'covers', img: ['/features/slots-lens.webp', '/features/slots-tv.webp'], alt: ['A tulip inside a magnifier lens, a star on a trophy', 'A chart drawn inside the screen of an old TV'],
    text: 'Props name the places where something else belongs: a TV’s screen, a magnifier’s lens, a trophy’s top. Put any drawing there with "in": { "prop": "magnifier", "slot": "lens" } and it is scaled, centred and rotated with its host. 64 hosts have slots.',
    link: [doc('docs/scene.md#slots-fusion'), 'How slots work'] },
  { id: 'charts', title: 'Hand-inked data', gallery: 'charts', img: ['/features/chart-inflation.webp', '/g/charts/donut-s.webp', '/g/charts/pie-blue-s.webp'], alt: ['A hand-drawn bar chart with one coral bar, a small line chart and a donut, labelled as sample data', 'A large hand-inked donut chart with one slice pulled out', 'A hand-inked pie chart on a blue panel'],
    text: 'bars, linechart, pie, donut and isochart take plain numbers and draw them with the same wobbly ink and flat riso fills. Values print only when you ask, and only from your data.',
    link: [doc('docs/scene.md'), 'Data charts'] },
  { id: 'formats', title: 'Every format, plus a title', gallery: 'formats', img: ['/g/formats/all.webp'], alt: ['One scene as a tall story, an Open Graph card, a square post and a YouTube thumbnail, each with the same headline'],
    text: 'Render one scene as a cover, Open Graph card, square, story or YouTube thumbnail. Levni recomposes rather than crops: grounds stretch, objects move together into the free space. An optional title layer sets a crisp headline, kicker and brand line.',
    link: [doc('docs/scene.md#formats-and-reflow'), 'Formats and titles'] },
  { id: 'sensitive', title: 'Calm images for hard news', img: ['/features/sensitive.webp', '/g/worlds/street-blue-s.webp'], alt: ['A memorial candle and a single flower in quiet blues', 'An isometric street in blues only'],
    text: 'A pack of dignified drawings for loss, disaster, illness, courts and grief: memorial candles, an empty chair, a closed door with light under it, a dove. One object, lots of space, blue only.',
    link: [doc('docs/sensitive.md'), 'Illustrating sensitive stories'] },
];
const tools = [
  ['MCP server', 'Claude, Cursor and any MCP client search the library, render scenes and read the critic.', '/mcp/'],
  ['Ghost', 'Find drafts without images, preview a cover and inline images, attach them after your OK.', '/mcp/#ghost'],
  ['CLI', 'levni render, sheet, list, add, check, judge and ghost from any terminal or CI job.', SITE.github],
  ['Judge', 'Optional: rate renders against a brief with your own model key, scoring twice to beat position bias.', doc('docs/judge.md')],
];
const jsonld = [{ '@type': 'SoftwareApplication', name: 'Levni', applicationCategory: 'DesignApplication', operatingSystem: 'macOS, Linux, Windows (Node.js 20+)', url: `${SITE.url}/features/`, featureList: features.map((f) => f.title).concat(tools.map((t) => t[0])), offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, publisher: { '@id': `${SITE.ortakAlan}/#organization` } }];
---
<Base title="Features" description="Everything Levni draws: a 1,600-drawing library, style packs and custom inks, soft 3D covers and 3D icons, isometric worlds, pixel icons, faceless people, fusion slots, hand-inked charts, every social format, and MCP and Ghost tools for agents." jsonld={jsonld}>
  <div class="wrap page">
    <p class="eyebrow">Features</p>
    <h1>Everything Levni <em class="accent">draws</em>.</h1>
    <p class="lede">An open illustration library and the engine that draws it: JSON in, a hand-inked image out, free and on your own machine.</p>
    <nav class="toc" aria-label="On this page">
      <a href="#library">Library</a>{features.map((f) => <a href={`#${f.id}`}>{f.title}</a>)}<a href="#agents">Agents and tools</a>
    </nav>

    <section id="library" class="feature">
      <div class="text">
        <h2>The Levni Folio</h2>
        <p>{SITE.props.toLocaleString('en')} drawings and {SITE.variants.toLocaleString('en')} variants, from tulips to server racks, sorted on shelves and searchable in English and Turkish. Each is SVG path data in a 0–100 box, released under CC BY 4.0, open to contributions.</p>
        <p><a class="text-link" href="/library/">Browse the library</a> · <a class="text-link" href="/gallery/">See the gallery</a> · <a class="text-link" href={doc('CONTRIBUTING.md')}>Submit to the Folio</a></p>
      </div>
      <div class="tiles">{tiles.map((t) => <img src={`/props/${t}-0.webp`} alt={t.replace(/-/g, ' ')} width="120" height="120" loading="lazy" />)}</div>
    </section>

    {features.map((f, i) => (
      <section id={f.id} class={`feature ${i % 2 ? 'flip' : ''}`}>
        <div class="text">
          <h2>{f.title}</h2>
          <p>{f.text}</p>
          <p class="links"><a class="text-link" href={f.link[0]}>{f.link[1]}</a>{f.gallery && <a class="text-link" href={`/gallery/#${f.gallery}`}>See them in the gallery</a>}</p>
        </div>
        <div class={`imgs n${f.img.length}`}>{f.img.map((src, k) => <img class="tezhip" src={src} alt={f.alt[k]} width={src.includes('/g/icons/') ? 400 : 800} height={src.includes('/g/icons/') ? 400 : 449} loading="lazy" decoding="async" />)}</div>
      </section>
    ))}

    <section id="agents" class="agents">
      <h2>Agents and tools</h2>
      <div class="cards">{tools.map(([t, d, href]) => (<a class="card" href={href}><h3>{t}</h3><p>{d}</p></a>))}</div>
    </section>
  </div>
</Base>

<style>
  .page { margin-top: 48px; }
  .eyebrow { font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent-text); margin: 0 0 12px; }
  .lede { font-size: 1.22rem; color: var(--ink-soft); max-width: 720px; }
  .toc { display: flex; flex-wrap: wrap; gap: 8px; margin: 24px 0 8px; }
  .toc a { font-size: 0.92rem; text-decoration: none; color: var(--ink); border: 1px solid var(--rule); border-radius: 999px; padding: 6px 12px; background: var(--paper-2); }
  .toc a:hover { border-color: var(--ink); color: var(--ink); }
  .feature { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 40px; align-items: center; margin-top: 72px; }
  .feature.flip .text { order: 2; }
  .feature h2 { font-size: clamp(1.8rem, 4vw, 2.5rem); }
  .feature p { color: var(--ink-soft); }
  .imgs { display: grid; gap: 14px; }
  .imgs.n2, .imgs.n3 { grid-template-columns: 1fr 1fr; align-items: start; }
  .imgs.n3 img:first-child { grid-column: 1 / -1; }
  .links { display: flex; flex-wrap: wrap; gap: 4px 20px; }
  .imgs img { width: 100%; padding: 5px; }
  .tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  .tiles img { width: 100%; background: var(--paper-2); border: 1px solid var(--rule); border-radius: 12px; }
  .agents { margin-top: 80px; }
  .cards { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-top: 20px; }
  .card { display: block; text-decoration: none; color: var(--ink); border: 2px solid var(--ink); background: var(--paper-2); padding: 18px; box-shadow: 5px 5px 0 var(--accent); }
  .card:hover { color: var(--ink); transform: translate(-1px, -1px); }
  .card h3 { font-size: 1.3rem; }
  .card p { margin: 0; color: var(--ink-soft); font-size: 0.96rem; }
  .text-link { font-weight: 600; }
  @media (max-width: 860px) {
    .feature { grid-template-columns: minmax(0, 1fr); gap: 20px; margin-top: 56px; }
    .feature.flip .text { order: 0; }
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 480px) { .cards { grid-template-columns: minmax(0, 1fr); } .imgs.n2 { grid-template-columns: 1fr; } }
</style>
