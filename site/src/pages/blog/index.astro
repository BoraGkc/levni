---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title="Blog" description="Notes on Levni: drawing illustrations from JSON scenes, style packs, the Levni Folio and illustration for AI agents.">
  <section class="wrap blog-index">
    <h1>Blog</h1>
    <ul>
      {posts.map((p) => (
        <li>
          <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
          <h2><a href={`/blog/${p.id}/`}>{p.data.title}</a></h2>
          <p>{p.data.description}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .blog-index { max-width: 780px; margin-top: 48px; }
  ul { list-style: none; padding: 0; }
  li { padding: 18px 0; border-bottom: 1px solid var(--gold); }
  h2 { font-size: 1.8rem; margin: 4px 0; }
  h2 a { color: var(--ink); text-decoration: none; }
  h2 a:hover { color: var(--vermilion); }
  time { font-family: var(--mono); font-size: 0.8rem; color: var(--turquoise); }
  p { margin: 0; color: var(--ink-soft); }
</style>
