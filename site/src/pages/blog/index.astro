---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, type Category } from '../../blog';

// newest first; on the same day a Story (a release post) leads its guides
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => +b.data.date - +a.data.date || Number(b.data.kind === 'Story') - Number(a.data.kind === 'Story'));
// the newest post leads, the next six follow as "Latest"; feature guides (frontmatter `featured: true`) not shown yet come after
const lead = posts[0];
const latest = posts.slice(1, 7);
const guides = posts.filter((p) => p.data.featured && p !== lead && !latest.includes(p));
const shelves = (Object.keys(CATEGORIES) as Category[])
  .map((key) => ({ key, ...CATEGORIES[key], posts: posts.filter((p) => p.data.category === key) }))
  .filter((s) => s.posts.length > 0);
---
<Base title="Blog" description="Guides on illustrating articles with AI agents: covers, social cards, icons and brand-coloured art drawn from JSON scenes with Levni and its MCP server.">
  <section class="wrap head">
    <p class="eyebrow">Levni blog</p>
    <h1>Illustration for agents and publishers</h1>
    <p class="lede">Guides for drawing covers, icons, stickers, brand assets and whole brand boards from JSON, with Claude, Codex or by hand. Every image on these pages was drawn by Levni.</p>
    <nav class="shelves" aria-label="Categories">
      {shelves.map((s) => <a href={`/blog/category/${s.key}/`}>{s.label} <small>{s.posts.length}</small></a>)}
    </nav>
  </section>

  {lead && (
    <section class="wrap featured" aria-labelledby="latest-title">
      <h2 id="latest-title" class="block-title">Latest</h2>
      <PostCard post={lead} big />
      {latest.length > 0 && <div class="cards">{latest.map((p) => <PostCard post={p} />)}</div>}
    </section>
  )}

  {guides.length > 0 && (
    <section class="wrap latest" aria-labelledby="guides-title">
      <h2 id="guides-title">Feature guides</h2>
      <div class="cards">{guides.slice(0, 6).map((p) => <PostCard post={p} />)}</div>
    </section>
  )}

  {shelves.map((s) => (
    <section class="wrap shelf" aria-labelledby={`shelf-${s.key}`}>
      <div class="shelf-head">
        <div>
          <h2 id={`shelf-${s.key}`}>{s.label}</h2>
          <p>{s.blurb}</p>
        </div>
        <a href={`/blog/category/${s.key}/`}>All →</a>
      </div>
      <ul>
        {s.posts.slice(0, 4).map((p) => (
          <li><a href={`/blog/${p.id}/`}><span class="k">{p.data.kind}</span>{p.data.title}</a></li>
        ))}
      </ul>
    </section>
  ))}
</Base>

<style>
  .head { margin-top: 48px; }
  .eyebrow { font-family: var(--mono); font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent-text); margin: 0 0 12px; }
  h1 { max-width: 18ch; }
  .lede { font-size: 1.2rem; color: var(--ink-soft); max-width: 680px; }
  .shelves { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .shelves a { text-decoration: none; color: var(--ink); border: 1.5px solid var(--rule); background: var(--paper-2); padding: 6px 14px; border-radius: 999px; font-size: 0.95rem; }
  .shelves a:hover { border-color: var(--ink); }
  .shelves small { font-family: var(--mono); color: var(--ink-soft); margin-left: 4px; }
  .featured { margin-top: 36px; }
  .block-title { margin: 0 0 20px; }
  .featured > :global(.card.big) { display: grid; grid-template-columns: 1.4fr 1fr; gap: 10px; }
  .featured .cards { margin-top: 24px; }
  .latest { margin-top: 64px; }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-top: 20px; }
  .shelf { margin-top: 64px; }
  .shelf-head { display: flex; justify-content: space-between; align-items: end; gap: 16px; border-bottom: 2px solid var(--ink); padding-bottom: 10px; }
  .shelf-head h2 { margin: 0; }
  .shelf-head p { margin: 4px 0 0; color: var(--ink-soft); }
  .shelf ul { list-style: none; padding: 0; margin: 0; }
  .shelf li { border-bottom: 1px solid var(--rule); }
  .shelf li a { display: block; padding: 14px 0; color: var(--ink); text-decoration: none; font-family: var(--display); font-size: 1.3rem; }
  .shelf li a:hover { color: var(--accent-text); }
  .k { font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent-text); margin-right: 12px; vertical-align: 3px; }
  @media (max-width: 900px) {
    .featured > :global(.card.big) { display: flex; }
    .cards { grid-template-columns: minmax(0, 1fr); }
  }
</style>
