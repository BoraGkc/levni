---
import Base from '../layouts/Base.astro';
import { RELEASES } from '../data/changelog';
import { SITE } from '../site';
const fmt = (d: string) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const id = (v: string) => `v${v}`;
---
<Base og="/og/changelog.png" title="Changelog" description="What changed in each Levni release: elements, commands, MCP tools and site changes, with links to the guides." jsonld={[]}>
  <div class="wrap cl">
    <header class="cl-head brand-hero no-art">
      <h1>Changelog</h1>
      <p>Every release of Levni, newest first. The published npm version is 0.2.0; the repository is at {SITE.version}.0.</p>
      <ul class="jump" aria-label="Versions">
        {RELEASES.map((r) => <li><a href={`#${id(r.version)}`}>v{r.version}</a></li>)}
      </ul>
    </header>
    {RELEASES.map((r) => (
      <article class="rel" id={id(r.version)} aria-labelledby={`h-${id(r.version)}`}>
        <div class="rel-meta">
          <p class="ver">v{r.version}</p>
          <time datetime={r.date}>{fmt(r.date)}</time>
        </div>
        <div class="rel-body">
          <h2 id={`h-${id(r.version)}`}><a href={`#${id(r.version)}`}>{r.title}</a></h2>
          <p class="sum">{r.summary}</p>
          {r.note && <p class="note">{r.note}</p>}
          <ul>
            {r.items.map((i) => (
              <li>{i.text}{i.links?.map((l) => <> <a href={l.href}>{l.text}</a></>)}</li>
            ))}
          </ul>
          {r.posts && <p class="posts">Read: {r.posts.map((p, n) => <>{n > 0 && ', '}<a href={p.href}>{p.text}</a></>)}</p>}
        </div>
      </article>
    ))}
    <p class="cl-foot">Older history lives in <a href={`${SITE.github}/commits/main`}>the git log</a>.</p>
  </div>
</Base>

<style>
  .cl { padding-top: 0; max-width: 860px; }
  .cl-head p { color: var(--ink-soft); max-width: 60ch; }
  .jump { list-style: none; padding: 0; margin: 16px 0 0; display: flex; gap: 8px; flex-wrap: wrap; }
  .jump a { display: inline-block; font-family: var(--mono); font-size: 0.85rem; border: 1.5px solid var(--indigo); padding: 4px 10px; text-decoration: none; color: var(--ink); }
  .jump a:hover { background: var(--mustard); }
  .rel { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 8px 32px; padding: 32px 0; border-top: 1px solid var(--rule); margin-top: 32px; scroll-margin-top: 16px; }
  .rel-meta .ver { font-family: var(--display); font-style: normal; font-size: 2rem; margin: 0; line-height: 1; }
  .rel-meta time { font-family: var(--mono); font-size: 0.82rem; color: var(--ink-soft); }
  .rel-body h2 { font-size: clamp(1.5rem, 3vw, 2rem); margin-bottom: 0.25em; }
  .rel-body h2 a { color: inherit; text-decoration: none; }
  .rel-body h2 a:hover { text-decoration: underline; }
  .sum { margin: 0 0 12px; }
  .note { background: var(--paper-2); border: 1.5px solid var(--indigo); border-left: 6px solid var(--mustard); padding: 10px 14px; font-size: 0.95rem; margin: 0 0 12px; }
  .rel-body ul { padding-left: 1.1em; margin: 0 0 12px; }
  .rel-body li { margin: 6px 0; }
  .posts { font-family: var(--mono); font-size: 0.85rem; color: var(--ink-soft); margin: 0; }
  .cl-foot { color: var(--ink-soft); font-size: 0.95rem; border-top: 1px solid var(--rule); padding-top: 16px; }
  @media (max-width: 640px) { .rel { grid-template-columns: 1fr; } .cl { padding-top: 32px; } }
  .cl-head.brand-hero p { color: var(--mute-indigo); }
  .cl-head.brand-hero .jump a { color: var(--on-indigo); border-color: rgba(255, 255, 255, 0.32); background: transparent; }
  .cl-head.brand-hero .jump a:hover { background: var(--lime); color: var(--indigo); }
</style>
