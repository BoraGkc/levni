---
// Design Router: one search over drawings, fonts, palettes, patterns, motion and shots, with licences, paste-ready
// snippets and previews drawn in your colours, all in this browser (src/router.mjs). Icons need the CLI or MCP.
import Base from '../layouts/Base.astro';

const examples = ['coffee', 'kedi', 'headline font', 'dots pattern', 'night palette', 'float', 'launch', 'music'];
const kinds = [['', 'Everything'], ['drawing', 'Drawings'], ['font', 'Fonts'], ['palette', 'Palettes'], ['pattern', 'Patterns'], ['motion', 'Motion'], ['shot', 'Shots']];
const faq = [
  { q: 'What does it search?', a: 'The 1,628 drawings of the Folio, the four open fonts Levni ships, its palettes, its pattern generators, every motion preset and the 25 shots. From the CLI and MCP it also searches the 5,000-odd Tabler icons, redrawn in the house style.' },
  { q: 'What do the licences mean?', a: 'Drawings are CC BY 4.0: use them anywhere, credit Levni (or the named artist). Drawings redrawn from Tabler Icons and the engine itself are MIT. The fonts are OFL 1.1. Palettes are CC0.' },
  { q: 'How do my colours work?', a: 'Pick up to three colours. They become Levni inks (blue, coral, mustard, then green), each with a light tone, and every preview is redrawn with them. Copy the style line into any scene to keep them.' },
  { q: 'Does anything leave my browser?', a: 'No. The search and the drawings run on this page; nothing is sent anywhere.' },
];
---
<Base title="Design Router: one search for open drawings, fonts, palettes and patterns" description="Search Levni's open drawings, fonts, palettes, pattern generators, motion presets and shots at once. Every result shows its licence and a snippet to paste, drawn in your own colours. Free, in your browser, and as the route_design MCP tool.">
  <div class="wrap dr">
    <header class="brand-hero">
      <p class="eyebrow">Design Router</p>
      <h1>One search for everything open.</h1>
      <p class="lede">Drawings, fonts, palettes, patterns, motion and ready-made shots, ranked together. Each result shows its licence and the line to paste into a scene, drawn in your colours. Your agent gets the same search as one MCP tool.</p>
    </header>

    <form class="dr-search" id="dr-form" role="search">
      <label for="dr-q" class="sr">What do you need?</label>
      <input id="dr-q" type="search" autocomplete="off" spellcheck="false" placeholder="coffee, headline font, dots pattern…" />
      <button type="submit" class="dr-btn">Search</button>
    </form>
    <p class="dr-try">Try: {examples.map((e) => <button type="button" class="dr-ex" data-q={e}>{e}</button>)}</p>

    <div class="dr-bar">
      <div class="dr-kinds" id="dr-kinds" role="group" aria-label="Kind">
        {kinds.map(([k, label], i) => <button type="button" data-kind={k} aria-pressed={i === 0 ? 'true' : 'false'}>{label}<span></span></button>)}
      </div>
      <div class="dr-colors" role="group" aria-label="Your colours">
        <span>Your colours</span>
        <input type="color" id="dr-c1" value="#E8522F" aria-label="First colour" />
        <input type="color" id="dr-c2" value="#1E1466" aria-label="Second colour" />
        <input type="color" id="dr-c3" value="#F2C230" aria-label="Third colour" />
        <label class="dr-use"><input type="checkbox" id="dr-use" /> use them</label>
      </div>
    </div>

    <p class="dr-status" id="dr-status" role="status" aria-live="polite">Loading the catalogue…</p>
    <ul class="dr-grid" id="dr-grid"></ul>
    <p class="dr-style" id="dr-style" hidden></p>

    <section class="dr-agent" aria-labelledby="dr-a">
      <div>
        <h2 id="dr-a">The same search for your agent</h2>
        <p>Add Levni to Claude, Codex or Cursor, then ask for “a coffee drawing in our brand colours”. The <code>route_design</code> tool answers with licences, snippets and a contact sheet, icons included.</p>
        <pre><code>claude mcp add levni -- npx -y @levni/levni mcp</code></pre>
      </div>
      <div>
        <h2>Or from the terminal</h2>
        <pre><code>npx @levni/levni route kahve --colors '#E8522F,#1E1466' --sheet sheet.png</code></pre>
        <p><a href="/docs/router/">Router guide →</a> · <a href="/commons/">What is still wanted →</a></p>
      </div>
    </section>

    <section class="dr-about">
      <h2>Questions</h2>
      <dl>{faq.map(({ q, a }) => (<><dt>{q}</dt><dd>{a}</dd></>))}</dl>
    </section>
  </div>
</Base>

<script>
  import { compose, registerProps, registerFont, fontsFor, propsFor, catalog, route, routeScene, inksFrom } from '../../../src/browser.mjs';

  const propFiles = import.meta.glob('../../../library/props/*.json', { import: 'default' });
  const fontUrls = import.meta.glob('../../../fonts/*.{ttf,otf}', { query: '?url', import: 'default', eager: true }) as Record<string, string>;
  const FONT_FILES: Record<string, string> = { grotesk: 'SpaceGrotesk-Variable.ttf', black: 'ArchivoBlack-Regular.ttf', mono: 'JetBrainsMono-Variable.ttf', pixel: 'DepartureMono-Regular.otf' };
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const q = $<HTMLInputElement>('dr-q'), grid = $('dr-grid'), status = $('dr-status');
  let cat: any[] = [], kind = '', token = 0;
  const fonts = new Set<string>(), props = new Set<string>();

  const ensure = async (sc: any) => {
    await Promise.all(fontsFor(sc).filter((n: string) => !fonts.has(n)).map(async (n: string) => {
      const u = Object.entries(fontUrls).find(([k]) => k.endsWith(FONT_FILES[n]))?.[1];
      if (u) { registerFont(n, await (await fetch(u)).arrayBuffer()); fonts.add(n); }
    }));
    await Promise.all(propsFor(sc).filter((n: string) => !props.has(n)).map(async (n: string) => {
      const l = propFiles[`../../../library/props/${n}.json`]; if (l) { registerProps(await l() as object); props.add(n); }
    }));
  };
  const colors = () => ($<HTMLInputElement>('dr-use').checked ? ['dr-c1', 'dr-c2', 'dr-c3'].map((id) => $<HTMLInputElement>(id).value) : undefined);
  const b64u = (b: Uint8Array) => btoa(Array.from(b, (x) => String.fromCharCode(x)).join('')).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
  const pack = async (t: string) => b64u(new Uint8Array(await new Response(new Blob([t]).stream().pipeThrough(new CompressionStream('deflate-raw'))).arrayBuffer()));
  const snippetText = (r: any) => JSON.stringify(r.snippet, null, 1).replace(/\n\s*/g, ' ');
  const LABEL: Record<string, string> = { drawing: 'Drawing', font: 'Font', palette: 'Palette', pattern: 'Pattern', motion: 'Motion', shot: 'Shot', icon: 'Icon' };

  // previews are drawn as SVG when a card scrolls into view
  const seen = new IntersectionObserver((entries) => entries.forEach((en) => { if (en.isIntersecting) { seen.unobserve(en.target); paint(en.target as HTMLElement); } }), { rootMargin: '200px' });
  async function paint(li: HTMLElement) {
    const r = (li as any)._r, my = token;
    const scene = routeScene(r, { colors: colors() });
    await ensure(scene);
    if (my !== token) return;
    const { svg } = await compose(scene);
    const img = li.querySelector('img')!;
    img.src = URL.createObjectURL(new Blob([svg], { type: 'image/svg+xml' }));
    img.onload = () => URL.revokeObjectURL(img.src);
    (li as any)._scene = scene;
  }
  function card(r: any) {
    const li = document.createElement('li'); li.className = 'dr-card'; (li as any)._r = r;
    li.innerHTML = `<div class="dr-pv"><img alt="" width="480" height="300" /></div>
      <div class="dr-body"><p class="dr-k">${LABEL[r.kind] || r.kind}</p><h3></h3><p class="dr-lic"></p>
      <code class="dr-snip"></code>
      <p class="dr-acts"><button type="button" class="dr-copy">Copy snippet</button><button type="button" class="dr-pen">Open in the Pen</button></p></div>`;
    li.querySelector('h3')!.textContent = r.name || r.title;
    li.querySelector('.dr-lic')!.textContent = `${r.license} · ${r.credit}`;
    li.querySelector('.dr-snip')!.textContent = snippetText(r);
    li.querySelector('img')!.alt = `${LABEL[r.kind]}: ${r.name || r.title}`;
    li.querySelector('.dr-copy')!.addEventListener('click', async (e) => { const b = e.currentTarget as HTMLElement; await navigator.clipboard.writeText(JSON.stringify(r.snippet, null, 2)); b.textContent = 'Copied'; setTimeout(() => (b.textContent = 'Copy snippet'), 1300); });
    li.querySelector('.dr-pen')!.addEventListener('click', async () => { const sc = (li as any)._scene || routeScene(r, { colors: colors() }); window.open(`/pen/#s=${await pack(JSON.stringify({ ...sc, credits: [{ from: `levni.dev/router/#${r.kind}:${r.id}`, at: new Date().toISOString().slice(0, 10) }] }))}`, '_blank'); });
    return li;
  }
  function run() {
    token++;
    const text = q.value.trim();
    const r = route(text || (kind ? '' : 'rocket'), cat, { kinds: kind ? [kind] : undefined, limit: 48 });
    // counts on the kind buttons, for this query across every kind
    const all = route(text || 'rocket', cat, { limit: 1 }).counts as Record<string, number>;
    document.querySelectorAll<HTMLElement>('#dr-kinds button').forEach((b) => { const k = b.dataset.kind!; const n = k ? all[k] || 0 : Object.values(all).reduce((a, x) => a + x, 0); b.querySelector('span')!.textContent = text ? ` ${n}` : ''; });
    grid.replaceChildren(...r.results.map(card));
    grid.querySelectorAll('li').forEach((li) => seen.observe(li));
    status.textContent = r.results.length ? (text ? `${r.results.length} result${r.results.length === 1 ? '' : 's'} for “${text}”${r.results.length === 48 ? ' (the first 48)' : ''}.` : 'A few to start with. Type what you need.') : `Nothing for “${text}”. Try a plainer word, or a kind word: font, palette, pattern, motion.`;
    const inks = inksFrom(colors());
    const st = $('dr-style'); st.hidden = !inks; if (inks) st.textContent = `Your inks, for any scene: "style": ${JSON.stringify(inks)}`;
    if (text) history.replaceState(null, '', `#q=${encodeURIComponent(text)}${kind ? `&kind=${kind}` : ''}`);
  }
  let t = 0;
  q.addEventListener('input', () => { clearTimeout(t); t = window.setTimeout(run, 160); });
  $('dr-form').addEventListener('submit', (e) => { e.preventDefault(); run(); });
  document.querySelectorAll<HTMLElement>('.dr-ex').forEach((b) => b.addEventListener('click', () => { q.value = b.dataset.q!; run(); }));
  $('dr-kinds').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button'); if (!b) return;
    kind = b.dataset.kind!; document.querySelectorAll('#dr-kinds button').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); run();
  });
  ['dr-c1', 'dr-c2', 'dr-c3'].forEach((id) => $(id).addEventListener('input', () => { $<HTMLInputElement>('dr-use').checked = true; clearTimeout(t); t = window.setTimeout(run, 200); }));
  $('dr-use').addEventListener('change', run);

  (async () => {
    const idx = await (await fetch('/props-index.json')).json();
    cat = catalog({ props: idx.map(([name, category, tags, variants, aliases, author]: any) => ({ name, category, tags, variants, aliases, author })) });
    const h = new URLSearchParams(location.hash.slice(1));
    if (h.get('q')) q.value = h.get('q')!;
    if (h.get('kind')) { kind = h.get('kind')!; document.querySelectorAll<HTMLElement>('#dr-kinds button').forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.kind === kind))); }
    run();
  })();
</script>

<style>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .dr-search { display: flex; gap: 10px; max-width: 860px; }
  .dr-search input { flex: 1; min-width: 0; font: 22px/1.2 var(--mono); padding: 16px 18px; border: 0; box-shadow: 0 0 0 2px var(--ink); background: #fff; color: var(--ink); }
  .dr-btn { font: 600 13px/1 var(--mono); letter-spacing: .05em; text-transform: uppercase; padding: 0 22px; border: 0; background: var(--indigo); color: #fff; cursor: pointer; }
  .dr-search input:focus-visible, .dr-btn:focus-visible, .dr-kinds button:focus-visible, .dr-ex:focus-visible, .dr-acts button:focus-visible { outline: 3px solid var(--lime); outline-offset: 2px; }
  .dr-try { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin: 12px 0 28px; color: var(--ink-soft); font-size: 14px; }
  .dr-ex { font: 13px/1 var(--mono); padding: 7px 10px; border: 0; background: none; color: var(--indigo); box-shadow: inset 0 -1px 0 currentColor; cursor: pointer; }
  .dr-bar { display: flex; justify-content: space-between; align-items: center; gap: 14px 24px; flex-wrap: wrap; padding: 14px 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .dr-kinds { display: flex; flex-wrap: wrap; gap: 6px; }
  .dr-kinds button { font: 600 12px/1 var(--mono); padding: 9px 11px; border: 0; background: #fff; color: var(--ink); box-shadow: 0 0 0 1px var(--rule); cursor: pointer; }
  .dr-kinds button span { color: var(--ink-soft); font-weight: 400; }
  .dr-kinds button[aria-pressed='true'] { box-shadow: 0 0 0 2px var(--indigo); background: var(--paper); }
  .dr-colors { display: flex; align-items: center; gap: 8px; font: 600 11px/1 var(--mono); letter-spacing: .05em; text-transform: uppercase; }
  .dr-colors input[type=color] { width: 34px; height: 34px; padding: 0; border: 0; background: none; cursor: pointer; }
  .dr-use { display: flex; align-items: center; gap: 6px; text-transform: none; letter-spacing: 0; font: 14px/1 var(--body, inherit); }
  .dr-status { color: var(--ink-soft); margin: 18px 0 14px; min-height: 1.4em; }
  .dr-grid { list-style: none; margin: 0 0 14px; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 270px), 1fr)); gap: 16px; }
  .dr-grid :global(.dr-card) { background: #fff; box-shadow: 0 0 0 1px var(--rule); display: flex; flex-direction: column; }
  .dr-grid :global(.dr-pv) { aspect-ratio: 8 / 5; background: var(--paper); border-bottom: 1px solid var(--rule); }
  .dr-grid :global(.dr-pv img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .dr-grid :global(.dr-body) { padding: 12px 14px 14px; display: flex; flex-direction: column; gap: 4px; flex: 1; }
  .dr-grid :global(.dr-k) { margin: 0; font: 600 11px/1 var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--accent-text, #C2410C); }
  .dr-grid :global(h3) { margin: 2px 0 0; font-size: 1.1rem; line-height: 1.2; }
  .dr-grid :global(h3::first-letter) { text-transform: uppercase; }
  .dr-grid :global(.dr-lic) { margin: 0; font-size: 13px; color: var(--ink-soft); }
  .dr-grid :global(.dr-snip) { display: block; margin-top: 6px; font: 11px/1.45 var(--mono); color: var(--ink); background: var(--paper); padding: 7px 8px; overflow-wrap: anywhere; }
  .dr-grid :global(.dr-acts) { margin: auto 0 0; padding-top: 10px; display: flex; gap: 6px; flex-wrap: wrap; }
  .dr-grid :global(.dr-acts button) { font: 600 11px/1 var(--mono); letter-spacing: .05em; text-transform: uppercase; padding: 9px 10px; border: 0; background: var(--paper); color: var(--ink); box-shadow: 0 0 0 1px var(--rule); cursor: pointer; }
  .dr-grid :global(.dr-acts button:hover) { box-shadow: 0 0 0 2px var(--ink); }
  .dr-style { font: 12px/1.5 var(--mono); background: #fff; box-shadow: 0 0 0 1px var(--rule); padding: 10px 12px; overflow-wrap: anywhere; }
  .dr-agent { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; margin: clamp(40px, 6vw, 64px) 0; }
  .dr-agent > div { background: #fff; box-shadow: 0 0 0 1px var(--rule); padding: clamp(18px, 3vw, 28px); }
  .dr-agent h2 { margin: 0 0 10px; font-size: 1.5rem; }
  .dr-agent pre { margin: 12px 0; padding: 12px; background: var(--indigo-deep); color: #fff; font: 13px/1.5 var(--mono); overflow-x: auto; }
  .dr-about { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: clamp(20px, 4vw, 56px); margin-bottom: clamp(48px, 7vw, 80px); }
  .dr-about h2 { margin: 0; }
  .dr-about dl { margin: 0; }
  .dr-about dt { font-weight: 700; margin-top: 14px; }
  .dr-about dt:first-child { margin-top: 0; }
  .dr-about dd { margin: 6px 0 0; color: var(--ink-soft); }
  @media (max-width: 760px) { .dr-agent, .dr-about { grid-template-columns: minmax(0, 1fr); } .dr-search input { font-size: 17px; } }
</style>
