---
// levni.dev/you: a GitHub profile as a moving square card. The page reads public numbers from the GitHub API in the
// visitor's browser and Levni draws the card there; nothing is sent to us or stored.
import Base from '../layouts/Base.astro';
import { SITE } from '../site';

const faq = [
  { q: 'What does it read?', a: 'Only public numbers from the GitHub API, in your browser: your name, followers, public repos, their stars, topics and languages. Nothing is sent to us and nothing is stored.' },
  { q: 'How is the drawing picked?', a: 'From your repos’ topics, their names and your main language, searched in the 1,600 drawings of the Levni Folio. Pick another one below if you like.' },
  { q: 'Can I change it later?', a: 'The PNG carries its scene: drop it on the Levni editor and every part is yours to change. The GIF moves for posts and READMEs.' },
  { q: 'Why does it say rate limit?', a: 'GitHub lets a browser ask about 60 times an hour without signing in. Wait a little and try again.' },
];
const jsonld = [
  { '@type': 'WebApplication', name: 'Levni: your year in code', applicationCategory: 'DesignApplication', operatingSystem: 'Any (web browser)', url: `${SITE.url}/you/`, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } },
  { '@type': 'FAQPage', mainEntity: faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<Base title="Your year in code, drawn by Levni" description="Type a GitHub username and get a moving square card of your stars, repos and followers, hand-inked by Levni in your browser. Free, no sign-up, nothing stored." jsonld={jsonld}>
  <article class="wrap page yo">
    <header class="brand-hero">
      <p class="eyebrow">Free tool</p>
      <h1>Your year in code, drawn.</h1>
      <p class="lede">Type a GitHub username. Levni reads your public numbers in this browser and inks a moving square card: stars, repos, followers, your top repos and a drawing picked from your topics. Post it, pin it, put it in your profile README.</p>
    </header>

    <form class="yo-form" id="yo-form">
      <label for="yo-user">GitHub username</label>
      <div class="yo-row"><input id="yo-user" type="text" autocomplete="off" spellcheck="false" placeholder="octocat" required /><button type="submit" class="yo-go">Draw my card</button></div>
    </form>
    <p class="yo-status" id="yo-status" role="status" aria-live="polite"></p>

    <div class="yo-grid" id="yo-out" hidden>
      <figure class="yo-preview"><img id="yo-img" alt="" width="1080" height="1080" /></figure>
      <div class="yo-side">
        <p class="yo-h">Colours</p>
        <div class="yo-chips" id="yo-themes">
          <button type="button" data-theme="indigo" aria-pressed="true">Indigo</button>
          <button type="button" data-theme="ink" aria-pressed="false">Night</button>
          <button type="button" data-theme="paper" aria-pressed="false">Paper</button>
          <button type="button" data-theme="coral" aria-pressed="false">Coral</button>
        </div>
        <p class="yo-h">Drawing</p>
        <div class="yo-chips" id="yo-marks"></div>
        <div class="yo-actions">
          <button type="button" class="yo-go" id="yo-gif">Animated GIF</button>
          <button type="button" class="yo-ghost" id="yo-png">PNG</button>
          <button type="button" class="yo-ghost" id="yo-link">Copy link</button>
        </div>
        <p class="yo-small">The PNG carries its scene: drop it on the <a href="/editor/">editor</a> to change anything. Make one for a repo with the <a href="/banner/">banner maker</a>.</p>
      </div>
    </div>

    <section class="yo-about">
      <h2>Questions</h2>
      <dl>{faq.map(({ q, a }) => (<><dt>{q}</dt><dd>{a}</dd></>))}</dl>
    </section>
  </article>
</Base>

<script>
  import { compose, registerProps, registerFont, fontsFor, toBlob, animateBlob, stampPng, youStats, youScene, youTerms, pickMark, FALLBACK_MARKS } from '../../../src/browser.mjs';

  const propFiles = import.meta.glob('../../../library/props/*.json', { import: 'default' });
  const fontUrls = import.meta.glob('../../../fonts/*.{ttf,otf}', { query: '?url', import: 'default', eager: true }) as Record<string, string>;
  const FONT_FILES: Record<string, string> = { grotesk: 'SpaceGrotesk-Variable.ttf', black: 'ArchivoBlack-Regular.ttf', mono: 'JetBrainsMono-Variable.ttf', pixel: 'DepartureMono-Regular.otf' };
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const status = $('yo-status'), img = $<HTMLImageElement>('yo-img'), out = $('yo-out'), input = $<HTMLInputElement>('yo-user');
  const say = (t: string) => (status.textContent = t);
  let stats: any = null, mark = 'rocket', theme = 'indigo', candidates: string[] = [], scene: any = null, still = '', token = 0;
  let index: any[] = [];

  const fonts = new Set<string>(), props = new Set<string>();
  const ensureFonts = (names: string[]) => Promise.all(names.filter((n) => !fonts.has(n)).map(async (n) => {
    const url = Object.entries(fontUrls).find(([k]) => k.endsWith(FONT_FILES[n]))?.[1];
    if (url) { registerFont(n, await (await fetch(url)).arrayBuffer()); fonts.add(n); }
  }));
  const ensureProp = async (name: string) => {
    if (props.has(name)) return true;
    const load = propFiles[`../../../library/props/${name}.json`];
    if (!load) return false;
    registerProps(await load() as object); props.add(name); return true;
  };
  const getIndex = async () => index.length ? index : (index = (await (await fetch('/props-index.json')).json()).map(([name, , tags, variants, aliases]: any) => ({ name, tags, variants, aliases })));

  async function draw() {
    if (!stats) return;
    const my = ++token;
    if (!(await ensureProp(mark))) { mark = 'rocket'; await ensureProp(mark); }
    scene = youScene(stats, { mark, theme });
    await ensureFonts(fontsFor(scene));
    const blob = await toBlob((await compose({ ...scene, t: 0.95 })).svg);
    if (my !== token) return;
    if (still) URL.revokeObjectURL(still);
    still = URL.createObjectURL(blob);
    img.src = still;
    img.alt = `A square card for @${stats.login}: ${stats.stars} stars, ${stats.repos} repos, ${stats.followers} followers, top repos as bars, and a ${mark.replace(/-/g, ' ')} drawing`;
    out.hidden = false;
  }
  function renderMarks() {
    $('yo-marks').replaceChildren(...candidates.map((n) => {
      const b = document.createElement('button'); b.type = 'button'; b.textContent = n.replace(/-/g, ' '); b.setAttribute('aria-pressed', String(n === mark));
      b.addEventListener('click', () => { mark = n; renderMarks(); draw(); });
      return b;
    }));
  }
  async function load(login: string) {
    login = login.trim().replace(/^@/, '').replace(/^https?:\/\/github\.com\//, '').split('/')[0];
    if (!/^[a-z\d](?:[a-z\d-]{0,38})$/i.test(login)) { say('That does not look like a GitHub username.'); return; }
    say(`Reading @${login}…`);
    try {
      const gh = (p: string) => fetch(`https://api.github.com/${p}`, { headers: { accept: 'application/vnd.github+json' } });
      const [u, r] = await Promise.all([gh(`users/${login}`), gh(`users/${login}/repos?per_page=100&sort=pushed`)]);
      if (u.status === 404) { say(`No GitHub user called @${login}.`); return; }
      if (u.status === 403 || r.status === 403) { say('GitHub rate limit reached for this browser. Try again in a little while.'); return; }
      stats = youStats(await u.json(), r.ok ? await r.json() : []);
      candidates = [...new Set([...pickMark(youTerms(stats), await getIndex(), { limit: 6 }), ...FALLBACK_MARKS])].slice(0, 8);
      mark = candidates[0];
      renderMarks();
      await draw();
      history.replaceState(null, '', `#u=${encodeURIComponent(login)}`);
      say(`@${login}: ${stats.repos} repos, ${stats.stars} stars.`);
    } catch { say('Could not reach GitHub. Check the connection and try again.'); }
  }

  $('yo-form').addEventListener('submit', (e) => { e.preventDefault(); load(input.value); });
  $('yo-themes').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button'); if (!b) return;
    theme = b.dataset.theme!; $('yo-themes').querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); draw();
  });
  const save = (blob: Blob, file: string) => { const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = file; a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 2000); };
  $('yo-png').addEventListener('click', async () => {
    if (!scene) return;
    const png = await toBlob((await compose({ ...scene, t: 0.95 })).svg);
    save(new Blob([stampPng(new Uint8Array(await png.arrayBuffer()), scene)], { type: 'image/png' }), `${stats.login}-levni.png`);
  });
  $('yo-gif').addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement; if (!scene || btn.disabled) return;
    const label = btn.textContent; btn.disabled = true;
    try {
      const gif = await animateBlob(scene, { frames: 36, fps: 12, width: 720, onProgress: (d: number, n: number) => (btn.textContent = `Drawing ${d}/${n}`) });
      img.src = URL.createObjectURL(gif);
      save(gif, `${stats.login}-levni.gif`);
      say(`Animated card saved: 36 frames, 720 px, ${Math.round(gif.size / 1024)} KB.`);
    } catch (err) { say(`Could not draw the animation: ${(err as Error).message}`); }
    finally { btn.textContent = label; btn.disabled = false; }
  });
  $('yo-link').addEventListener('click', async (e) => {
    if (!stats) return;
    await navigator.clipboard.writeText(`${location.origin}/you/#u=${stats.login}`);
    const b = e.currentTarget as HTMLElement, t = b.textContent; b.textContent = 'Copied'; setTimeout(() => (b.textContent = t), 1400);
  });
  const fromHash = new URLSearchParams(location.hash.slice(1)).get('u');
  if (fromHash) { input.value = fromHash; load(fromHash); }
</script>

<style>
  .yo h1 { max-width: 14ch; }
  .yo .lede { max-width: 62ch; }
  .yo-form { margin-top: clamp(24px, 4vw, 40px); max-width: 640px; }
  .yo-form label, .yo-h { display: block; font: 600 12px/1 var(--mono); letter-spacing: .06em; text-transform: uppercase; margin: 0 0 8px; }
  .yo-row { display: flex; gap: 10px; flex-wrap: wrap; }
  .yo-row input { flex: 1 1 220px; font: 18px/1.3 var(--mono); padding: 12px 14px; border: 0; box-shadow: 0 0 0 2px var(--ink); background: #fff; color: var(--ink); }
  .yo-go, .yo-ghost { font: 600 13px/1 var(--mono); letter-spacing: .05em; text-transform: uppercase; padding: 14px 18px; border: 0; cursor: pointer; }
  .yo-go { background: var(--indigo); color: #fff; }
  .yo-ghost { background: #fff; color: var(--ink); box-shadow: 0 0 0 2px var(--ink); }
  .yo-go:focus-visible, .yo-ghost:focus-visible, .yo-row input:focus-visible, .yo-chips button:focus-visible { outline: 3px solid var(--lime); outline-offset: 2px; }
  .yo-go[disabled] { opacity: .7; cursor: progress; }
  .yo-status { min-height: 1.5em; margin: 12px 0 0; color: var(--ink-soft); }
  .yo-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(20px, 4vw, 48px); margin-top: 20px; align-items: start; }
  .yo-preview { margin: 0; background: #fff; padding: 10px; box-shadow: 0 0 0 1px var(--rule); }
  .yo-preview img { display: block; width: 100%; height: auto; aspect-ratio: 1; }
  .yo-side { display: grid; gap: 10px; align-content: start; }
  .yo-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 8px; }
  .yo-chips button { font: 600 12px/1 var(--mono); padding: 9px 11px; border: 0; background: #fff; color: var(--ink); box-shadow: 0 0 0 1px var(--rule); cursor: pointer; text-transform: capitalize; }
  .yo-chips button[aria-pressed='true'] { box-shadow: 0 0 0 2px var(--indigo); background: var(--paper); }
  .yo-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 6px; }
  .yo-small { font-size: 14px; color: var(--ink-soft); }
  .yo-about { max-width: 760px; margin: clamp(48px, 7vw, 80px) 0; }
  .yo-about dt { font-weight: 700; margin-top: 16px; }
  .yo-about dd { margin: 6px 0 0; color: var(--ink-soft); }
  @media (max-width: 820px) { .yo-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
