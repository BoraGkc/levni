---
// /library/in-use/: the drawings where they have to work, not in a grid. Six mock surfaces (a blog post, a README,
// a Notion page, an empty state, a slide, a welcome card); one switch redraws the drawing in all of them, in the browser.
import Base from '../../layouts/Base.astro';
import { SITE } from '../../site';
import { DRAW_STYLES } from '../../lib/draw-styles';

const S = {
  blog: 'lighthouse', readme: 'rocket', notion: 'coffee-cup', empty: 'inbox', slide: 'person-laptop', welcome: 'potted-plant',
};
// echo stacks its copies upward, so it does not fit the small frames here; the other five styles do
const LOOKS = DRAW_STYLES.filter((d) => d.id !== 'echo');
const description = `Levni drawings on a blog cover, a README, a Notion page, an empty state, a slide and a welcome card. Switch the style and every one redraws: ink, 3D, ASCII, dot matrix or dot lines. All ${SITE.props.toLocaleString('en')} drawings are free under CC BY 4.0.`;
---
<Base title="Drawings in use" description={description}>
  <section class="wrap iu-head">
    <p class="crumbs"><a href="/library/">Library</a> / In use</p>
    <h1>Where a drawing has to work.</h1>
    <p class="lede">A grid flatters every drawing. These are the places they actually end up: a post, a README, a page in someone's notes, the screen with nothing on it yet. Switch the style and all six redraw.</p>
  </section>

  <div class="iu-bar wrap" role="toolbar" aria-label="Draw them as">
    <span class="bar-l">Draw them as</span>
    {LOOKS.map((d) => <button type="button" data-look={d.id} aria-pressed={d.id === 'ink' ? 'true' : 'false'}>{d.label}</button>)}
    <label class="bar-ink"><input type="color" id="iu-ink" value="#14181F" /><span>Ink</span></label>
  </div>

  <section class="wrap boards" aria-label="Six surfaces">
    <!-- a blog post -->
    <figure class="m m-blog">
      <div class="m-chrome"><i></i><i></i><i></i><span>yourblog.dev/posts/moving-the-docs</span></div>
      <div class="blog-cover"><img data-d={S.blog} src={`/props-svg/${S.blog}-0.svg`} alt="A lighthouse drawing as the post's cover" width="520" height="520" /></div>
      <div class="blog-body"><p class="tag">Engineering · 6 min</p><h2>How we moved our docs to a static site</h2><p>Three weekends, one redirect map and a lot of deleted plugins. What we kept, what we dropped and the build that now takes nine seconds.</p></div>
      <figcaption>Blog cover</figcaption>
    </figure>

    <!-- a README -->
    <figure class="m m-readme">
      <div class="gh-top"><b>tinyqueue</b> <span>/ README.md</span></div>
      <div class="gh-banner"><div><p class="gh-k">tinyqueue</p><p class="gh-t">A job queue that fits in one file.</p></div><img data-d={S.readme} src={`/props-svg/${S.readme}-0.svg`} alt="A rocket drawing in a README banner" width="520" height="520" /></div>
      <div class="gh-body"><p><code>npm i tinyqueue</code></p><p>Retries, priorities and a dashboard, with no Redis and no daemon.</p></div>
      <figcaption>README banner</figcaption>
    </figure>

    <!-- a Notion page -->
    <figure class="m m-notion">
      <div class="nt-cover"></div>
      <div class="nt-icon"><img data-d={S.notion} src={`/props-svg/${S.notion}-0.svg`} alt="A coffee cup drawing as the page icon" width="520" height="520" /></div>
      <div class="nt-body"><h2>Coffee club rota</h2><p class="nt-prop"><span>Owner</span> Deniz</p><p class="nt-prop"><span>Next</span> Monday, the beans from Kadıköy</p><ul><li>Grinder cleaned on Fridays</li><li>Oat milk on the top shelf</li></ul></div>
      <figcaption>Notion page icon</figcaption>
    </figure>

    <!-- an empty state -->
    <figure class="m m-empty">
      <div class="app-side"><b>Mail</b><span class="on">Inbox</span><span>Sent</span><span>Archive</span></div>
      <div class="app-main"><img data-d={S.empty} src={`/props-svg/${S.empty}-0.svg`} alt="An inbox drawing in an empty state" width="520" height="520" /><h2>Nothing in your inbox</h2><p>New messages land here. Connect an address to start.</p><span class="app-btn">Connect an address</span></div>
      <figcaption>Empty state</figcaption>
    </figure>

    <!-- a slide -->
    <figure class="m m-slide">
      <div class="sl"><div class="sl-text"><p class="sl-k">Q4 · Team update</p><h2>Remote, and shipping more than ever.</h2><p>38 releases, 4 time zones, one Monday call.</p></div><img data-d={S.slide} src={`/props-svg/${S.slide}-0.svg`} alt="A person with a laptop on a slide" width="520" height="520" /></div>
      <figcaption>Slide</figcaption>
    </figure>

    <!-- a welcome card in a product -->
    <figure class="m m-welcome">
      <div class="wc"><img data-d={S.welcome} src={`/props-svg/${S.welcome}-0.svg`} alt="A potted plant on a welcome card" width="520" height="520" /><div><p class="wc-k">Step 1 of 3</p><h2>Plant your first project</h2><p>Name it, invite one person, and it grows from there.</p><span class="app-btn">Create a project</span></div></div>
      <figcaption>Welcome card</figcaption>
    </figure>
  </section>

  <section class="wrap iu-foot">
    <p>Every drawing above is in the <a href="/library/">library</a> with {SITE.props.toLocaleString('en')} others, free under CC BY 4.0. Open one for its page: <a href="/library/lighthouse/">lighthouse</a>, <a href="/library/rocket/">rocket</a>, <a href="/library/coffee-cup/">coffee cup</a>, <a href="/library/inbox/">inbox</a>, <a href="/library/person-laptop/">person with laptop</a>, <a href="/library/potted-plant/">potted plant</a>.</p>
    <p>Levni stays free and open. <a href="/support/">Keep it open</a> · <a href="/blog/contribute-drawing-open-library/">draw one for the Folio</a></p>
  </section>
</Base>

<script>
  import { styleTile, clearTiles, defaultInk } from '../../lib/style-previews';
  const btns = [...document.querySelectorAll<HTMLButtonElement>('.iu-bar [data-look]')];
  const ink = document.getElementById('iu-ink') as HTMLInputElement;
  const imgs = [...document.querySelectorAll<HTMLImageElement>('img[data-d]')];
  const STYLED = new Set(['ascii', 'dots', 'dotline']);
  let look = 'ink', token = 0, inkPicked = false;
  async function draw() {
    const my = ++token;
    clearTiles();
    if (!inkPicked) ink.value = defaultInk(look);
    document.body.classList.toggle('iu-dark', look === 'dotline');
    for (const img of imgs) {
      const name = img.dataset.d!;
      if (look === 'ink') { img.src = `/props-svg/${name}-0.svg`; continue; }
      try {
        const url = await styleTile(name, 0, look, STYLED.has(look) && inkPicked ? ink.value.toUpperCase() : undefined);
        if (my === token) img.src = url;
      } catch { /* keep the ink drawing */ }
    }
  }
  btns.forEach((b) => b.addEventListener('click', () => {
    look = b.dataset.look!;
    btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    draw();
  }));
  ink.addEventListener('change', () => { inkPicked = true; if (STYLED.has(look)) draw(); });
</script>

<style>
  .iu-head { margin-top: 0; }
  .crumbs { font-family: var(--mono); font-size: 0.82rem; color: var(--ink-soft); margin: 0 0 10px; }
  .crumbs a { color: inherit; }
  .lede { font-size: 1.15rem; color: var(--ink-soft); max-width: 62ch; }
  .iu-bar { position: sticky; top: 0; z-index: 10; display: flex; flex-wrap: wrap; align-items: center; gap: 6px; padding-block: 10px; margin-block: 18px 6px; background: var(--paper); border-bottom: 1px solid var(--rule); }
  .bar-l { font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-soft); margin-right: 4px; }
  .iu-bar button { font: inherit; font-size: 0.9rem; padding: 6px 12px; cursor: pointer; color: var(--ink); background: var(--paper-2); border: 1.5px solid var(--rule); }
  .iu-bar button:hover { border-color: var(--ink); }
  .iu-bar button[aria-pressed='true'] { background: var(--indigo); color: var(--paper-2); border-color: var(--ink); }
  .bar-ink { display: inline-flex; align-items: center; gap: 6px; font-size: 0.9rem; margin-left: 4px; }
  .bar-ink input { width: 28px; height: 28px; padding: 0; border: 1px solid var(--rule); background: none; }

  .boards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; margin-top: 18px; }
  @media (max-width: 820px) { .boards { grid-template-columns: 1fr; } }
  .m { margin: 0; background: #fff; border: 1.5px solid var(--rule); color: #1b1b22; display: flex; flex-direction: column; min-width: 0; overflow: hidden; }
  .m figcaption { margin-top: auto; padding: 8px 12px; font-family: var(--mono); font-size: 0.74rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-soft); border-top: 1px solid var(--rule); background: var(--paper); }
  .m h2 { font-size: 1.2rem; line-height: 1.2; margin: 0 0 6px; letter-spacing: -0.01em; }
  .m p { margin: 0 0 8px; font-size: 0.92rem; color: #4a4a58; }
  .m img { display: block; height: auto; max-width: 100%; }
  :global(body.iu-dark) .m img { background: #0b0b0c; }

  .m-chrome { display: flex; align-items: center; gap: 5px; padding: 8px 10px; background: #f1f0ec; font: 0.72rem var(--mono); color: #777; }
  .m-chrome i { width: 8px; height: 8px; border-radius: 50%; background: #d6d3cc; }
  .m-chrome span { margin-left: 8px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .blog-cover { background: #f2603f; display: grid; place-items: center; aspect-ratio: 1200 / 520; }
  .blog-cover img { width: 46%; }
  .blog-body { padding: 16px 18px 6px; }
  .tag { font: 0.72rem var(--mono); text-transform: uppercase; letter-spacing: 0.06em; color: #888 !important; }

  .gh-top { padding: 10px 14px; border-bottom: 1px solid #e5e5e5; font-size: 0.9rem; }
  .gh-top span { color: #888; }
  .gh-banner { margin: 14px; background: #1b1340; color: #e9f2d9; display: grid; grid-template-columns: 1fr 38%; align-items: center; gap: 10px; padding: 16px 18px; }
  .gh-banner img { width: 100%; background: #f4f2ec; }
  .gh-k { font: 600 0.75rem var(--mono); color: #d6e521 !important; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 6px !important; }
  .gh-t { font-size: 1.15rem !important; line-height: 1.2; color: #fff !important; margin: 0 !important; }
  .gh-body { padding: 0 16px 8px; }
  .gh-body code { font-size: 0.8rem; background: #f3f3f3; padding: 2px 6px; }

  .nt-cover { height: 70px; background: linear-gradient(90deg, #f6e7b7, #f2cfa7); }
  .nt-icon { margin: -38px 0 0 26px; width: 84px; height: 84px; background: #fff; }
  .nt-icon img { width: 100%; }
  .nt-body { padding: 8px 26px 12px; }
  .nt-prop span { display: inline-block; width: 70px; color: #999; }
  .nt-body ul { margin: 6px 0 0; padding-left: 1.1rem; font-size: 0.92rem; color: #4a4a58; }

  .m-empty { flex-direction: row; flex-wrap: wrap; }
  .app-side { flex: 0 0 110px; padding: 14px 12px; border-right: 1px solid #eee; display: flex; flex-direction: column; gap: 6px; font-size: 0.86rem; color: #666; }
  .app-side b { color: #1b1b22; margin-bottom: 4px; }
  .app-side .on { color: #1b1b22; font-weight: 600; }
  .app-main { flex: 1; min-width: 0; padding: 18px; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .app-main img { width: 120px; }
  .app-btn { display: inline-block; margin-top: 4px; background: #4b2fd6; color: #fff; font-size: 0.85rem; padding: 8px 12px; }
  .m-empty figcaption { flex-basis: 100%; }

  .sl { margin: 14px; aspect-ratio: 16 / 9; background: #0b57d0; color: #fff; display: grid; grid-template-columns: 1fr 40%; align-items: center; gap: 10px; padding: 18px 20px; }
  .sl img { width: 100%; background: #f4f2ec; }
  .sl h2 { color: #fff; font-size: 1.25rem; }
  .sl p { color: #dfe6ff !important; }
  .sl-k { font: 600 0.72rem var(--mono); text-transform: uppercase; letter-spacing: 0.08em; color: #f2c230 !important; }
  @media (max-width: 480px) {
    .sl, .gh-banner { aspect-ratio: auto; grid-template-columns: minmax(0, 1fr) 34%; padding: 14px; }
    .sl h2 { font-size: 1.05rem; }
    .gh-t { font-size: 1rem !important; }
    .wc { grid-template-columns: 84px minmax(0, 1fr); }
  }
  @media (max-width: 700px) {
    /* phones: the switch is one row that scrolls sideways, so it never covers more than a strip */
    .iu-bar { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; }
    .iu-bar::-webkit-scrollbar { display: none; }
    .iu-bar button, .bar-l, .bar-ink { flex: none; white-space: nowrap; }
  }

  .wc { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 16px; align-items: center; margin: 14px; padding: 16px; border: 1px solid #ececec; }
  .wc img { width: 100%; background: #eef6e9; }
  .wc-k { font: 600 0.72rem var(--mono); text-transform: uppercase; letter-spacing: 0.08em; color: #2e7d32 !important; }

  .iu-foot { margin-block: 32px 10px; color: var(--ink-soft); max-width: 760px; }
</style>
