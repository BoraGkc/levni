---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../site';
import props from '../../data/props.json';
// labels come from src/validate.mjs via render-library (the Pages build has no engine deps)
import CATEGORIES from '../../data/categories.json';
import inks from '../../data/inks.json';

// one drawing stands for each shelf on its chip
const icons = { film: 'film-reel', tv: 'monitor', stage: 'theater-curtain', music: 'headphones', books: 'book', tech: 'laptop', money: 'piggy-bank', law: 'scales', sport: 'soccer-ball', home: 'armchair', food: 'coffee-cup', nature: 'cat', places: 'bicycle', health: 'capsule', symbols: 'star' };
const shelves = Object.entries(CATEGORIES as Record<string, string>)
  .map(([key, label]) => ({ key, label, n: props.filter((p) => p.category === key).length }))
  .filter((c) => c.n > 0)
  .sort((a, b) => b.n - a.n);

const total = props.reduce((n, p) => n + p.variants.length, 0);
// pagination: the page ships the first PER tiles; the script fetches /props-index.json for search, shelves and later pages
const PER = 120;
const first = props.slice(0, PER);
const pages = Math.ceil(props.length / PER);
const title = 'Library';
const description = `Browse all ${props.length.toLocaleString("en")} drawings in the Levni Folio: icons, objects and spot illustrations in one hand-inked style, free under CC BY 4.0.`;
---
<Base title={title} description={description}>
  <section class="wrap lib-head">
    <p class="eyebrow">The Levni Folio · CC BY 4.0</p>
    <h1>Library</h1>
    <p class="lede">
      {props.length.toLocaleString("en")} drawn objects, {total.toLocaleString("en")} variants. Every one can be placed in a scene by name, recoloured by a style pack,
      and used anywhere with credit “drawings by Ortak Alan”.
    </p>
    <div class="tools">
      <label class="search">
        <span class="visually-hidden">Search the library</span>
        <input id="q" type="search" placeholder="Search: cat, money, phone, kedi…" autocomplete="off" />
      </label>
      <p class="count" id="count" aria-live="polite">Showing 1–{Math.min(PER, props.length)} of {props.length.toLocaleString('en')}</p>
    </div>
    <div class="shelves" role="group" aria-label="Categories">
      <button type="button" class="shelf" data-c="" aria-pressed="true"><span>All</span><small>{props.length}</small></button>
      {shelves.map((c) => (
        <button type="button" class="shelf" data-c={c.key} aria-pressed="false">
          <img src={`/props/${icons[c.key as keyof typeof icons]}-0.webp`} width="28" height="28" alt="" />
          <span>{c.label}</span><small>{c.n}</small>
        </button>
      ))}
    </div>
  </section>

  <section class="wrap" id="results" data-per={PER}>
    <nav class="pager" aria-label="Pages, top" data-pager>
      <button type="button" class="pg-prev" data-go="prev" disabled>Previous</button>
      <span class="pg-nums">
        {Array.from({ length: Math.min(pages, 5) }, (_, i) => (
          <button type="button" data-go={i + 1} aria-current={i === 0 ? 'page' : undefined} aria-label={`Page ${i + 1}`}>{i + 1}</button>
        ))}
        {pages > 5 && <span class="pg-gap" aria-hidden="true">…</span>}
        {pages > 5 && <button type="button" data-go={pages} aria-label={`Page ${pages}`}>{pages}</button>}
      </span>
      <button type="button" class="pg-next" data-go="next" disabled={pages < 2}>Next</button>
    </nav>
    <ul class="lib" id="lib">
      {first.map((p) => (
        <li>
          <button type="button" class="tile" data-name={p.name}>
            <img src={`/props/${p.name}-0.webp`} width="240" height="240" alt="" loading="lazy" decoding="async" />
            <span class="name">{p.name}</span>
            {p.variants.length > 1 && <span class="vars">{p.variants.length} variants</span>}
          </button>
        </li>
      ))}
    </ul>
    <p class="empty" id="empty" hidden>Nothing yet. <a href={`${SITE.github}/blob/main/CONTRIBUTING.md`}>Draw it for the Folio</a>.</p>
    <nav class="pager" aria-label="Pages, bottom" data-pager></nav>
  </section>

  <dialog id="detail" aria-labelledby="d-title">
    <form method="dialog"><button class="close" aria-label="Close">×</button></form>
    <h2 id="d-title"></h2>
    <p class="d-cat" id="d-cat"></p>
    <div class="inks" role="group" aria-label="Colours">
      <span class="inks-label">Colours</span>
      <button type="button" class="ink-chip" data-pack="riso" aria-pressed="true">Riso</button>
      <button type="button" class="ink-chip" data-pack="miniature" aria-pressed="false">Miniature</button>
      <button type="button" class="ink-chip" data-pack="mono" aria-pressed="false">Mono</button>
      <button type="button" class="ink-chip" data-pack="forest" aria-pressed="false">Forest</button>
      <button type="button" class="ink-chip" data-pack="night" aria-pressed="false">Night</button>
      <button type="button" class="ink-chip" data-pack="custom" aria-pressed="false">Your brand</button>
    </div>
    <div class="custom" id="d-custom" hidden>
      {['ink', 'blue', 'coral', 'mustard', 'green', 'paper'].map((k) => (
        <label><input type="color" data-ink={k} value={(inks.house as Record<string, string>)[k]} /> {k}</label>
      ))}
    </div>
    <ul class="variants" id="d-vars"></ul>
    <p class="use-label">Use it in a scene</p>
    <pre><code id="d-code"></code></pre>
  </dialog>

  <section class="wrap beyond" aria-labelledby="beyond-title">
    <div class="beyond-text">
      <h2 id="beyond-title">Beyond drawings</h2>
      <p>Every drawing here can also be the mark of a brand board, the middle of a seal, a die-cut sticker or a dot-matrix fill. Levni makes dither, mesh gradients, terrain and etching without any drawing at all.</p>
      <p><a class="text-link" href="/features/#boards">Brand boards and assets</a> · <a class="text-link" href="/gallery/#brand">See them in the gallery</a></p>
    </div>
    <ul class="beyond-imgs">
      <li><a href="/gallery/#stickers"><img src="/g/stickers/04-diecut-pack-s.webp" width="640" height="359" alt="Six library drawings with thick paper outlines like die-cut stickers" loading="lazy" decoding="async" /></a></li>
      <li><a href="/gallery/#boards"><img src="/g/boards/03-firin-s.webp" width="640" height="427" alt="A brand board for a bakery with a loaf of bread from the library as its mark" loading="lazy" decoding="async" /></a></li>
    </ul>
  </section>

  <section class="wrap cta">
    <h2>Missing something?</h2>
    <p>The Folio grows with every pull request. Draw one object as SVG paths, check it with <code>npx @levni/levni check</code>, and send it.</p>
    <a class="btn" href={`${SITE.github}/blob/main/CONTRIBUTING.md`}>Submit to the Folio</a>
  </section>
</Base>

<script define:vars={{ inks, cats: CATEGORIES }}>window.__inks = inks; window.__cats = cats;</script>
<script>
  type Prop = { name: string; c: string; q: string; notes: string[] };
  const CATS = (window as any).__cats as Record<string, string>;
  const q = document.getElementById('q') as HTMLInputElement;
  const list = document.getElementById('lib')!;
  const results = document.getElementById('results')!;
  const count = document.getElementById('count')!;
  const empty = document.getElementById('empty')!;
  const pagers = [...document.querySelectorAll<HTMLElement>('[data-pager]')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.shelf')];
  const PER = Number(results.dataset.per) || 120;
  const fmt = (n: number) => n.toLocaleString('en');
  const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  // the full index, fetched once
  const ready: Promise<Prop[]> = fetch('/props-index.json').then((r) => r.json()).then((rows: [string, string, string[], string[]][]) =>
    rows.map(([name, c, tags, notes]) => ({ name, c, notes, q: [name, ...tags, ...notes].join(' ').toLowerCase() })));
  const byName = new Map<string, Prop>();
  ready.then((all) => all.forEach((p) => byName.set(p.name, p)));

  const params = new URLSearchParams(location.search);
  let cat = params.get('c') || '';
  let page = Math.max(1, parseInt(params.get('page') || '1', 10) || 1);
  if (params.get('q')) q.value = params.get('q')!;

  function syncUrl(push = false) {
    const url = new URL(location.href);
    const set = (k: string, v: string) => (v ? url.searchParams.set(k, v) : url.searchParams.delete(k));
    set('q', q.value.trim());
    set('c', cat);
    set('page', page > 1 ? String(page) : '');
    if (url.href !== location.href) history[push ? 'pushState' : 'replaceState'](null, '', url);
  }

  // page buttons: first, last, and a window around the current page
  function pagerHtml(pages: number) {
    if (pages < 2) return '';
    const nums = new Set([1, pages, page - 1, page, page + 1].filter((n) => n >= 1 && n <= pages));
    if (page <= 3) [2, 3, 4].forEach((n) => n <= pages && nums.add(n));
    if (page >= pages - 2) [pages - 1, pages - 2, pages - 3].forEach((n) => n >= 1 && nums.add(n));
    const sorted = [...nums].sort((a, b) => a - b);
    let html = `<button type="button" class="pg-prev" data-go="prev"${page === 1 ? ' disabled' : ''}>Previous</button><span class="pg-nums">`;
    sorted.forEach((n, i) => {
      if (i && n - sorted[i - 1] > 1) html += '<span class="pg-gap" aria-hidden="true">…</span>';
      html += `<button type="button" data-go="${n}" aria-label="Page ${n}"${n === page ? ' aria-current="page"' : ''}>${n}</button>`;
    });
    return html + `</span><button type="button" class="pg-next" data-go="next"${page === pages ? ' disabled' : ''}>Next</button>`;
  }

  // the server already rendered the first page
  let lastKey = [...list.querySelectorAll<HTMLElement>('.tile')].map((b) => b.dataset.name).join(',');
  async function render() {
    const all = await ready;
    const words = q.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
    const hits = all.filter((p) => (!cat || p.c === cat) && words.every((w) => p.q.includes(w)));
    const pages = Math.max(1, Math.ceil(hits.length / PER));
    page = Math.min(page, pages);
    const from = (page - 1) * PER;
    const slice = hits.slice(from, from + PER);
    const key = slice.map((p) => p.name).join(',');
    if (key !== lastKey) {
      list.innerHTML = slice.map((p) => `<li><button type="button" class="tile" data-name="${esc(p.name)}"><img src="/props/${esc(p.name)}-0.webp" width="240" height="240" alt="" loading="lazy" decoding="async"><span class="name">${esc(p.name)}</span>${p.notes.length > 1 ? `<span class="vars">${p.notes.length} variants</span>` : ''}</button></li>`).join('');
      lastKey = key;
    }
    count.textContent = hits.length ? `Showing ${fmt(from + 1)}–${fmt(from + slice.length)} of ${fmt(hits.length)}${hits.length < all.length ? ` (${fmt(all.length)} in all)` : ''}` : `No drawings match (${fmt(all.length)} in all)`;
    empty.hidden = hits.length > 0;
    const html = pagerHtml(pages);
    pagers.forEach((p) => { p.innerHTML = html; p.hidden = !html; });
  }

  const setCat = (c: string) => {
    cat = c;
    chips.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.c === c)));
  };
  chips.forEach((b) => b.addEventListener('click', () => { setCat(b.dataset.c!); page = 1; syncUrl(); render(); }));
  q.addEventListener('input', () => { page = 1; syncUrl(); render(); });
  pagers.forEach((nav, k) => nav.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-go]');
    if (!b || b.disabled) return;
    const go = b.dataset.go!;
    page = go === 'prev' ? page - 1 : go === 'next' ? page + 1 : Number(go);
    syncUrl(true);
    render().then(() => {
      if (k === 1 || results.getBoundingClientRect().top < 0) results.scrollIntoView({ block: 'start' });
      // keep focus on the pager the visitor used
      (pagers[k].querySelector<HTMLButtonElement>(`button[data-go="${go}"]:not([disabled])`) || pagers[k].querySelector<HTMLButtonElement>('[aria-current]'))?.focus({ preventScroll: k === 0 });
    });
  }));
  window.addEventListener('popstate', () => {
    const p = new URLSearchParams(location.search);
    q.value = p.get('q') || '';
    setCat(p.get('c') || '');
    page = Math.max(1, parseInt(p.get('page') || '1', 10) || 1);
    render();
  });
  setCat(cat);
  render();

  // --- colours: the dialog loads each variant as SVG and swaps the house hex values, like the engine's style packs
  const { house, packs } = (window as any).__inks as { house: Record<string, string>; packs: Record<string, Record<string, string>> };
  const presets: Record<string, Record<string, string>> = {
    riso: {},
    miniature: packs.miniature,
    mono: { ink: '#1A1A1A', blue: '#3A3A3A', coral: '#8A8A8A', mustard: '#C8C8C8', green: '#5A5A5A', dark: '#111111', tone: '#BDBDBD', 'tone-coral': '#D6D6D6', 'tone-green': '#A8A8A8', 'tone-mustard': '#E4E4E4', paper: '#F5F5F3' },
    forest: { ink: '#1F3B2C', blue: '#2F6B4F', coral: '#D9783A', mustard: '#E8B64C', green: '#6E9B3A', tone: '#9CC5A8', 'tone-coral': '#F0B892', 'tone-mustard': '#F3D9A0', paper: '#F3EFE3' },
    night: { ink: '#F4F2EC', blue: '#3D5AFE', coral: '#FF6B8A', mustard: '#FFD166', green: '#06D6A0', tone: '#5468C9', 'tone-coral': '#B3536A', 'tone-mustard': '#B39548', paper: '#14181F', white: '#232A36', dark: '#F4F2EC' },
  };
  let pack = 'riso';
  const custom: Record<string, string> = {};
  const inksNow = () => (pack === 'custom' ? custom : presets[pack]);
  const svgCache = new Map<string, string>();
  const swap = (svg: string, map: Record<string, string>) => {
    const pairs = Object.entries(map).filter(([k, v]) => house[k] && v).map(([k, v]) => [house[k].toLowerCase(), v]);
    if (!pairs.length) return svg;
    const lookup = new Map(pairs);
    return svg.replace(new RegExp(`(${[...lookup.keys()].join('|')})(?![0-9a-f])`, 'gi'), (m) => lookup.get(m.toLowerCase()) || m);
  };
  const urls: string[] = [];
  async function paint() {
    urls.splice(0).forEach((u) => URL.revokeObjectURL(u));
    const map = inksNow();
    for (const img of vars.querySelectorAll<HTMLImageElement>('img[data-svg]')) {
      const src = img.dataset.svg!;
      if (!Object.keys(map).length) { img.src = img.dataset.tile!; continue; }
      if (!svgCache.has(src)) svgCache.set(src, await (await fetch(src)).text());
      const url = URL.createObjectURL(new Blob([swap(svgCache.get(src)!, map)], { type: 'image/svg+xml' }));
      urls.push(url);
      img.src = url;
    }
    writeCode();
  }
  const inkChips = [...document.querySelectorAll<HTMLButtonElement>('.ink-chip')];
  const customBox = document.getElementById('d-custom')!;
  inkChips.forEach((b) => b.addEventListener('click', () => {
    pack = b.dataset.pack!;
    inkChips.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    customBox.hidden = pack !== 'custom';
    paint();
  }));
  customBox.querySelectorAll<HTMLInputElement>('input[type=color]').forEach((inp) => inp.addEventListener('input', () => {
    custom[inp.dataset.ink!] = inp.value.toUpperCase();
    paint();
  }));

  const dlg = document.getElementById('detail') as HTMLDialogElement;
  const vars = document.getElementById('d-vars')!;
  const code = document.getElementById('d-code')!;
  let current = { name: '', v: 0 };
  const snippet = (name: string, v: number) =>
    `{ "type": "prop", "name": "${name}",${v ? ` "variant": ${v},` : ''} "x": 600, "y": 336, "size": 320 }`;
  function writeCode() {
    const el = snippet(current.name, current.v);
    const map = inksNow();
    const style = pack === 'riso' ? '' : pack === 'miniature' ? '"miniature"' : JSON.stringify(map);
    code.textContent = style && Object.keys(map).length ? `{ "style": ${style},\n  "elements": [ ${el} ] }` : el;
  }
  list.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.tile');
    if (!b) return;
    const name = b.dataset.name!;
    await ready;
    const prop = byName.get(name);
    if (!prop) return;
    const notes = prop.notes;
    document.getElementById('d-title')!.textContent = name;
    document.getElementById('d-cat')!.textContent = CATS[prop.c] || '';
    vars.replaceChildren(...notes.map((note, i) => {
      const li = document.createElement('li');
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.innerHTML = `<img src="/props/${name}-${i}.webp" data-tile="/props/${name}-${i}.webp" data-svg="/props-svg/${name}-${i}.svg" width="240" height="240" alt=""><span>variant ${i}</span>`;
      btn.title = note;
      btn.setAttribute('aria-label', `variant ${i}${note ? `: ${note}` : ''}`);
      btn.addEventListener('click', () => {
        vars.querySelectorAll('button').forEach((x) => x.removeAttribute('aria-pressed'));
        btn.setAttribute('aria-pressed', 'true');
        current = { name, v: i };
        writeCode();
      });
      if (i === 0) btn.setAttribute('aria-pressed', 'true');
      li.append(btn);
      return li;
    }));
    current = { name, v: 0 };
    dlg.showModal();
    paint();
  });
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
</script>

<style>
  .lib-head { margin-top: 48px; }
  .eyebrow { font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent-text); margin: 0 0 14px; }
  .lede { font-size: 1.2rem; color: var(--ink-soft); max-width: 720px; }
  .tools { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin: 24px 0 20px; }
  .search { flex: 1 1 320px; }
  .search input {
    width: 100%; font: inherit; font-size: 1.05rem; padding: 12px 14px; color: var(--ink);
    background: var(--paper-2); border: 2px solid var(--ink); border-radius: 0;
  }
  .count { margin: 0; color: var(--ink-soft); font-family: var(--mono); font-size: 0.9rem; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .shelves { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 22px; }
  /* phones: one row that scrolls sideways, so the drawings start on the first screen */
  @media (max-width: 700px) {
    .shelves { flex-wrap: nowrap; overflow-x: auto; margin: 0 0 22px; padding: 2px 0 8px; scroll-snap-type: x proximity; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
    .shelves::-webkit-scrollbar { display: none; }
    .shelves > * { flex: 0 0 auto; scroll-snap-align: start; white-space: nowrap; }
  }
  .shelf {
    display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px 5px 8px; cursor: pointer;
    font: inherit; font-size: 0.92rem; color: var(--ink); background: var(--paper-2); border: 1.5px solid var(--rule); border-radius: 999px;
  }
  .shelf:first-child { padding-left: 14px; }
  .shelf img { width: 28px; height: 28px; border-radius: 50%; }
  .shelf small { font-family: var(--mono); font-size: 0.75rem; color: var(--ink-soft); }
  .shelf:hover { border-color: var(--ink); }
  .shelf[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: var(--paper-2); }
  .shelf[aria-pressed='true'] small { color: var(--rule); }
  .d-cat { margin: -6px 0 10px; color: var(--ink-soft); font-size: 0.95rem; }
  .lib { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
  .pager { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 6px; margin: 0 0 18px; }
  .pager[hidden] { display: none; }
  .lib + .empty + .pager { margin: 24px 0 0; }
  :global(.pg-nums) { display: inline-flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .pager :global(button) {
    font: inherit; font-size: 0.92rem; min-width: 40px; min-height: 40px; padding: 6px 12px; cursor: pointer;
    color: var(--ink); background: var(--paper-2); border: 1.5px solid var(--rule); border-radius: 999px;
  }
  .pager :global(button:hover:not([disabled])) { border-color: var(--ink); }
  .pager :global(button[aria-current='page']) { background: var(--ink); border-color: var(--ink); color: var(--paper-2); }
  .pager :global(button[disabled]) { opacity: 0.45; cursor: default; }
  /* phones: Previous / Next only (the count above says where you are) */
  @media (max-width: 480px) {
    .pager :global(.pg-nums) { display: none; }
    .pager { justify-content: space-between; }
    .pager :global(.pg-prev), .pager :global(.pg-next) { flex: 1; }
  }
  .pg-gap { color: var(--ink-soft); padding: 0 2px; }
  .tile {
    width: 100%; display: flex; flex-direction: column; align-items: center; gap: 2px; cursor: pointer;
    background: #f4f2ec; border: 1px solid var(--rule); padding: 6px 6px 10px; font: inherit; color: var(--ink);
    transition: border-color 0.15s, transform 0.15s;
  }
  .tile:hover { border-color: var(--accent); transform: translateY(-2px); }
  .tile img { width: 100%; aspect-ratio: 1; }
  .name { font-family: var(--mono); font-size: 0.8rem; overflow-wrap: anywhere; text-align: center; }
  .vars { font-size: 0.82rem; color: var(--ink-soft); }
  .empty { text-align: center; color: var(--ink-soft); margin: 40px 0; }

  dialog {
    width: min(760px, calc(100vw - 32px)); max-height: calc(100vh - 48px); border: 2px solid var(--ink); border-radius: 0;
    background: var(--paper); color: var(--ink); padding: 24px;
  }
  dialog::backdrop { background: rgba(20, 24, 31, 0.5); }
  .close { position: absolute; top: 8px; right: 12px; font-size: 1.8rem; line-height: 1; background: none; border: 0; cursor: pointer; color: var(--ink); padding: 6px 10px; }
  .variants { list-style: none; padding: 0; margin: 8px 0 18px; display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 10px; }
  .variants button {
    width: 100%; background: #f4f2ec; border: 2px solid var(--rule); padding: 4px 4px 8px; cursor: pointer;
    font-family: var(--mono); font-size: 0.78rem; color: var(--ink-soft); display: flex; flex-direction: column; align-items: center;
  }
  .variants button[aria-pressed='true'] { border-color: var(--accent); color: var(--ink); }
  .variants img { width: 100%; aspect-ratio: 1; }
