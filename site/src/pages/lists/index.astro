---
import Base from '../../layouts/Base.astro';
import { LISTS, total, groupByCategory } from '../../data/lists';
import { SITE } from '../../site';
import TurkishGuides from '../../components/TurkishGuides.astro';

const jsonld = [{
  '@type': 'CollectionPage',
  name: 'No FOMO lists: open design, design MCP servers and lettering',
  url: `${SITE.url}/lists/`,
  description: 'Curated lists of open-source design tools, MCP servers for design and type resources. Open licence, free to start, maintained.',
  hasPart: LISTS.map((l) => ({ '@type': 'ItemList', name: l.title, url: `${SITE.url}/lists/${l.slug}/`, numberOfItems: l.entries.length })),
}];
---
<Base og="/og/lists.png" title="No FOMO lists: open design tools, design MCP servers, lettering" description={`${total} open-source design tools, MCP servers for design and type resources, curated by Levni-Dev. Open licence, free to start, no waitlist, no FOMO.`} jsonld={jsonld}>
  <header class="wrap brand-hero">
    <p class="eyebrow">No FOMO lists · curated by Levni-Dev</p>
    <h1>No FOMO. <em>Only open.</em></h1>
    <p class="lede">{total} open-source design tools, MCP servers and type resources, checked by hand. Every week something new launches with a waitlist and a credit card form. You do not need it: the open version is probably already here.</p>
  </header>

  <section class="wrap rules" aria-label="The rule">
    <p class="kicker">{'{'}the rule{'}'}</p>
    <ol>
      <li><b>Open.</b> An OSI licence for code, an open licence for assets. Free for personal use is not open.</li>
      <li><b>Free to start.</b> No credit card, no paid API key, no waitlist.</li>
      <li><b>Alive.</b> Not archived, and maintained.</li>
      <li><b>Not about us.</b> Levni appears once, as an ordinary entry. The stage belongs to everyone else.</li>
    </ol>
  </section>

  <section class="wrap" aria-label="The lists">
    <ul class="lists">
      {LISTS.map((l) => (
        <li>
          <a class="lcard" href={`/lists/${l.slug}/`}>
            <img src={`/lists/${l.slug}.gif`} width="1280" height="560" alt={`${l.title} banner drawn by Levni`} loading="lazy" />
            <span class="lbody">
              <b>{l.title}</b>
              <small>{l.entries.length} entries · {groupByCategory(l.entries).length} sections</small>
              <span>{l.short}</span>
              <em>Open the list →</em>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <TurkishGuides path="/lists/" wrap />

  <section class="wrap suggest" aria-label="Suggest">
    <h2>Made something open? Found something that belongs here?</h2>
    <p>Suggest it in one minute on GitHub. Every accepted suggestion is credited. Your own project is welcome.</p>
    <p class="s-links">{LISTS.map((l) => <a href={`https://github.com/${l.repo}/issues/new?template=suggest.yml`}>Suggest for {l.title} →</a>)}</p>
    <p class="thanks">With thanks to <a href="https://github.com/sindresorhus/awesome">sindresorhus/awesome</a>, the list of lists, and to <a href="https://github.com/punkpeye/awesome-mcp-servers">punkpeye/awesome-mcp-servers</a> for every MCP server outside design.</p>
  </section>
</Base>

<style>
  section { margin-top: clamp(48px, 6vw, 80px); }
  .rules ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }
  .rules li { border-top: 3px solid var(--indigo); padding-top: 12px; color: var(--ink-soft); font-size: 0.98rem; }
  .rules b { display: block; color: var(--indigo); font-size: 1.1rem; }
  .lists { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .lcard { display: flex; flex-direction: column; height: 100%; background: #fff; color: var(--ink); text-decoration: none; clip-path: polygon(0 0, 100% 0, 100% calc(100% - 18px), calc(100% - 18px) 100%, 0 100%); transition: background 0.2s; }
  .lcard:hover { background: var(--lime); color: var(--ink); }
  .lcard img { width: 100%; height: auto; aspect-ratio: 1280 / 560; object-fit: cover; }
  .lbody { display: flex; flex-direction: column; gap: 6px; padding: 18px 20px 24px; }
  .lbody b { font-size: 1.35rem; color: var(--indigo); letter-spacing: -0.02em; }
  .lbody small { font: 0.74rem/1.3 var(--mono); color: var(--coral-deep); text-transform: uppercase; letter-spacing: 0.06em; }
  .lbody span { color: var(--ink-soft); }
  .lbody em { font: normal 600 0.76rem/1 var(--mono); text-transform: uppercase; letter-spacing: 0.06em; color: var(--indigo); margin-top: 6px; }
  .suggest h2 { color: var(--indigo); max-width: 22ch; }
  .suggest p { color: var(--ink-soft); max-width: 60ch; }
  .s-links { display: flex; flex-wrap: wrap; gap: 8px 22px; font: 600 0.78rem/1.6 var(--mono); text-transform: uppercase; letter-spacing: 0.05em; }
  .s-links a { text-decoration: none; }
  .thanks { font-size: 0.92rem; margin-top: 24px; }
  @media (max-width: 960px) { .lists { grid-template-columns: minmax(0, 1fr); } .rules ol { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .rules ol { grid-template-columns: minmax(0, 1fr); } }
</style>
