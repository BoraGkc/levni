---
import Base from '../layouts/Base.astro';
import { MAKE } from '../data/make';
// each "What it makes" tile opens its free maker
const MAKE_BY_LABEL: Record<string, string> = {
  'Branding posters': 'branding-posters', 'Covers and spots': 'blog-covers-og-images', '3D icons': '3d-icons', 'Pixel icons': 'pixel-icons',
  'Little worlds': 'isometric-illustrations', Charts: 'hand-drawn-charts', 'Seals and stickers': 'stickers-seals-tickets', 'Dither and print screens': 'dither-pixel-art',
  'Mesh gradients': 'mesh-gradients', 'ASCII art': 'ascii-art', 'Terrain and etching': 'wireframe-terrain-etching', 'Brand boards': 'brand-board',
};
for (const slug of Object.values(MAKE_BY_LABEL)) if (!MAKE.some((m) => m.slug === slug)) throw new Error(`no /make/ page ${slug}`);
import TryLevni from '../components/TryLevni.astro';
import TurkishGuides from '../components/TurkishGuides.astro';
import Logo from '../components/Logo.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../site';
import { getCollection } from 'astro:content';
import folio from '../data/props.json';
import CATEGORIES from '../data/categories.json';
import showcase from '../data/gallery.json';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const repo = SITE.github.replace('https://github.com/', '');
const pkg = '@levni/levni';

// The marquee: two rows of real library tiles, picked across shelves so the breadth shows at a glance
const rowA = ['cat', 'rocket', 'bicycle', 'coffee-cup', 'person-laptop', 'piggy-bank', 'umbrella', 'camera', 'pizza-slice', 'lighthouse', 'headphones', 'trophy', 'sun', 'bank', 'guitar', 'ambulance', 'sailboat', 'robot'];
const rowB = ['battery', 'globe', 'stethoscope', 'house', 'two-people', 'pie-chart', 'film-reel', 'tulip', 'airplane', 'laptop', 'rainbow', 'scales', 'bell', 'potted-plant', 'dna', 'megaphone', 'tea-glass', 'location-pin'];
const shelfCount = Object.keys(CATEGORIES).length;

// The hero reel: real outputs of every look, each card links to its gallery tab (images from scripts/render-gallery.mjs)
const item = (group: string, id: string, label: string) => {
  const it = (showcase.items as { group: string; id: string; alt: string }[]).find((i) => i.group === group && i.id === id);
  return { group, label, src: `/g/${group}/${id}-s.webp`, alt: it?.alt ?? label };
};
const poster = (id: string) => ({ group: 'posters', label: 'Branding posters', src: `/g/posters/${id}-s.webp`, alt: 'Three branding posters from one brand spec, sharing inks, type and a mark' });
const reel = [
  item('boards', '01-feneri', 'Brand board'),
  poster('strip-1'),
  item('stickers', '01-seal-sheet', 'Seals and stickers'),
  item('soft3d', 'auto-01', 'Soft 3D cover'),
  item('boards', '03-firin', 'Brand board'),
  item('brand', '01-dither-sunset', 'Dither'),
  item('worlds', 'cafe-riso-2', 'Little world'),
  item('stickers', '04-diecut-pack', 'Die-cut stickers'),
  item('covers', 'cover-riso', 'Riso cover'),
  item('lines', '05-engrave-poster', 'Etching'),
  item('icons', 'row', '3D icons'),
  item('boards', '04-kule', 'Brand board'),
  item('charts', 'bars', 'Hand-inked data'),
  item('brand', '07-meshgrad-hero', 'Mesh gradient'),
  item('pixel', 'grid-riso', 'Pixel icons'),
  poster('strip-2'),
  item('stickers', '02-seal-loyalty', 'Seals and stickers'),
  item('lines', '01-terrain-hero', 'Terrain'),
  item('soft3d', 'auto-03', 'Soft 3D cover'),
  item('brand', '10-glyphfill-globe', 'ASCII art'),
  item('worlds', 'city-soft', 'Little world, soft'),
  item('soft3d', 'preset-mobius', 'Möbius ribbon'),
];

// Brand boards: the large example and three more
const boardJson = `{ "brand": {
    "name": "Feneri",
    "tagline": "Slow ferries across the Bosphorus",
    "mark": "lighthouse",
    "inks": ["#14213D", "#FCA311", "#3A86A8", "#EFEAE0"]
} }`;
const boardMore = ['02-pusula', '04-kule', '05-lale'].map((id) => item('boards', id, 'Brand board'));
const boardAlt = (showcase.items as { group: string; id: string; alt: string }[]).find((i) => i.group === 'boards' && i.id === '01-feneri')?.alt ?? 'A brand board';

// What it makes: one tile per kind, each to its gallery tab (the gallery filters by #group)
const makes = [
  ['posters', 'strip-1', 'Branding posters', 'Eight posters from one brand spec.'],
  ['covers', 'cover-riso', 'Covers and spots', 'Article covers and drawings on a disc or panel.'],
  ['icons', 'row', '3D icons', 'Any library drawing extruded and lit.'],
  ['pixel', 'grid-riso', 'Pixel icons', 'Icon sets on a pixel grid.'],
  ['worlds', 'cafe-riso-2', 'Little worlds', 'Isometric rooms, streets and cities.'],
  ['charts', 'bars', 'Charts', 'Bars, lines, pies and donuts, hand-inked.'],
  ['stickers', '01-seal-sheet', 'Seals and stickers', 'Seals, tickets and die-cut drawings.'],
  ['brand', '01-dither-sunset', 'Dither and print screens', 'Pixel skies, gameboy and blueprint looks.'],
  ['brand', '07-meshgrad-hero', 'Mesh gradients', 'Grainy gradients with room for a headline.'],
  ['brand', '10-glyphfill-globe', 'ASCII art', 'Shapes filled with characters or dots.'],
  ['lines', '05-engrave-poster', 'Terrain and etching', 'Wireframe hills and pen-hatched plates.'],
  ['boards', '03-firin', 'Brand boards', 'Nine tiles from four fields.'],
].map(([group, id, label, text]) => ({ ...(group === 'posters' ? poster(id) : item(group, id, label)), label, text, href: `/make/${MAKE_BY_LABEL[label]}/` }));

// The recolour demo: real per-variant SVGs from /props-svg, recoloured in the browser like a style pack
const demo = [
  { name: 'rocket', v: 0 }, { name: 'person-laptop', v: 0 }, { name: 'cat', v: 0 },
  { name: 'coffee-cup', v: 0 }, { name: 'battery', v: 5 }, { name: 'bicycle', v: 0 },
];

// The real scene behind /gallery/cover-riso.webp (examples/cover.json)
const scene = `{
  "seed": 5,
  "clip": [60, 52, 1080, 569],
  "elements": [
    { "type": "panel",
      "color": "blue",
      "x": 60, "y": 52,
      "w": 1080, "h": 569 },
    { "type": "sunburst",
      "color": "mustard",
      "x": 780, "y": 300,
      "size": 420 },
    { "type": "prop",
      "name": "rocket",
      "x": 780, "y": 300,
      "size": 380, "rot": 20,
      "shadow": true },
    { "type": "crowd",
      "highlight": "coral",
      "x": 90, "y": 560,
      "w": 520, "rows": 2 },
    { "type": "label",
      "text": "Launch / Space",
      "x": 100, "y": 104,
      "color": "paper" }
  ]
}`;

const clients = [
  { id: 'claude-code', label: 'Claude Code', file: 'Terminal', code: `claude mcp add levni -- npx -y ${pkg} mcp` },
  { id: 'claude-desktop', label: 'Claude Desktop', file: 'claude_desktop_config.json', code: `{
  "mcpServers": {
    "levni": {
      "command": "npx",
      "args": ["-y", "${pkg}", "mcp"]
    }
  }
}` },
  { id: 'cursor', label: 'Cursor', file: '.cursor/mcp.json', code: `{
  "mcpServers": {
    "levni": {
      "command": "npx",
      "args": ["-y", "${pkg}", "mcp"]
    }
  }
}` },
  { id: 'vscode', label: 'VS Code', file: '.vscode/mcp.json', code: `{
  "servers": {
    "levni": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "${pkg}", "mcp"]
    }
  }
}` },
  { id: 'cli', label: 'CLI', file: 'Any agent with a shell', code: `npm install ${pkg}
npx @levni/levni list cat
npx @levni/levni render scene.json cover.png` },
];
const tools = [
  ['list_props', 'search the library by word, tag or shelf'],
  ['show_props', 'a contact sheet of drawings and their variants'],
  ['render_scene', 'draw a scene, return a preview and the critic’s notes'],
  ['render_board', 'a whole brand board from a name, mark and inks'],
  ['render_poster', 'a series of branding posters from one brand'],
  ['render_brand_kit', 'mark, favicons, cards, banner, board and posters in one folder'],
  ['render_animation', 'a scene as a looping GIF or WebP, with a strip of frames to look at'],
  ['render_storyboard', 'a shot list as a numbered sheet with timecodes'],
  ['render_print', 'riso plates for a real print run, one image per ink'],
  ['render_shot', 'a ready-made motion shot with your words, drawing and inks'],
  ['render_reel', 'shots joined with transitions into one video'],
  ['critique_scene', 'only the notes, for quick iterations'],
  ['scene_guide', 'every element type, colour and style pack'],
];

const gallery = [
  { src: 'oa-hadeln', alt: 'A golden arched gate with open doors behind a row of faceless audience figures on a blue panel', cap: 'Film festival' },
  { src: 'oa-tahmin', alt: 'A roulette wheel struck by a judge’s gavel, halftone dots behind', cap: 'Prediction markets' },
  { src: 'oa-orman', alt: 'A cut tree stump on a blue panel full of glyphs, small trees on both sides', cap: 'Environment' },
  { src: 'oa-ice', alt: 'A film camera projecting onto a city block, an audience along the bottom', cap: 'Documentary' },
  { src: 'oa-venezuela', alt: 'A blue oil barrel beside a coral panel with a sun and a drop of oil', cap: 'Energy' },
  { src: 'oa-orna', alt: 'A microphone resting on a sofa on a blue panel with wave lines', cap: 'Culture' },
  { src: 'oa-delpy', alt: 'A white jacket with a coral overprint shadow on a blue panel', cap: 'Cinema and fashion' },
];

const faq = [
  { q: 'What is Levni?', a: `An open illustration library (${SITE.props} hand-inked drawings and growing) and the open-source engine that composes them into covers, spot illustrations, icons, social images, stickers, brand assets, brand boards and branding posters, in one consistent style. It runs on Node with sharp; there is no image model and no API key.` },
  { q: 'Can I use the drawings on their own?', a: 'Yes. Search the Library in English or Turkish, open a drawing and copy its scene code, JavaScript or CLI line, or download it as SVG in any style pack. The drawings are CC BY 4.0: free for commercial work with credit “drawings by Ortak Alan”.' },
  { q: 'Are there brand logos?', a: 'No, and there will not be. Logos are trademarks that cannot be redrawn in another style, so the Folio draws generic objects instead: a phone, a play button, a speech bubble. Use the brand’s own press kit or Simple Icons for logos.' },
  { q: 'How do AI agents use it?', a: 'An agent writes the scene JSON, renders it, and reads the layout critic’s notes (off-canvas elements, accidental crops, lopsided weight, no focal point) before a person looks. Because it is JSON in and image out, it maps directly onto an MCP tool.' },
  { q: 'How fast is it?', a: 'About 0.15 seconds for a hand-inked cover on a laptop, with no GPU: Levni applies its crayon finish to the pixels itself, about seven times faster than leaving it to the SVG renderer. A batch of hundreds of covers runs in a minute or two, and an agent gets its preview almost at once.' },
  { q: 'What does it cost?', a: 'Nothing per image. Levni is MIT-licensed code that runs on your own machine or in CI. The Levni Folio drawings are CC BY 4.0: credit “drawings by Ortak Alan”.' },
  { q: 'Can it draw in my brand colours?', a: 'Yes. Set "style" to a map of your own inks, for example { "blue": "#6A1B9A", "mustard": "#00BFA5" }, and every drawing, panel and texture follows. Riso and miniature are the two built-in packs.' },
  { q: 'Is there an MCP server?', a: 'Yes: run npx @levni/levni mcp. It gives assistants six tools: the scene guide, library search, a contact sheet of props, render with preview, brand boards, and the critic. Agents without MCP use the same engine through the CLI.' },
];

const jsonld = [
  {
    '@type': 'SoftwareApplication',
    name: 'Levni',
    applicationCategory: 'DesignApplication',
    operatingSystem: 'macOS, Linux, Windows (Node.js 20+)',
    description: SITE.description,
    url: `${SITE.url}/`,
    license: 'https://opensource.org/licenses/MIT',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@id': `${SITE.ortakAlan}/#organization` },
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];
const star = `<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z" fill="currentColor"/></svg>`;
---
<Base title="Levni" description={SITE.description} jsonld={jsonld}>
  <!-- 1. Hero: the promise beside a live ASCII drawing -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="hero-k">{'{'}a post-AI center for designers · open source · mcp-ready{'}'}</p>
        <h1>Designed for agents, drawn for people.</h1>
        <p class="hero-sub">A design studio your agent can run. No image model inside.</p>
        <p class="lede">Illustrations, covers, 3D and pixel icons, charts, brand boards and branding posters, drawn from a few lines of JSON in one hand-inked style. Free and local, with an MCP server so Claude, Codex or Cursor can run it.</p>
        <div class="install"><code>npx -y {pkg} mcp</code><button type="button" class="hcopy" data-copy={`claude mcp add levni -- npx -y ${pkg} mcp`}>Copy</button></div>
        <p class="or">or <a href="/editor/">open the editor</a>, no install, no sign-up · <a href="/mcp/#setup">setup for every client</a></p>
        <div class="dots" aria-hidden="true"><i style="background:var(--pink)"></i><i style="background:var(--orange)"></i><i style="background:var(--sky)"></i><i style="background:var(--sun)"></i><i style="background:var(--sun)"></i><i style="background:#E8522F"></i><i style="background:var(--lilac)"></i></div>
      </div>
      <div class="stage">
        <div class="dotgrid" aria-hidden="true">{Array.from({ length: 21 }, (_, n) => <i style={`background:${['#E8522F','#F28C38','#F7C744','#58C4F6','#E66BF0','#F3C2F5','#F7C744'][(n * 5 + (n >> 2)) % 7]}`} />)}</div>
        <div class="screen" role="img" aria-label="A tulip drawn live in ASCII characters, the way Levni's glyph fill draws">
          <div class="bar"><span>LEVNI / GLYPHFILL · <span id="ascii-mode">"mode": "char"</span></span><span><b>●</b> <span id="ascii-state">live</span></span></div>
          <button type="button" class="glyph-btn" id="ascii-next" aria-label="Change the glyphs of the ASCII drawing">change glyphs ↻</button>
          <pre id="ascii" aria-hidden="true"></pre>
        </div>
        <div class="block" aria-hidden="true"><Logo size={200} tone="lime" class="block-mark" /></div>
        <div class="notch" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <section class="stats" aria-label="Levni in numbers">
    <div class="wrap stats-row">
      <div><b data-count="0.15" data-dec="2" data-suffix=" s">0.15 s</b><span>a cover on a laptop</span></div>
      <div><b data-count={SITE.props}>{SITE.props.toLocaleString('en')}</b><span>drawings in the folio</span></div>
      <div><b>$0</b><span>per image, forever <i class="wink">(we checked)</i></span></div>
      <div><b>MIT</b><span>code · CC BY 4.0 art</span></div>
    </div>
  </section>

  <div class="ticker" aria-hidden="true"><div class="ticker-track">
    {[0, 1].map(() => ['No image model', 'No API key', 'No credits', '0.15 s a cover', 'MIT code', 'CC BY 4.0 drawings', 'Runs on your laptop', 'Same seed, same picture', 'Zero GPUs consulted', 'A post-AI center for designers', 'No credit card for a cover'].map((t) => <span>{t}</span>))}
  </div></div>

  <!-- 2. What it makes: the folio, bold -->
  <section id="makes" class="folio-band" aria-labelledby="makes-title">
    <div class="wrap">
      <div class="band-head">
        <div><p class="band-k">{'{'}the folio{'}'}</p><h2 id="makes-title">Things one JSON file turned into.</h2></div>
        <p>Twelve kinds of asset from the same JSON, each with a free maker: open it, change the example, download it. <a href="/make/">All free makers</a> · <a href="/gallery/">Gallery</a></p>
      </div>
      <ul class="fcards">
        {makes.map((m) => (
          <li><a class="fcard" href={m.href}>
            <span class="fimg"><img src={m.src} width="640" height="359" alt={m.alt} loading="lazy" decoding="async" /></span>
            <span class="fcap"><b>{m.label}</b><small>{m.text}</small></span>
          </a></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 2a. Manifesto: why this exists, for the people who come to make things -->
  <section class="mani" aria-labelledby="mani-title">
    <div class="wrap mani-grid">
      <div>
        <p class="kicker">{'{'}§ manifesto{'}'}</p>
        <h2 id="mani-title" class="mani-say"><span>We are not an AI company.</span><span>We are not against AI either.</span><span>We just draw, and leave the source open.</span></h2>
        <p class="mani-p">We are living in a Tulip Era: everything blooms, everything generates, every tool has a free trial. It looks like a golden age. For the creative process it might be the end of one. Levni is the other bet: a design commons, made by people who still like making things.</p>
        <p class="mani-cta"><a class="mani-btn" href="/manifesto/">Read the manifesto →</a> <a class="mani-link" href="/community/">or skip to joining</a></p>
      </div>
      <div class="mani-side">
        <p class="mani-k">what one small picture costs elsewhere</p>
        <ul class="mani-stack">
          <li><s>a credit card</s><span>for one cover</span></li>
          <li><s>an API key</s><span>for one sticker</span></li>
          <li><s>a subscription</s><span>for one palette</span></li>
          <li><s>a waitlist</s><span>for one poster</span></li>
          <li class="ours"><b>npx @levni/levni</b><span>all of it, $0</span></li>
        </ul>
        <p class="mani-foot">Inspired by our friend Berk Boz and <a href="https://medium.com/zero-bytes-foundation/what-if-we-imagined-a-studio-669f954a05f7">Zero Bytes Foundation</a>: consume, curate, cogitate, create.</p>
      </div>
    </div>
  </section>

  <!-- 1b. Brand boards, high on the page -->
  <section id="boards" class="boards wrap" aria-labelledby="boards-title">
    <div class="boards-head">
      <p class="kicker">Brand boards</p>
      <h2 id="boards-title">A whole brand board from four fields.</h2>
      <p>Name, tagline, a mark from the library and your inks. One call returns nine tiles: mark, wordmark, web page, palette, social card, tote, sticker, pattern and business card. The same spec always gives the same board.</p>
    </div>
    <div class="boards-grid">
      <a class="board-main" href="/gallery/#boards"><img src="/g/boards/01-feneri.webp" width="1200" height="800" alt={boardAlt} loading="lazy" decoding="async" /></a>
      <div class="boards-side">
        <p class="file">brand.json</p>
        <pre><code>{boardJson}</code></pre>
        <p class="run-label">Run it two ways</p>
        <pre class="run"><code>{`# command line
npx @levni/levni board brand.json board.png`}</code></pre>
        <p class="run-mcp">Or let the agent call <code>render_board</code> over MCP with the same four fields and get a preview back.</p>
        <p><a class="text-link" href="/blog/brand-board-generator/">How the brand board generator works</a> · <a class="text-link" href="/gallery/#boards">More boards</a></p>
      </div>
    </div>
    <ul class="board-more">
      {boardMore.map((b) => (<li><a href="/gallery/#boards"><img src={b.src} width="640" height="427" alt={b.alt} loading="lazy" decoding="async" /></a></li>))}
    </ul>
  </section>

  <!-- 2b. Posters: the red band -->
  <section class="poster-band" aria-labelledby="posters-title">
    <div class="wrap pb-wrap">
      <div class="pb-text">
        <p class="pb-k">{'{'}branding posters{'}'}</p>
        <h2 id="posters-title">One brand.json. Eight posters.</h2>
        <p>Give Levni a name, two colours and a mood. It returns a branding poster series, a nine-tile board and the sticker sheet, all in the same ink.</p>
        <a class="pb-link" href="/make/branding-posters/">Make a poster series →</a>
      </div>
      <a class="pb-art" href="/gallery/#posters"><img src="/features/poster-series.webp" width="1200" height="794" alt="Eight branding posters for a coffee roaster called Kumru, sharing one dove mark, inks and type" loading="lazy" decoding="async" /></a>
      <svg class="pb-burst" viewBox="-100 -100 200 200" aria-hidden="true">{Array.from({ length: 16 }, (_, n) => <line x1="0" y1="0" x2={(Math.cos(n * Math.PI / 8) * 96).toFixed(1)} y2={(Math.sin(n * Math.PI / 8) * 96).toFixed(1)} stroke="#D6E521" stroke-width="9" />)}<circle r="18" fill="#D6E521" /></svg>
    </div>
    <div class="stripes" aria-hidden="true"></div>
  </section>

  <!-- 2b. Motion: the same JSON, moving -->
  <section id="motion" class="motion-band" aria-labelledby="motion-title">
    <div class="wrap mb-wrap">
      <a class="mb-art" href="/banner/">
        <picture>
          <source media="(prefers-reduced-motion: reduce)" srcset="/features/motion-banner-still.webp" />
          <img src="/features/motion-banner.webp" width="800" height="400" alt="A README banner drawing itself: the repo name is typed letter by letter, a tulip pops into a yellow circle on a blue panel and floats, then the description slides in" loading="lazy" decoding="async" />
        </picture>
      </a>
      <div class="mb-text">
        <p class="mb-k">{'{'}new in 0.5{'}'}</p>
        <h2 id="motion-title">Same JSON. Now it moves.</h2>
        <p>Any scene loops as a GIF, an animated WebP or an MP4. Give an element <code>"motion": "float"</code> and it floats; a headline types itself; a camera pushes in. Same seed, same frames, no browser and no video tool.</p>
        <pre class="mb-code"><code>npx @levni/levni animate scene.json loop.gif</code></pre>
        <ul class="mb-links">
          <li><a href="/banner/">Make a moving README banner</a></li>
          <li><a href="/you/">Your year in code: a moving card from your GitHub</a></li>
          <li><a href="/shots/">Levni Shots: 25 ready-made loops, your words</a></li>
          <li><a href="/motion/">Motion catalogue: every preset, with its JSON</a></li>
          <li><a href="/docs/animation/">Animation guide</a></li>
          <li><a href="/tools/">Free tools: gradients, patterns, waves, OG images</a></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 2. The library, moving: breadth before any explanation -->
  <section class="marquee" aria-label="Drawings from the library">
    {[rowA, rowB].map((row, r) => (
      <div class:list={['track', { reverse: r === 1 }]}>
        {[...row, ...row].map((name, i) => (
          <a href={`/library/?q=${name}`} tabindex={i >= row.length ? -1 : undefined} aria-hidden={i >= row.length ? 'true' : undefined}>
            <img src={`/props/${name}-0.webp`} width="240" height="240" alt={i < row.length ? name.replace(/-/g, ' ') : ''} loading="lazy" decoding="async" />
          </a>
        ))}
      </div>
    ))}
    <p class="marquee-note wrap">{SITE.props.toLocaleString("en")} drawings, {SITE.variants.toLocaleString("en")} variants, {shelfCount} shelves: tech, money, food, health, people, film, nature and more. <a href="/library/">Open the library</a></p>
  </section>

  <!-- 3. The one interaction: any drawing, any inks -->
  <section id="inks" class="inks wrap" aria-labelledby="inks-title">
    <div class="inks-text">
      <h2 id="inks-title">Your colours, every drawing.</h2>
      <p>
        A scene names its inks once. Switch them and the whole library follows: every prop, panel and texture.
