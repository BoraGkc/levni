<script>
  // --- inks demo: same swap the engine does, on the per-variant SVGs
  const inks = await fetch('/inks.json').then((r) => r.json()).catch(() => null) as null | { house: Record<string, string>; packs: Record<string, Record<string, string>> };
  const presets: Record<string, Record<string, string>> = {
    riso: {},
    miniature: inks?.packs.miniature ?? {},
    forest: { ink: '#1F3B2C', blue: '#2F6B4F', coral: '#D9783A', mustard: '#E8B64C', green: '#6E9B3A', tone: '#9CC5A8', 'tone-coral': '#F0B892', 'tone-mustard': '#F3D9A0', paper: '#F3EFE3' },
    night: { ink: '#F4F2EC', blue: '#3D5AFE', coral: '#FF6B8A', mustard: '#FFD166', green: '#06D6A0', tone: '#5468C9', 'tone-coral': '#B3536A', 'tone-mustard': '#B39548', paper: '#14181F', white: '#232A36', dark: '#F4F2EC' },
    mono: { ink: '#1A1A1A', blue: '#3A3A3A', coral: '#8A8A8A', mustard: '#C8C8C8', green: '#5A5A5A', dark: '#111111', tone: '#BDBDBD', 'tone-coral': '#D6D6D6', 'tone-green': '#A8A8A8', 'tone-mustard': '#E4E4E4', paper: '#F5F5F3' },
  };
  const imgs = [...document.querySelectorAll<HTMLImageElement>('.inks-grid img')];
  const tiles = new Map(imgs.map((i) => [i, i.src]));
  const cache = new Map<string, string>();
  const code = document.getElementById('inks-code')!;
  const brand = document.getElementById('brand') as HTMLInputElement;
  let urls: string[] = [];
  async function paint(map: Record<string, string>, label: string) {
    if (!inks) return;
    urls.forEach((u) => URL.revokeObjectURL(u));
    urls = [];
    const pairs = Object.entries(map).filter(([k]) => inks.house[k]).map(([k, v]) => [inks.house[k].toLowerCase(), v] as const);
    const lookup = new Map(pairs);
    const re = pairs.length ? new RegExp(`(${[...lookup.keys()].join('|')})(?![0-9a-f])`, 'gi') : null;
    await Promise.all(imgs.map(async (img) => {
      if (!re) { img.src = tiles.get(img)!; return; }
      const src = img.dataset.svg!;
      if (!cache.has(src)) cache.set(src, await (await fetch(src)).text());
      const url = URL.createObjectURL(new Blob([cache.get(src)!.replace(re, (m) => lookup.get(m.toLowerCase()) || m)], { type: 'image/svg+xml' }));
      urls.push(url);
      img.src = url;
    }));
    code.textContent = `{ "style": ${label}, "elements": [ … ] }`;
  }
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chips button')];
  chips.forEach((b) => b.addEventListener('click', () => {
    chips.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    const p = b.dataset.pack!;
    paint(presets[p], p === 'riso' || p === 'miniature' ? `"${p}"` : JSON.stringify(Object.fromEntries(Object.entries(presets[p]).slice(0, 2))).replace('}', ', … }'));
  }));
  brand.addEventListener('input', () => {
    chips.forEach((x) => x.setAttribute('aria-pressed', 'false'));
    const hex = brand.value.toUpperCase();
    paint({ blue: hex, ink: hex }, `{ "blue": "${hex}", "ink": "${hex}" }`);
  });

  // --- client tabs, arrow keys move between them
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.tabs [role=tab]')];
  const select = (t: HTMLButtonElement) => {
    tabs.forEach((x) => {
      const on = x === t;
      x.setAttribute('aria-selected', String(on));
      x.tabIndex = on ? 0 : -1;
      document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !on;
    });
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!d) return;
      const n = tabs[(i + d + tabs.length) % tabs.length];
      select(n);
      n.focus();
    });
  });
  document.querySelectorAll<HTMLButtonElement>('.copy').forEach((b) => b.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(b.dataset.copy!); b.textContent = 'Copied'; } catch { b.textContent = 'Select and copy'; }
    setTimeout(() => (b.textContent = 'Copy'), 1600);
  }));
</script>


<script>
  // --- hero: a tulip drawn live in characters (the same idea as the glyphfill element)
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const pre = document.getElementById('ascii') as HTMLPreElement;
  const COLS = 46, ROWS = 27;
  const MODES: [string, string][] = [['char', ' .:-=+*#%@'], ['block', ' ░░▒▒▓▓██'], ['dot', ' .,:;oO0@'], ['binary', ' .01010101'], ['name', ' .levniLEVNI']];
  let mi = 0, RAMP = MODES[0][1];
  function tulipMask(cols: number, rows: number, aspect: number) {
    const W = cols * 4, H = Math.round(rows * 4 * aspect);
    const c = document.createElement('canvas'); c.width = W; c.height = H;
    const g = c.getContext('2d')!;
    const s = Math.min(W / 74, H / 104);
    g.translate(W * 0.6, H * 0.03 + 5 * s); g.scale(s, s);
    g.lineCap = 'round'; g.strokeStyle = 'rgba(255,255,255,.55)'; g.lineWidth = 3.2;
    g.beginPath(); g.moveTo(0, 46); g.bezierCurveTo(-2, 64, 3, 78, 0, 96); g.stroke();
    g.fillStyle = 'rgba(255,255,255,.6)';
    g.beginPath(); g.moveTo(0, 90); g.bezierCurveTo(-10, 78, -30, 70, -34, 54); g.bezierCurveTo(-20, 60, -6, 70, 0, 84); g.fill();
    g.beginPath(); g.moveTo(1, 94); g.bezierCurveTo(12, 84, 26, 80, 30, 64); g.bezierCurveTo(18, 70, 8, 78, 1, 88); g.fill();
    const grd = g.createRadialGradient(-6, 18, 2, 0, 26, 30);
    grd.addColorStop(0, 'rgba(255,255,255,1)'); grd.addColorStop(0.6, 'rgba(255,255,255,.85)'); grd.addColorStop(1, 'rgba(255,255,255,.45)');
    g.fillStyle = grd; g.beginPath();
    g.moveTo(-24, 2); g.lineTo(-13, 16); g.lineTo(-7, -4); g.lineTo(0, 13); g.lineTo(7, -4); g.lineTo(13, 16); g.lineTo(24, 2);
    g.bezierCurveTo(29, 26, 22, 44, 0, 50); g.bezierCurveTo(-22, 44, -29, 26, -24, 2); g.fill();
    g.strokeStyle = 'rgba(0,0,0,.55)'; g.lineWidth = 1.4;
    g.beginPath(); g.moveTo(-6, 6); g.bezierCurveTo(-8, 24, -6, 38, -1, 46); g.stroke();
    g.beginPath(); g.moveTo(6, 6); g.bezierCurveTo(8, 24, 6, 38, 1, 46); g.stroke();
    const d = g.getImageData(0, 0, W, H).data, out: number[][] = [], cw = W / cols, ch = H / rows;
    for (let y = 0; y < rows; y++) { const row: number[] = []; for (let x = 0; x < cols; x++) {
      let sum = 0, n = 0;
      for (let yy = 0; yy < ch; yy += 2) for (let xx = 0; xx < cw; xx += 2) { const i = (Math.floor(y * ch + yy) * W + Math.floor(x * cw + xx)) * 4; sum += d[i] * d[i + 3] / 255; n++; }
      row.push(sum / n / 255); } out.push(row); }
    return out;
  }
  if (pre) {
    const mask = tulipMask(COLS, ROWS, 1.92);
    const noise = mask.map((r) => r.map(() => Math.random()));
    let mx = -99, my = -99;
    const frame = (now: number) => {
      const t = now / 1000, scan = (t * 9) % (ROWS + 24);
      let html = '';
      for (let y = 0; y < ROWS; y++) {
        let line = '', cls = '', run = '';
        for (let x = 0; x < COLS; x++) {
          let v = mask[y][x];
          const dx = x - mx, dy = (y - my) * 1.9, dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 7) v += (1 - dist / 7) * 0.55;
          let chr: string, c: string;
          if (!reduce && Math.abs(y - scan) < 1) { chr = v > 0.04 ? '█' : (Math.random() < 0.3 ? '░' : ' '); c = 'r'; }
          else if (v < 0.04) { chr = noise[y][x] > 0.985 ? '.' : ' '; c = 'l'; }
          else {
            const j = Math.max(0, Math.min(1, v + Math.sin(t * 1.6 + x * 0.35 + y * 0.22) * 0.07 + (noise[y][x] - 0.5) * 0.12));
            chr = RAMP[Math.min(RAMP.length - 1, 1 + Math.floor(j * (RAMP.length - 1)))];
            c = j > 0.86 ? 'r' : (j < 0.3 ? 'l' : '');
          }
          if (c !== cls) { if (run) line += cls ? `<span class="${cls}">${run}</span>` : run; run = ''; cls = c; }
          run += chr;
        }
        if (run) line += cls ? `<span class="${cls}">${run}</span>` : run;
        html += line + '\n';
      }
      pre.innerHTML = html;
    };
    const fit = () => { const r = pre.getBoundingClientRect(); pre.style.fontSize = Math.max(6, Math.min(r.height / (ROWS * 1.15), r.width / ((COLS + 2) * 0.6))).toFixed(2) + 'px'; };
    fit(); addEventListener('resize', fit); frame(0);
    let timer: number | undefined;
    if (!reduce) new IntersectionObserver((es) => es.forEach((e) => {
      if (e.isIntersecting && !timer) timer = window.setInterval(() => frame(performance.now()), 70);
      if (!e.isIntersecting) { clearInterval(timer); timer = undefined; }
    })).observe(pre);
    pre.addEventListener('pointermove', (e) => {
      const r = pre.getBoundingClientRect();
      mx = (e.clientX - r.left) / (r.width / COLS) - 1; my = (e.clientY - r.top) / parseFloat(getComputedStyle(pre).lineHeight);
      if (reduce) frame(0);
    });
    pre.addEventListener('pointerleave', () => { mx = my = -99; if (reduce) frame(0); });
    const modeEl = document.getElementById('ascii-mode')!;
    const next = () => { mi = (mi + 1) % MODES.length; RAMP = MODES[mi][1]; modeEl.textContent = `"mode": "${MODES[mi][0]}"`; frame(performance.now()); };
    document.getElementById('ascii-next')!.addEventListener('click', next);
    pre.addEventListener('click', next);
  }

  // --- numbers count up once, when the strip scrolls into view (the final values are already in the HTML)
  if (!reduce) {
    const nums = [...document.querySelectorAll<HTMLElement>('[data-count]')];
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      io.unobserve(e.target);
      const el = e.target as HTMLElement, to = +el.dataset.count!, dec = +(el.dataset.dec || 0), suf = el.dataset.suffix || '', t0 = performance.now();
      const step = (now: number) => {
        const p = Math.min(1, (now - t0) / 1100), v = to * (1 - Math.pow(1 - p, 3));
        el.textContent = (dec ? v.toFixed(dec) : Math.round(v).toLocaleString('en')) + suf;
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }), { threshold: 0.6 });
    nums.forEach((n) => io.observe(n));
  }

  document.querySelectorAll<HTMLButtonElement>('.hcopy').forEach((b) => b.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(b.dataset.copy!); b.textContent = 'Copied'; } catch { b.textContent = 'Select it'; }
    setTimeout(() => (b.textContent = 'Copy'), 1600);
  }));

  // --- the scene ticket: JSON, CLI or MCP, typed line by line
  const codeEl = document.getElementById('scene-code') as HTMLPreElement;
  if (codeEl) {
    const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;');
    const paint = (l: string) => esc(l).replace(/("[^"]*")(\s*:)/g, '<span class="key">$1</span>$2').replace(/:\s*("[^"]*")/g, ': <span class="str">$1</span>');
    const views: Record<string, string[]> = {
      json: codeEl.dataset.scene!.split('\n'),
      cli: ['# render, then read the critic', 'npx @levni/levni render scene.json cover.webp', '', '- critic: no layout problems found', '  0.15 s · cover.webp 1200 × 673', '', '# the same scene as SVG, or a story crop', 'npx @levni/levni render scene.json cover.svg', 'npx @levni/levni render scene.json --format story'],
      mcp: ['# ask your agent in plain words', '"Illustrate this article with Levni', ' and fix what the critic reports."', '', '→ scene_guide', '→ list_props  rocket, crowd, sunburst', '→ render_scene  preview + 1 note', '→ render_scene  no layout problems found', '✓ saved cover.webp'],
    };
    let timer: number | undefined;
    const show = (k: string, typed: boolean) => {
      document.querySelectorAll('.stabs button').forEach((b) => b.setAttribute('aria-selected', String((b as HTMLElement).dataset.tab === k)));
      const lines = views[k];
      const render = (n: number) => { codeEl.innerHTML = lines.slice(0, n).map((l, i) => `<span class="ln">${i + 1}</span>${k === 'json' ? paint(l) : (l.startsWith('#') ? `<span class="cm">${esc(l)}</span>` : esc(l))}`).join('\n') + (n < lines.length || typed ? ' <span class="caret"></span>' : ''); };
      clearTimeout(timer);
      if (!typed || reduce) return render(lines.length);
      let n = 0; const step = () => { render(n); if (n++ < lines.length) timer = window.setTimeout(step, k === 'json' ? 55 : 120); }; step();
    };
    show('json', false);
    document.querySelectorAll<HTMLButtonElement>('.stabs button').forEach((b) => b.addEventListener('click', () => show(b.dataset.tab!, true)));
    new IntersectionObserver((es, o) => { if (es[0].isIntersecting) { show('json', true); o.disconnect(); } }, { threshold: 0.35 }).observe(codeEl);
  }
</script>

<style>
  section { margin-top: clamp(80px, 11vw, 140px); }
  h2 { font-size: clamp(2.1rem, 4.4vw, 3.3rem); letter-spacing: -0.02em; max-width: 18ch; text-wrap: balance; }
  .btn {
    display: inline-flex; align-items: center; gap: 8px; padding: 13px 22px; border: 1px solid var(--rule); color: var(--ink);
    text-decoration: none; font-size: 1.02rem; font-weight: 600; background: transparent; border-radius: 0;
    transition: background-color 0.2s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s, transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .btn:hover { background: var(--indigo); color: var(--paper); }
  .btn:active { transform: translateY(1px); }
  .btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  .btn-primary:hover { background: var(--indigo); border-color: var(--ink); color: #fff; }
  .ctas { display: flex; gap: 12px; flex-wrap: wrap; }
  .text-link { font-weight: 600; }

  /* hero: centred promise, then a slow reel of real outputs */
  .hero { margin-top: clamp(44px, 7vw, 88px); }
  .hero-head { text-align: center; max-width: 880px; }
  .pill { display: inline-flex; align-items: center; gap: 8px; font-size: 0.88rem; font-weight: 500; color: var(--ink-soft); border: 1px solid var(--rule); background: var(--paper-2); border-radius: 0; padding: 6px 14px; margin: 0 0 22px; }
  .pill .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 3px rgba(30, 120, 63, 0.18); }
  .hero h1 { font-size: clamp(2.6rem, 6.4vw, 5.2rem); line-height: 1.02; letter-spacing: -0.03em; text-wrap: balance; margin: 0 auto 20px; }
  .hero h1 em { font-style: normal; color: var(--accent); }
  .hero .lede { font-size: clamp(1.08rem, 1.6vw, 1.25rem); color: var(--ink-soft); max-width: 640px; margin: 0 auto 28px; text-wrap: pretty; }
  .ctas { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .hero .facts { margin: 22px auto 0; font-size: 0.92rem; color: var(--ink-soft); }
  .hero .facts a { font-weight: 600; }
  .reel { margin-top: clamp(40px, 6vw, 64px); overflow: hidden; padding: 6px 0 22px;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  .reel-track { display: flex; gap: 22px; width: max-content; animation: reel 70s linear infinite; }
  .reel:hover .reel-track, .reel:focus-within .reel-track { animation-play-state: paused; }
  @keyframes reel { to { transform: translateX(calc(-50% - 11px)); } }
  .card { position: relative; display: block; width: clamp(260px, 30vw, 420px); flex: none; border: 1px solid var(--rule); background: var(--paper-2); box-shadow: none; text-decoration: none; transition: transform 0.25s ease, box-shadow 0.25s ease; }
  .card:hover, .card:focus-visible { transform: translateY(-4px); box-shadow: none; }
  .card img { width: 100%; height: auto; aspect-ratio: 640 / 359; object-fit: cover; }
  .card-label { position: absolute; left: 10px; bottom: 10px; font-size: 0.8rem; font-weight: 600; color: var(--ink); background: rgba(251, 250, 246, 0.94); border: 1px solid var(--ink); border-radius: 0; padding: 3px 10px; }
  @media (max-width: 400px) { .pill { font-size: 0.8rem; padding: 5px 11px; } }
  @media (prefers-reduced-motion: reduce) {
    .reel { overflow-x: auto; -webkit-mask-image: none; mask-image: none; scroll-snap-type: x mandatory; }
    .reel-track { animation: none; padding: 0 20px; }
    .card { scroll-snap-align: start; }
    .card[aria-hidden='true'] { display: none; }
  }

  /* marquee: the authored motion moment */
  .marquee { margin-top: clamp(64px, 8vw, 104px); overflow: hidden; border-block: 1px solid var(--rule); padding: 18px 0 0; background: var(--paper-2); }
  .track { display: flex; gap: 14px; width: max-content; animation: drift 70s linear infinite; }
  .track.reverse { animation-direction: reverse; animation-duration: 82s; margin-top: 14px; }
  .marquee:hover .track { animation-play-state: paused; }
  .track a { display: block; flex: none; width: 132px; border: 1.5px solid var(--rule); background: #f4f2ec; transition: border-color 0.2s, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1); }
  .track a:hover { border-color: var(--ink); transform: translateY(-4px) rotate(-2deg); }
  .track img { width: 100%; aspect-ratio: 1; }
  .marquee-note { margin: 18px auto; color: var(--ink-soft); font-size: 0.98rem; }
  @keyframes drift { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; overflow-x: auto; width: auto; }
  }

  /* inks */
  .inks { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
  .inks-text p { color: var(--ink-soft); font-size: 1.12rem; max-width: 46ch; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 26px 0 18px; }
  .chips button, .brand-pick {
    font: inherit; font-size: 0.95rem; padding: 8px 16px; border-radius: 0; border: 1.5px solid var(--rule); background: var(--paper-2);
    color: var(--ink); cursor: pointer; display: inline-flex; align-items: center; gap: 8px; transition: border-color 0.15s, background-color 0.15s;
  }
  .chips button:hover, .brand-pick:hover { border-color: var(--ink); }
  .chips button[aria-pressed='true'] { background: var(--indigo); color: var(--paper); border-color: var(--ink); }
  .sw { display: inline-flex; }
  .sw i { width: 12px; height: 12px; border-radius: 50%; border: 1.5px solid var(--paper-2); margin-left: -4px; }
  .sw i:first-child { margin-left: 0; }
  .chips button[aria-pressed='true'] .sw i { border-color: var(--ink); }
  .brand-pick input { width: 22px; height: 22px; padding: 0; border: 0; background: none; cursor: pointer; }
  .inks-code { margin: 0; font-size: 0.82rem; white-space: pre-wrap; overflow-wrap: anywhere; min-height: 3.2em; }
  .inks-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .inks-grid li { border: 1.5px solid var(--indigo); background: #f4f2ec; }
  .inks-grid img { width: 100%; aspect-ratio: 1; }

  /* how */
  .how-grid { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(24px, 4vw, 48px); margin-top: 36px; align-items: start; }
  .file { font-family: var(--mono); font-size: 0.8rem; color: var(--ink-soft); margin: 0 0 8px; }
  .how-code pre { margin: 0; font-size: 0.8rem; background: var(--indigo); color: #e9ecf4; border-color: var(--ink); }
  .how-out img { width: 100%; border: 1px solid var(--rule); }
  .critic { margin: 12px 0 0; font-size: 0.84rem; }
  .steps { padding-left: 1.2em; margin: 26px 0 0; color: var(--ink-soft); }
  .steps li { margin-bottom: 10px; padding-left: 4px; }
  .steps strong { color: var(--ink); }

  /* brand boards */
  .boards { margin-top: clamp(64px, 8vw, 104px); }
  .kicker { font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent-text); margin: 0 0 10px; }
  .boards-head p:last-child { color: var(--ink-soft); font-size: 1.12rem; max-width: 62ch; }
  .boards-grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 48px); margin-top: 30px; align-items: start; }
  .board-main { display: block; border: 1px solid var(--rule); box-shadow: none; background: var(--paper-2); }
  .board-main img { width: 100%; height: auto; display: block; }
  .boards-side { min-width: 0; }
  @media (max-width: 520px) { .boards-side pre { font-size: 0.72rem; } }
  .boards-side pre { margin: 0 0 14px; font-size: 0.82rem; white-space: pre; overflow-x: auto; max-width: 100%; }
  .run-label { font-weight: 600; margin: 18px 0 6px; }
  .run-mcp { color: var(--ink-soft); }
  .board-more { list-style: none; padding: 0; margin: 28px 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .board-more img { width: 100%; height: auto; border: 1px solid var(--rule); background: var(--paper-2); display: block; }
  .board-more a:hover img { box-shadow: none; }

  /* what it makes */
  .makes { margin-top: clamp(64px, 8vw, 104px); }
  .assets { list-style: none; padding: 0; margin: 32px 0 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 22px 18px; }
  .assets h3 a { color: inherit; text-decoration: none; }
  .assets h3 a:hover { text-decoration: underline; }
  .assets li { min-width: 0; }
  .assets img { aspect-ratio: 16 / 9; }
  .assets img { width: 100%; height: auto; object-fit: cover; border: 1px solid var(--rule); background: var(--paper-2); }
  .assets a:hover img { box-shadow: none; }
  .assets h3 { font-size: 1.15rem; margin: 12px 0 4px; }
  .assets p { margin: 0; color: var(--ink-soft); font-size: 0.95rem; }
  @media (max-width: 900px) { .assets { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .assets { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 12px; } .assets p { font-size: 0.88rem; } }
  .split-head { display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; }
  .split-head h2 { margin: 0; }
  .split-head p { margin: 0; color: var(--ink-soft); max-width: 40ch; }
  .mosaic { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-top: 32px; }
  .mosaic figure { margin: 0; position: relative; }
  .mosaic .big { grid-column: span 2; grid-row: span 2; }
  .mosaic figure:nth-child(6), .mosaic figure:nth-child(7) { grid-column: span 2; }
  .mosaic figure:nth-child(6) img, .mosaic figure:nth-child(7) img { aspect-ratio: 16 / 7; }
  .mosaic img { width: 100%; height: 100%; object-fit: cover; border: 1px solid var(--rule); }
  .mosaic figcaption { position: absolute; left: 10px; bottom: 10px; background: var(--paper); border: 1.5px solid var(--indigo); padding: 2px 10px; font-size: 0.85rem; border-radius: 0; }

  /* agents */
  .agents { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(32px, 5vw, 64px); align-items: center; }
  .agents-text p { color: var(--ink-soft); font-size: 1.12rem; }
  .tools { display: grid; grid-template-columns: auto 1fr; gap: 10px 16px; margin: 26px 0; }
  .tools dt code { font-size: 0.85rem; color: var(--accent-text); }
  .tools dd { margin: 0; color: var(--ink-soft); }
  .term { background: var(--indigo); color: #e9ecf4; padding: 10px; border-radius: 0; box-shadow: 0 30px 60px -30px rgba(20, 24, 31, 0.55); }
  .tabs { display: flex; flex-wrap: wrap; gap: 4px; padding: 4px; }
  .tabs button { font: inherit; font-size: 0.9rem; color: #b9c0cf; background: none; border: 0; padding: 8px 12px; border-radius: 0; cursor: pointer; }
  .tabs button:hover { color: #fff; }
  .tabs button[aria-selected='true'] { background: rgba(255, 255, 255, 0.12); color: #fff; }
  .panel { background: #1d222c; border-radius: 0; margin-top: 6px; }
  .panel-head { display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); font-family: var(--mono); font-size: 0.78rem; color: #9aa3b5; }
  .copy { font: inherit; font-family: var(--sans, inherit); font-size: 0.82rem; color: #fff; background: var(--accent); border: 0; border-radius: 0; padding: 5px 12px; cursor: pointer; }
  .copy:hover { background: #2f6fe0; }
  .panel pre { background: none; border: 0; color: #e9ecf4; margin: 0; font-size: 0.86rem; white-space: pre-wrap; overflow-wrap: anywhere; }
  .term-note { margin: 12px 8px 6px; font-size: 0.92rem; color: #b9c0cf; }

  /* blog */
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-top: 28px; }

  /* close */
  .close { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: clamp(32px, 5vw, 64px); align-items: center; background: var(--accent); color: #fff; padding: clamp(28px, 5vw, 60px); border-radius: 0; }
  .close h2 { color: #fff; }
  .close p { color: #dfe7fb; font-size: 1.1rem; max-width: 52ch; margin-bottom: 28px; }
  .close code { background: rgba(255, 255, 255, 0.14); padding: 1px 6px; border-radius: 0; white-space: nowrap; }
  .close .btn { border-color: #fff; color: #fff; }
  .close .btn:hover { background: #fff; color: var(--ink); }
  .close .btn-primary { background: var(--mustard); border-color: var(--mustard); color: var(--ink); }
  .close .btn-primary:hover { background: #fff; border-color: #fff; }
  .close-art { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .close-art img { width: 100%; border-radius: 0; border: 1px solid var(--rule); background: #f4f2ec; }
  .close-art img:nth-child(odd) { transform: rotate(-3deg); }
  .close-art img:nth-child(even) { transform: rotate(2.5deg) translateY(8px); }

  /* faq */
  .faq-cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 40px; margin-top: 24px; }
  .faq details { border-bottom: 1px solid var(--rule); padding: 16px 0; }
  .faq summary { font-family: var(--display); font-size: 1.2rem; font-weight: 600; cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 16px; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; font-family: var(--serif); font-weight: 400; color: var(--accent); transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1); }
  .faq details[open] summary::after { transform: rotate(45deg); }
  .faq details p { margin: 10px 0 0; color: var(--ink-soft); }

  @media (max-width: 960px) {
    .inks, .how-grid, .agents, .close, .boards-grid { grid-template-columns: minmax(0, 1fr); }
    .cards { grid-template-columns: minmax(0, 1fr); }
    .faq-cols { grid-template-columns: minmax(0, 1fr); }
    .mosaic { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 520px) {
    .track a { width: 96px; }
    .how-code pre, .critic { font-size: 0.74rem; }
    .close-art { display: none; }
    .chips button, .brand-pick { padding: 7px 12px; font-size: 0.9rem; }
    .inks-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .mosaic .big { grid-column: span 2; grid-row: auto; }
    .close-art { grid-template-columns: repeat(3, 1fr); }
  }
  .hero-try :global(.try-row) { justify-content: center; }

  /* ===== 2026 rebrand: indigo hero, folio band, scene ticket, poster band ===== */
  .hero { margin-top: 0; background: var(--indigo); color: var(--on-indigo); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 40px; padding-top: 40px; padding-bottom: 96px; align-items: center; }
  .hero-k { margin: 0; font: 500 0.75rem/1.4 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--lime); }
  .hero h1 { color: var(--on-indigo); font-weight: 400; font-size: clamp(2.9rem, 6.6vw, 6rem); line-height: 0.95; letter-spacing: -0.045em; margin: 18px 0 22px; max-width: 12ch; }
  .hero-sub { margin: 0 0 14px; font-weight: 500; font-size: clamp(1.25rem, 2vw, 1.6rem); line-height: 1.2; letter-spacing: -0.02em; color: var(--lime); max-width: 26ch; }
  .hero .lede { font-size: 1.06rem; line-height: 1.6; max-width: 46ch; color: var(--mute-indigo); margin: 0 0 28px; }
  .install { display: flex; background: #fff; max-width: 470px; clip-path: polygon(0 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%); }
  .install code { flex: 1; min-width: 0; padding: 16px 18px; font-size: 0.88rem; color: var(--indigo); overflow-x: auto; white-space: nowrap; }
  .install code::before { content: '$ '; color: var(--red); }
  .hcopy { border: 0; background: var(--lime); color: var(--indigo); font: 600 0.74rem/1 var(--mono); letter-spacing: 0.1em; text-transform: uppercase; padding: 0 20px; margin: 4px; cursor: pointer; }
  .hcopy:hover { background: var(--indigo); color: var(--lime); }
  .or { font: 0.76rem/1.6 var(--mono); color: var(--mute-indigo); margin: 14px 0 0; }
  .or a { color: #fff; }
  .or a:hover { color: var(--lime); }
  .dots { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 44px; }
  .dots i, .dotgrid i { width: 14px; height: 14px; border-radius: 50%; display: block; }
  .stage { position: relative; width: 100%; max-width: 540px; justify-self: end; aspect-ratio: 1 / 1.02; }
  .dotgrid { position: absolute; right: 0; top: 0; display: grid; grid-template-columns: repeat(7, 14px); gap: 18px; }
  .screen { position: absolute; right: 0; top: 96px; bottom: 9%; width: 84%; background: #fff; overflow: hidden; clip-path: polygon(0 0, 100% 0, 100% calc(100% - 26px), calc(100% - 26px) 100%, 0 100%); }
  .screen .bar { display: flex; justify-content: space-between; padding: 10px 14px; font: 500 0.66rem/1.4 var(--mono); letter-spacing: 0.06em; color: var(--indigo); border-bottom: 1px solid #e4e0f7; }
  .screen .bar b { color: var(--red); font-weight: 500; }
  .screen pre { position: absolute; inset: 36px 0 0; margin: 0; padding: 0 0 0 1ch; border: 0; background-color: transparent; font: 500 12px/1.15 var(--mono); color: var(--indigo); white-space: pre; overflow: hidden; user-select: none; cursor: crosshair;
    background-image: repeating-linear-gradient(90deg, rgba(75, 47, 214, 0.12) 0 1px, transparent 1px 1ch); }
  .screen pre :global(.r) { color: var(--red); }
  .screen pre :global(.l) { color: #9c8deb; }
  .block { position: absolute; left: 0; bottom: 0; width: 34%; aspect-ratio: 1; background: var(--lime); display: grid; place-items: center; clip-path: polygon(18px 0, 100% 0, 100% 100%, 0 100%, 0 18px); }
  .block :global(.block-mark) { width: 92%; height: auto; }
  .notch { position: absolute; left: 34%; bottom: 23%; width: 11%; aspect-ratio: 1; background: var(--indigo); }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr); padding-top: 24px; padding-bottom: 64px; }
    .stage { justify-self: center; }
  }

  .stats { margin-top: 0; background: var(--paper); }
  .stats-row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .stats-row > div { padding: 30px 20px; border-left: 1px solid var(--rule); }
  .stats-row > div:first-child { border-left: 0; padding-left: 0; }
  .stats b { display: block; font-weight: 700; font-size: clamp(2rem, 3.6vw, 2.9rem); letter-spacing: -0.04em; color: var(--indigo); font-variant-numeric: tabular-nums; line-height: 1.1; }
  .stats span { font: 0.76rem/1.4 var(--mono); color: var(--ink-soft); }
  @media (max-width: 720px) {
    .stats-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stats-row > div:nth-child(3) { border-left: 0; padding-left: 0; }
    .stats-row > div:nth-child(n + 3) { border-top: 1px solid var(--rule); }
  }

  .folio-band { margin-top: 0; background: var(--indigo); color: var(--on-indigo); padding: clamp(64px, 8vw, 104px) 0; }
  .band-head { display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; margin-bottom: 36px; }
  .band-k { margin: 0 0 10px; font: 500 0.75rem/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--lime); }
  .folio-band h2 { color: #fff; margin: 0; max-width: 15ch; font-size: clamp(2.2rem, 4.8vw, 3.8rem); letter-spacing: -0.045em; }
  .band-head > p { margin: 0; max-width: 40ch; color: var(--mute-indigo); }
  .band-head a { color: var(--lime); }
  .fcards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .fcard { display: flex; flex-direction: column; height: 100%; background: #fff; color: var(--indigo); text-decoration: none; clip-path: polygon(0 0, 100% 0, 100% calc(100% - 20px), calc(100% - 20px) 100%, 0 100%); }
  .fimg { display: block; aspect-ratio: 16 / 10; overflow: hidden; }
  .fimg img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .fcard:hover img { transform: scale(1.04); }
  .fcard:hover { color: var(--indigo); }
  .fcap { display: flex; flex-direction: column; gap: 4px; padding: 16px 18px 22px; }
  .fcap b { font-size: 1.15rem; letter-spacing: -0.02em; }
  .fcap small { font: 0.76rem/1.45 var(--mono); color: var(--ink-soft); }
  @media (max-width: 900px) { .fcards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .fcards { grid-template-columns: minmax(0, 1fr); } }

  .how { margin-top: 0; background: var(--paper); padding: clamp(64px, 8vw, 104px) 0; }
  .how-grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 56px; align-items: start; margin-top: 0; }
  .how h2 { color: var(--indigo); max-width: 14ch; }
  .how h2 span { color: #9a8fd8; }
  .how-p { color: var(--ink-soft); max-width: 46ch; }
  .stabs { display: inline-flex; background: #e7e3f4; margin: 18px 0 26px; }
  .stabs button { border: 1px solid transparent; background: transparent; padding: 11px 22px; font: inherit; color: var(--ink-soft); cursor: pointer; }
  .stabs button[aria-selected='true'] { background: #fff; border-color: #d6d0ee; color: var(--indigo); }
  .out { display: flex; gap: 14px; align-items: center; }
  .out img { width: 170px; flex: none; clip-path: polygon(0 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%); }
  .out p { margin: 0; font: 0.76rem/1.6 var(--mono); color: var(--ink-soft); }
  .out b { color: var(--indigo); font-weight: 500; }
  .out .ok { color: var(--green); }
  .stamp { background: #fff; padding: 40px 28px; min-width: 0;
    -webkit-mask: radial-gradient(circle 14px at 50% 0, #0000 98%, #000) top / 56px 51% repeat-x, radial-gradient(circle 14px at 50% 100%, #0000 98%, #000) bottom / 56px 51% repeat-x;
