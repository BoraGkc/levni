---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../site';
import { getCollection } from 'astro:content';
import folio from '../data/props.json';
import CATEGORIES from '../data/categories.json';
import showcase from '../data/gallery.json';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const repo = SITE.github.replace('https://github.com/', '');
const pkg = `github:${repo}`;

// The marquee: two rows of real library tiles, picked across shelves so the breadth shows at a glance
const rowA = ['cat', 'rocket', 'bicycle', 'coffee-cup', 'person-laptop', 'piggy-bank', 'umbrella', 'camera', 'pizza-slice', 'lighthouse', 'headphones', 'trophy', 'sun', 'bank', 'guitar', 'ambulance', 'sailboat', 'robot'];
const rowB = ['battery', 'globe', 'stethoscope', 'house', 'two-people', 'pie-chart', 'film-reel', 'tulip', 'airplane', 'laptop', 'rainbow', 'scales', 'bell', 'potted-plant', 'dna', 'megaphone', 'tea-glass', 'location-pin'];
const shelfCount = Object.keys(CATEGORIES).length;

// The hero showcase: one strong image per look, each linking to its gallery tab (images from scripts/render-gallery.mjs)
const look = (group: string, id: string, label: string, note: string) => {
  const it = (showcase.items as { group: string; id: string; alt: string }[]).find((i) => i.group === group && i.id === id);
  return { group, label, note, big: `/g/${group}/${id}.webp`, small: `/g/${group}/${id}-s.webp`, alt: it?.alt ?? label };
};
const slides = [
  look('covers', 'cover-riso', 'Riso cover', 'hand-inked, misregistered plates'),
  look('soft3d', 'auto-01', 'Soft 3D cover', 'aqua, with a title and badge'),
  look('icons', 'row', '3D icons', 'any Folio drawing, extruded'),
  look('worlds', 'cafe-riso-2', 'Little world', 'one line: "preset": "cafe"'),
  look('pixel', 'grid-riso', 'Pixel icons', `${folio.filter((p) => p.name.startsWith('pixel-')).length} in four weights`),
  look('soft3d', 'auto-03', 'Soft 3D cover', 'mint night palette'),
  look('charts', 'bars', 'Hand-inked data', 'bars, lines, pies from numbers'),
  look('covers', 'garden-miniature', 'Miniature pack', 'Tulip Era colours'),
  look('worlds', 'city-soft', 'Little world, soft', 'toy 3D, pastel palette'),
  { group: 'formats', label: 'Every format', note: 'story, og, square, YouTube', big: '/g/formats/all.webp', small: '/g/formats/all-s.webp', alt: 'One scene recomposed as a tall story, an Open Graph card, a square post and a YouTube thumbnail, each with the headline “Launch week, in one picture”' },
];

// The recolour demo: real per-variant SVGs from /props-svg, recoloured in the browser like a style pack
const demo = [
  { name: 'rocket', v: 0 }, { name: 'person-laptop', v: 0 }, { name: 'cat', v: 0 },
  { name: 'coffee-cup', v: 0 }, { name: 'battery', v: 5 }, { name: 'bicycle', v: 0 },
];

// The real scene behind /gallery/cover-riso.webp (examples/cover.json)
const scene = `{
  "seed": 5,
  "clip": [60, 52, 1080, 569],
  "elements": [
    { "type": "panel",
      "color": "blue",
      "x": 60, "y": 52,
      "w": 1080, "h": 569 },
    { "type": "sunburst",
      "color": "mustard",
      "x": 780, "y": 300,
      "size": 420 },
    { "type": "prop",
      "name": "rocket",
      "x": 780, "y": 300,
      "size": 380, "rot": 20,
      "shadow": true },
    { "type": "crowd",
      "highlight": "coral",
      "x": 90, "y": 560,
      "w": 520, "rows": 2 },
    { "type": "label",
      "text": "Launch / Space",
      "x": 100, "y": 104,
      "color": "paper" }
  ]
}`;

const clients = [
  { id: 'claude-code', label: 'Claude Code', file: 'Terminal', code: `claude mcp add levni -- npx -y ${pkg} mcp` },
  { id: 'claude-desktop', label: 'Claude Desktop', file: 'claude_desktop_config.json', code: `{
  "mcpServers": {
    "levni": {
      "command": "npx",
      "args": ["-y", "${pkg}", "mcp"]
    }
  }
}` },
  { id: 'cursor', label: 'Cursor', file: '.cursor/mcp.json', code: `{
  "mcpServers": {
    "levni": {
      "command": "npx",
      "args": ["-y", "${pkg}", "mcp"]
    }
  }
}` },
  { id: 'vscode', label: 'VS Code', file: '.vscode/mcp.json', code: `{
  "servers": {
    "levni": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "${pkg}", "mcp"]
    }
  }
}` },
  { id: 'cli', label: 'CLI', file: 'Any agent with a shell', code: `npm install ${pkg}
npx levni list cat
npx levni render scene.json cover.png` },
];
const tools = [
  ['list_props', 'search the library by word, tag or shelf'],
  ['show_props', 'a contact sheet of drawings and their variants'],
  ['render_scene', 'draw a scene, return a preview and the critic’s notes'],
  ['critique_scene', 'only the notes, for quick iterations'],
  ['scene_guide', 'every element type, colour and style pack'],
];

const gallery = [
  { src: 'oa-hadeln', alt: 'A golden arched gate with open doors behind a row of faceless audience figures on a blue panel', cap: 'Film festival' },
  { src: 'oa-tahmin', alt: 'A roulette wheel struck by a judge’s gavel, halftone dots behind', cap: 'Prediction markets' },
  { src: 'oa-orman', alt: 'A cut tree stump on a blue panel full of glyphs, small trees on both sides', cap: 'Environment' },
  { src: 'oa-ice', alt: 'A film camera projecting onto a city block, an audience along the bottom', cap: 'Documentary' },
  { src: 'oa-venezuela', alt: 'A blue oil barrel beside a coral panel with a sun and a drop of oil', cap: 'Energy' },
  { src: 'oa-orna', alt: 'A microphone resting on a sofa on a blue panel with wave lines', cap: 'Culture' },
  { src: 'oa-delpy', alt: 'A white jacket with a coral overprint shadow on a blue panel', cap: 'Cinema and fashion' },
];

const faq = [
  { q: 'What is Levni?', a: `An open illustration library (${SITE.props} hand-inked drawings and growing) and the open-source engine that composes them into covers, spot illustrations, icons and social images, in one consistent style. It runs on Node with sharp; there is no image model and no API key.` },
  { q: 'Can I use the drawings on their own?', a: 'Yes. Browse the Library, pick a drawing and place it in a scene by name. The drawings are CC BY 4.0: free for commercial work with credit “drawings by Ortak Alan”.' },
  { q: 'How do AI agents use it?', a: 'An agent writes the scene JSON, renders it, and reads the layout critic’s notes (off-canvas elements, accidental crops, lopsided weight, no focal point) before a person looks. Because it is JSON in and image out, it maps directly onto an MCP tool.' },
  { q: 'What does it cost?', a: 'Nothing per image. Levni is MIT-licensed code that runs on your own machine or in CI. The Levni Folio drawings are CC BY 4.0: credit “drawings by Ortak Alan”.' },
  { q: 'Can it draw in my brand colours?', a: 'Yes. Set "style" to a map of your own inks, for example { "blue": "#6A1B9A", "mustard": "#00BFA5" }, and every drawing, panel and texture follows. Riso and miniature are the two built-in packs.' },
  { q: 'Is there an MCP server?', a: 'Yes: run npx levni mcp. It gives assistants five tools: the scene guide, library search, a contact sheet of props, render with preview, and the critic. Agents without MCP use the same engine through the CLI.' },
];

const jsonld = [
  {
    '@type': 'SoftwareApplication',
    name: 'Levni',
    applicationCategory: 'DesignApplication',
    operatingSystem: 'macOS, Linux, Windows (Node.js 20+)',
    description: SITE.description,
    url: `${SITE.url}/`,
    license: 'https://opensource.org/licenses/MIT',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@id': `${SITE.ortakAlan}/#organization` },
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];
const star = `<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z" fill="currentColor"/></svg>`;
---
<Base title="Levni" description={SITE.description} jsonld={jsonld}>
  <!-- 1. Hero: the promise and the picture -->
  <section class="hero wrap">
    <div class="hero-text">
      <h1>An open library of <em>hand-inked</em> illustrations.</h1>
      <p class="lede">
        {SITE.props.toLocaleString('en')} drawings in one hand, and an engine that turns a short JSON scene into riso covers,
        soft 3D covers and icons, little isometric worlds, pixel icons and hand-inked charts, in every social format.
        Your agent writes the scene. Levni draws it.
      </p>
      <div class="ctas">
        <a class="btn btn-primary" href="/library/">Browse {SITE.props.toLocaleString('en')} drawings</a>
        <a class="btn" href="#agents">Add it to Claude</a>
      </div>
      <ul class="facts">
        <li>No image model, no API key</li>
        <li>MIT code, CC BY 4.0 drawings</li>
        <li>Works with Claude, Codex, Cursor</li>
      </ul>
    </div>
    <div class="show" id="show" aria-roledescription="carousel" aria-label="What Levni draws">
      <div class="show-stage">
        {slides.map((sl, i) => (
          <figure class="slide" data-i={i} aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}: ${sl.label}`} data-active={i === 0 ? '' : undefined}>
            <div class="ph">{i === 0 ? (
              <img src={sl.big} srcset={`${sl.small} 640w, ${sl.big} 1200w`} sizes="(max-width: 960px) calc(100vw - 40px), 620px" width="1200" height="673" alt={sl.alt} fetchpriority="high" />
            ) : (
              <img data-srcset={`${sl.small} 640w, ${sl.big} 1200w`} sizes="(max-width: 960px) calc(100vw - 40px), 620px" width="1200" height="673" alt={sl.alt} decoding="async" />
            )}</div>
            <figcaption><a href={`/gallery/#${sl.group}`}>{sl.label}</a> <span>{sl.note}</span></figcaption>
          </figure>
        ))}
      </div>
      <div class="show-ctrl">
        <button type="button" class="show-play" aria-label="Pause the slideshow" data-playing="true"><span aria-hidden="true"></span></button>
        <div class="dots">
          {slides.map((sl, i) => (
            <button type="button" aria-label={`Show ${sl.label}${sl.note ? `: ${sl.note}` : ''}`} aria-current={i === 0 ? 'true' : undefined} data-go={i}></button>
          ))}
        </div>
        <a class="show-all" href="/gallery/">Open the gallery</a>
      </div>
    </div>
  </section>

  <!-- 2. The library, moving: breadth before any explanation -->
  <section class="marquee" aria-label="Drawings from the library">
    {[rowA, rowB].map((row, r) => (
      <div class:list={['track', { reverse: r === 1 }]}>
        {[...row, ...row].map((name, i) => (
          <a href={`/library/?q=${name}`} tabindex={i >= row.length ? -1 : undefined} aria-hidden={i >= row.length ? 'true' : undefined}>
            <img src={`/props/${name}-0.webp`} width="240" height="240" alt={i < row.length ? name.replace(/-/g, ' ') : ''} loading="lazy" decoding="async" />
          </a>
        ))}
      </div>
    ))}
    <p class="marquee-note wrap">{SITE.props} drawings, {SITE.variants} variants, {shelfCount} shelves: tech, money, food, health, people, film, nature and more. <a href="/library/">Open the library</a></p>
  </section>

  <!-- 3. The one interaction: any drawing, any inks -->
  <section id="inks" class="inks wrap" aria-labelledby="inks-title">
    <div class="inks-text">
      <h2 id="inks-title">Your colours, every drawing.</h2>
      <p>
        A scene names its inks once. Switch them and the whole library follows: every prop, panel and texture.
        Riso is the house look, miniature the first style pack, and your brand is one line of JSON.
      </p>
      <div class="chips" role="group" aria-label="Inks">
        <button type="button" data-pack="riso" aria-pressed="true"><span class="sw" aria-hidden="true"><i style="background:#0B57D0"></i><i style="background:#F2603F"></i><i style="background:#F2C230"></i></span>Riso</button>
        <button type="button" data-pack="miniature" aria-pressed="false"><span class="sw" aria-hidden="true"><i style="background:#1F3F8F"></i><i style="background:#C8402E"></i><i style="background:#C9962B"></i></span>Miniature</button>
        <button type="button" data-pack="forest" aria-pressed="false"><span class="sw" aria-hidden="true"><i style="background:#2F6B4F"></i><i style="background:#D9783A"></i><i style="background:#E8B64C"></i></span>Forest</button>
        <button type="button" data-pack="night" aria-pressed="false"><span class="sw" aria-hidden="true"><i style="background:#14181F"></i><i style="background:#3D5AFE"></i><i style="background:#FF6B8A"></i></span>Night</button>
        <button type="button" data-pack="mono" aria-pressed="false"><span class="sw" aria-hidden="true"><i style="background:#3A3A3A"></i><i style="background:#8A8A8A"></i><i style="background:#C8C8C8"></i></span>Mono</button>
        <label class="brand-pick"><input type="color" id="brand" value="#6A1B9A" /> <span>Your brand</span></label>
      </div>
      <pre class="inks-code"><code id="inks-code">{`{ "style": "riso", "elements": [ … ] }`}</code></pre>
    </div>
    <div class="inks-stage">
      <ul class="inks-grid">
        {demo.map((d) => (
          <li><img data-svg={`/props-svg/${d.name}-${d.v}.svg`} src={`/props/${d.name}-${d.v}.webp`} width="240" height="240" alt={d.name.replace(/-/g, ' ')} /></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4. How it works: the real scene next to its picture -->
  <section id="how" class="how wrap" aria-labelledby="how-title">
    <h2 id="how-title">Write a scene. Read the critic. Ship the cover.</h2>
    <div class="how-grid">
      <div class="how-code">
        <p class="file">scene.json</p>
        <pre><code>{scene}</code></pre>
      </div>
      <div class="how-out">
        <img src="/gallery/cover-riso.webp" width="800" height="449" alt="The rendered cover: a tilted rocket on a mustard sunburst over a blue panel, an audience along the bottom" loading="lazy" />
        <pre class="critic"><code>$ npx levni render scene.json \
    cover.webp
- critic: no layout problems found</code></pre>
        <ol class="steps">
          <li><strong>Place drawings</strong> on a 1200 × 673 canvas: props, panels, textures, crowds, small isometric rooms.</li>
          <li><strong>Render.</strong> Every line is inked, the plates misregister, the paper gets grain. Same seed, same picture.</li>
          <li><strong>Fix what the critic reports:</strong> off-canvas, accidental crops, lopsided weight, no focal point. Then ship PNG, SVG or WebP.</li>
        </ol>
      </div>
    </div>
  </section>

  <!-- 5. Proof: real covers -->
  <section id="gallery" class="gallery wrap" aria-labelledby="gallery-title">
    <div class="split-head">
      <h2 id="gallery-title">About 500 covers, one hand.</h2>
      <p>Ortak Alan draws every article image with Levni. A few of them. <a href="/blog/one-style-500-articles/">How they keep one style</a> · <a href="/gallery/">The full gallery</a></p>
    </div>
    <div class="mosaic">
      {gallery.map((g, i) => (
        <figure class:list={{ big: i === 0 }}>
          <img src={`/gallery/${g.src}.webp`} width="800" height="449" alt={g.alt} loading="lazy" />
          <figcaption>{g.cap}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- 6. Agents: copyable setup per client -->
  <section id="agents" class="agents wrap" aria-labelledby="agents-title">
    <div class="agents-text">
      <h2 id="agents-title">Give your agent an illustrator.</h2>
      <p>One MCP server, five tools (three more for Ghost). The agent searches the library, writes the scene, reads the critic and saves the file, without a person in the loop until the picture is right.</p>
      <dl class="tools">
        {tools.map(([name, what]) => (<><dt><code>{name}</code></dt><dd>{what}</dd></>))}
      </dl>
      <a class="text-link" href="/mcp/">MCP guide, tools and Ghost</a>
    </div>
    <div class="term">
      <div class="tabs" role="tablist" aria-label="Client">
        {clients.map((c, i) => (
          <button type="button" role="tab" id={`tab-${c.id}`} aria-controls={`panel-${c.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{c.label}</button>
        ))}
      </div>
      {clients.map((c, i) => (
        <div class="panel" role="tabpanel" id={`panel-${c.id}`} aria-labelledby={`tab-${c.id}`} hidden={i !== 0}>
          <div class="panel-head">
            <span>{c.file}</span>
            <button type="button" class="copy" data-copy={c.code}>Copy</button>
          </div>
          <pre><code>{c.code}</code></pre>
        </div>
      ))}
      <p class="term-note">Then ask: “Illustrate this article with Levni and fix what the critic reports.”</p>
    </div>
  </section>

  <!-- 7. Blog -->
  {posts.length > 0 && (
    <section class="latest wrap" aria-labelledby="latest-title">
      <div class="split-head">
        <h2 id="latest-title">Guides</h2>
        <p><a href="/blog/">All posts</a></p>
      </div>
      <div class="cards">{posts.slice(0, 3).map((p) => <PostCard post={p} />)}</div>
    </section>
  )}

  <!-- 8. Close: open source and the Folio -->
  <section id="folio" class="close wrap" aria-labelledby="close-title">
    <div class="close-text">
      <h2 id="close-title">Open, and growing every week.</h2>
      <p>
        The code is MIT. The drawings are CC BY 4.0: use them anywhere, commercially too, with credit “drawings by Ortak Alan”.
        Missing an object? Draw it as one JSON file of paths, check it with <code>npx levni check</code> and open a pull request.
      </p>
      <div class="ctas">
        <a class="btn btn-primary" href={SITE.github}><Fragment set:html={star} /> Star on GitHub</a>
        <a class="btn" href={`${SITE.github}/blob/main/CONTRIBUTING.md`}>Draw for the Folio</a>
      </div>
    </div>
    <div class="close-art" aria-hidden="true">
      {['person-standing', 'bell', 'lighthouse', 'pie-chart', 'pizza-slice', 'rainbow'].map((m) => <img src={`/props/${m}-0.webp`} alt="" width="240" height="240" loading="lazy" />)}
    </div>
  </section>

  <section class="faq wrap" aria-labelledby="faq-title">
    <h2 id="faq-title">Questions</h2>
    <div class="faq-cols">
      {faq.map(({ q, a }) => (
        <details>
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </section>
</Base>

<script>
  // --- hero showcase: cross-fade every 3.5 s, pause on hover or focus, dots and a pause button; reduced motion gets a static grid (CSS)
  {
    const root = document.getElementById('show')!;
    const slides = [...root.querySelectorAll<HTMLElement>('.slide')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('.dots button')];
    const play = root.querySelector<HTMLButtonElement>('.show-play')!;
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    const load = (k: number) => {
      const img = slides[k % slides.length].querySelector('img')!;
      if (img.dataset.srcset) { img.srcset = img.dataset.srcset; delete img.dataset.srcset; }
    };
    let at = 0, timer = 0, hold = false, paused = false;
    const go = (k: number) => {
      at = (k + slides.length) % slides.length;
      load(at); load(at + 1);
      slides.forEach((s, i) => { s.toggleAttribute('data-active', i === at); s.inert = i !== at; });
      dots.forEach((d, i) => (i === at ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
    };
    const tick = () => {
      clearTimeout(timer);
      if (!hold && !paused && !still.matches && !document.hidden) timer = window.setTimeout(() => { go(at + 1); tick(); }, 3500);
    };
    root.classList.add('js');
    if (still.matches) slides.forEach((_, i) => load(i));
    else { go(0); tick(); }
    dots.forEach((d) => d.addEventListener('click', () => { go(Number(d.dataset.go)); tick(); }));
    play.addEventListener('click', () => {
      paused = !paused;
      play.dataset.playing = String(!paused);
      play.setAttribute('aria-label', paused ? 'Play the slideshow' : 'Pause the slideshow');
      tick();
    });
    root.addEventListener('pointerenter', () => { hold = true; tick(); });
    root.addEventListener('pointerleave', () => { hold = false; tick(); });
    root.addEventListener('focusin', () => { hold = true; tick(); });
    root.addEventListener('focusout', (e) => { if (!root.contains(e.relatedTarget as Node)) { hold = false; tick(); } });
    document.addEventListener('visibilitychange', tick);
    still.addEventListener('change', () => { if (still.matches) slides.forEach((s, i) => { load(i); s.inert = false; }); else go(at); tick(); });
  }

  // --- inks demo: same swap the engine does, on the per-variant SVGs
  const inks = await fetch('/inks.json').then((r) => r.json()).catch(() => null) as null | { house: Record<string, string>; packs: Record<string, Record<string, string>> };
  const presets: Record<string, Record<string, string>> = {
    riso: {},
    miniature: inks?.packs.miniature ?? {},
    forest: { ink: '#1F3B2C', blue: '#2F6B4F', coral: '#D9783A', mustard: '#E8B64C', green: '#6E9B3A', tone: '#9CC5A8', 'tone-coral': '#F0B892', 'tone-mustard': '#F3D9A0', paper: '#F3EFE3' },
    night: { ink: '#F4F2EC', blue: '#3D5AFE', coral: '#FF6B8A', mustard: '#FFD166', green: '#06D6A0', tone: '#5468C9', 'tone-coral': '#B3536A', 'tone-mustard': '#B39548', paper: '#14181F', white: '#232A36', dark: '#F4F2EC' },
    mono: { ink: '#1A1A1A', blue: '#3A3A3A', coral: '#8A8A8A', mustard: '#C8C8C8', green: '#5A5A5A', dark: '#111111', tone: '#BDBDBD', 'tone-coral': '#D6D6D6', 'tone-green': '#A8A8A8', 'tone-mustard': '#E4E4E4', paper: '#F5F5F3' },
  };
  const imgs = [...document.querySelectorAll<HTMLImageElement>('.inks-grid img')];
  const tiles = new Map(imgs.map((i) => [i, i.src]));
  const cache = new Map<string, string>();
  const code = document.getElementById('inks-code')!;
  const brand = document.getElementById('brand') as HTMLInputElement;
  let urls: string[] = [];
  async function paint(map: Record<string, string>, label: string) {
    if (!inks) return;
    urls.forEach((u) => URL.revokeObjectURL(u));
    urls = [];
    const pairs = Object.entries(map).filter(([k]) => inks.house[k]).map(([k, v]) => [inks.house[k].toLowerCase(), v] as const);
    const lookup = new Map(pairs);
    const re = pairs.length ? new RegExp(`(${[...lookup.keys()].join('|')})(?![0-9a-f])`, 'gi') : null;
    await Promise.all(imgs.map(async (img) => {
      if (!re) { img.src = tiles.get(img)!; return; }
      const src = img.dataset.svg!;
      if (!cache.has(src)) cache.set(src, await (await fetch(src)).text());
      const url = URL.createObjectURL(new Blob([cache.get(src)!.replace(re, (m) => lookup.get(m.toLowerCase()) || m)], { type: 'image/svg+xml' }));
      urls.push(url);
      img.src = url;
    }));
    code.textContent = `{ "style": ${label}, "elements": [ … ] }`;
  }
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chips button')];
  chips.forEach((b) => b.addEventListener('click', () => {
    chips.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    const p = b.dataset.pack!;
    paint(presets[p], p === 'riso' || p === 'miniature' ? `"${p}"` : JSON.stringify(Object.fromEntries(Object.entries(presets[p]).slice(0, 2))).replace('}', ', … }'));
  }));
  brand.addEventListener('input', () => {
    chips.forEach((x) => x.setAttribute('aria-pressed', 'false'));
    const hex = brand.value.toUpperCase();
    paint({ blue: hex, ink: hex }, `{ "blue": "${hex}", "ink": "${hex}" }`);
  });

  // --- client tabs, arrow keys move between them
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.tabs [role=tab]')];
  const select = (t: HTMLButtonElement) => {
    tabs.forEach((x) => {
      const on = x === t;
      x.setAttribute('aria-selected', String(on));
      x.tabIndex = on ? 0 : -1;
      document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !on;
    });
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!d) return;
      const n = tabs[(i + d + tabs.length) % tabs.length];
      select(n);
      n.focus();
    });
  });
  document.querySelectorAll<HTMLButtonElement>('.copy').forEach((b) => b.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(b.dataset.copy!); b.textContent = 'Copied'; } catch { b.textContent = 'Select and copy'; }
    setTimeout(() => (b.textContent = 'Copy'), 1600);
  }));
</script>

