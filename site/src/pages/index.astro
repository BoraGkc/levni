<script>
  // --- inks demo: same swap the engine does, on the per-variant SVGs
  const inks = await fetch('/inks.json').then((r) => r.json()).catch(() => null) as null | { house: Record<string, string>; packs: Record<string, Record<string, string>> };
  const presets: Record<string, Record<string, string>> = {
    riso: {},
    miniature: inks?.packs.miniature ?? {},
    forest: { ink: '#1F3B2C', blue: '#2F6B4F', coral: '#D9783A', mustard: '#E8B64C', green: '#6E9B3A', tone: '#9CC5A8', 'tone-coral': '#F0B892', 'tone-mustard': '#F3D9A0', paper: '#F3EFE3' },
    night: { ink: '#F4F2EC', blue: '#3D5AFE', coral: '#FF6B8A', mustard: '#FFD166', green: '#06D6A0', tone: '#5468C9', 'tone-coral': '#B3536A', 'tone-mustard': '#B39548', paper: '#14181F', white: '#232A36', dark: '#F4F2EC' },
    mono: { ink: '#1A1A1A', blue: '#3A3A3A', coral: '#8A8A8A', mustard: '#C8C8C8', green: '#5A5A5A', dark: '#111111', tone: '#BDBDBD', 'tone-coral': '#D6D6D6', 'tone-green': '#A8A8A8', 'tone-mustard': '#E4E4E4', paper: '#F5F5F3' },
  };
  const imgs = [...document.querySelectorAll<HTMLImageElement>('.inks-grid img')];
  const tiles = new Map(imgs.map((i) => [i, i.src]));
  const cache = new Map<string, string>();
  const code = document.getElementById('inks-code')!;
  const brand = document.getElementById('brand') as HTMLInputElement;
  let urls: string[] = [];
  async function paint(map: Record<string, string>, label: string) {
    if (!inks) return;
    urls.forEach((u) => URL.revokeObjectURL(u));
    urls = [];
    const pairs = Object.entries(map).filter(([k]) => inks.house[k]).map(([k, v]) => [inks.house[k].toLowerCase(), v] as const);
    const lookup = new Map(pairs);
    const re = pairs.length ? new RegExp(`(${[...lookup.keys()].join('|')})(?![0-9a-f])`, 'gi') : null;
    await Promise.all(imgs.map(async (img) => {
      if (!re) { img.src = tiles.get(img)!; return; }
      const src = img.dataset.svg!;
      if (!cache.has(src)) cache.set(src, await (await fetch(src)).text());
      const url = URL.createObjectURL(new Blob([cache.get(src)!.replace(re, (m) => lookup.get(m.toLowerCase()) || m)], { type: 'image/svg+xml' }));
      urls.push(url);
      img.src = url;
    }));
    code.textContent = `{ "style": ${label}, "elements": [ … ] }`;
  }
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chips button')];
  chips.forEach((b) => b.addEventListener('click', () => {
    chips.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    const p = b.dataset.pack!;
    paint(presets[p], p === 'riso' || p === 'miniature' ? `"${p}"` : JSON.stringify(Object.fromEntries(Object.entries(presets[p]).slice(0, 2))).replace('}', ', … }'));
  }));
  brand.addEventListener('input', () => {
    chips.forEach((x) => x.setAttribute('aria-pressed', 'false'));
    const hex = brand.value.toUpperCase();
    paint({ blue: hex, ink: hex }, `{ "blue": "${hex}", "ink": "${hex}" }`);
  });

  // --- client tabs, arrow keys move between them
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.tabs [role=tab]')];
  const select = (t: HTMLButtonElement) => {
    tabs.forEach((x) => {
      const on = x === t;
      x.setAttribute('aria-selected', String(on));
      x.tabIndex = on ? 0 : -1;
      document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !on;
    });
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!d) return;
      const n = tabs[(i + d + tabs.length) % tabs.length];
      select(n);
      n.focus();
    });
  });
  document.querySelectorAll<HTMLButtonElement>('.copy').forEach((b) => b.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(b.dataset.copy!); b.textContent = 'Copied'; } catch { b.textContent = 'Select and copy'; }
    setTimeout(() => (b.textContent = 'Copy'), 1600);
  }));
</script>

