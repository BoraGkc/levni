---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';
import showcase from '../data/gallery.json';

const repo = SITE.github.replace('https://github.com/', '');
const pkg = '@levni/levni';
const codex = `[mcp_servers.levni]\ncommand = "npx"\nargs = ["-y", "${pkg}", "mcp"]`;
const json = (env) => JSON.stringify({ mcpServers: { levni: { command: 'npx', args: ['-y', pkg, 'mcp'], ...(env ? { env } : {}) } } }, null, 2);

const tools: [string, string, string, string][] = [
  ['scene_guide', 'Nothing.', 'The whole scene format as text: canvas, every element type with its fields (drawings, dither, mesh gradients, glyph fills, seals, terrain, engraving), colours, style packs, formats, the critic. Long, so the agent reads it once per session.', 'Read first'],
  ['render_poster', 'spec (a brand shortcut, { brand: { name, tagline, mark, inks, words } }, with optional only and count), out_dir (optional folder), scenes (true also returns each poster as editable scene JSON), preview (default true), guide (true returns the poster format instead).', 'A text line with the poster count, a contact-sheet preview of the series and with out_dir eight PNGs (poster-01-split.png and so on, 1200 by 1600) plus series.png. With scenes: true, each poster as a scene for render_scene.', 'A poster series'],
  ['render_board', 'spec (a brand shortcut or a board of your own tiles), out (optional .png path), preview (default true), guide (true returns the board format instead).', 'A text line with the board size, a 900 px preview and with out the full PNG. The shortest spec is { "brand": { name, tagline, mark, inks } }, which makes nine tiles: mark, wordmark, web page, palette, social card, tote, sticker, pattern and business card.', 'Brand board'],
  ['list_props', 'query (words in English or Turkish; old names of renamed drawings match too), category (one shelf), limit (default 40, up to 500).', 'Matching drawings with their name, variant count, shelf, tags and what each variant shows, plus the line to paste into a scene. The agent picks real names instead of guessing.', 'Search'],
  ['show_props', 'names: up to 12 drawing names from list_props.', 'A contact sheet image of up to 18 variants, each labelled “name number”, so the agent can choose a variant by eye. Unknown names are reported, not fatal.', 'Choose by eye'],
  ['render_scene', 'scene (the JSON), out (optional .png, .webp or .svg path), preview (default true).', 'The critic’s notes as text, a 560 px preview image, and with out the full-size file. The preview includes the scene’s screen print pass, so a gameboy or blueprint scene is previewed as it will be saved.', 'Draw and check'],
  ['critique_scene', 'scene (the JSON).', 'Only the critic’s notes: elements off the canvas, accidental crops, lopsided weight, no focal point, or “no layout problems found”. No image, so it is quick and cheap.', 'Iterate'],
];
const prompts: [string, string][] = [
  ['A brand board for my product', 'Make a brand board for [product], [one line about what it does]. Pick a mark from the library that suits it, use these inks: [four hex colours], and a serif wordmark. Render it with render_board, save board.png, then tell me which tile you would change.'],
  ['A poster series for my brand', 'Make a poster series for my brand [name], [one line about what it does]. Pick a mark from the library that suits it, use these inks: [three or four hex colours], and these headline words: [four words]. Render it with render_poster into a folder called posters, look at the contact sheet, and tell me which two posters work best and why.'],
  ['One poster, then a tweak', 'Run render_poster for [brand] with scenes: true and only ["launch"]. Show me the poster, then change its headline word and the accent ink in the returned scene, render it with render_scene, and save it as launch.png.'],
  ['A sticker sheet', 'Draw a sticker sheet on a blue ground: six library drawings that fit [theme], each die-cut with a thick paper outline in alternating colours and tilted a little, plus two round seals with ring text. Check the critic, then save stickers.png.'],
  ['A dithered hero', 'Write a 1200 by 673 hero in ordered dither: a sky fading from blue to coral in square cells, a dithered sun low on the right, a dark band with line dither at the bottom. Keep the left third calm for a headline. Save hero.png.'],
  ['An ASCII OG card', 'Make an ASCII-style OG card on a dark ground: a rocket filled with dots on the right, “JSON in. Illustration out.” on the left, and a command line in small mono type at the bottom. Save og-ascii.png.'],
  ['An etched poster', 'Make an etched poster: an engraved mountain landscape with a sun in blue ink on cream paper, a small caption “Plate 04 / Summit and sun” top left. Try two seeds, show me both and keep the better one as poster.png.'],
  ['A mesh gradient background', 'Make a mesh gradient background for my landing page in [three colours], with a calm zone on the left where the headline goes. Then draw six squircle tiles in matching blends for the feature icons, on one sheet.'],
  ['A wireframe terrain hero', 'Draw a wireframe terrain hero for a developer tools site: dark ground, light lines, a coral glow on the horizon, a few mustard streams in the valleys and a small rocket above the ridge. Save terrain.png.'],
  ['An article cover', 'Draw a cover for my article “Why every newsroom wants a data desk”. Search the library for two or three fitting drawings, show me a contact sheet, then compose a riso scene with room on the left for a title. Fix every critic note and save it as cover.webp.'],
  ['An Open Graph card in my colours', 'Make a 1200 by 630 Open Graph card for this post, with the title as the headline. Use my inks, { "blue": "#6A1B9A", "mustard": "#00BFA5" }. Show me the preview, fix what the critic reports, and save og.png.'],
  ['A print look for an existing scene', 'Take scene.json and render it three times with the gameboy, blueprint and newsprint screens. Show me all three and save the one that reads best.'],
  ['Fix a scene without redrawing it', 'Run critique_scene on scene.json and fix each note by moving or resizing elements, not by changing the look. Tell me what you changed.'],
];
const strip = [
  ['posters', 'strip-1', 'Branding posters', 'render_poster, one brand spec'],
  ['boards', '01-feneri', 'Brand board', 'render_board, four fields'],
  ['stickers', '01-seal-sheet', 'Sticker sheet', 'Seals and die-cut drawings'],
  ['brand', '01-dither-sunset', 'Dithered sunset', 'Dither fields in a scene'],
  ['brand', '12-glyphfill-og-card', 'ASCII OG card', 'Glyph fills and mono type'],
  ['lines', '05-engrave-poster', 'Etched poster', 'Engraving in blue ink'],
].map(([g, id, label, note]) => ({ g, id, label, note, alt: (showcase.items as { group: string; id: string; alt: string }[]).find((i) => i.group === g && i.id === id)?.alt ?? label }));
const ghostTools = [
  ['ghost_drafts', 'Read-only. Drafts without images, their h2 headings and, for one draft, the full text.'],
  ['ghost_preview', 'Dry run. Renders the cover and inline images, shows where each goes, returns a token. Nothing changes.'],
  ['ghost_apply', 'Writes, only with the token from a preview of the same plan on the unchanged draft.'],
];
const faq = [
  { q: 'How long does a render take?', a: 'About 0.15 seconds for a hand-inked cover on a laptop, so the preview comes back almost at once and the agent can try several versions in a few seconds. Boards and poster series take a few seconds in all.' },
  { q: 'Do I need an API key for Levni?', a: 'No. Levni runs on your own machine through npx: no account, no key, no cost per image. Your assistant writes the scene; Levni draws it locally.' },
  { q: 'Where do my Ghost keys go?', a: 'Into the env block of your MCP client config, on your machine. Levni has no server of its own and never sees them. Without the two variables the Ghost tools do not even appear.' },
  { q: 'Can the assistant publish a post by mistake?', a: 'No. The Ghost tools only edit drafts, never change their status, never send a newsletter, and skip drafts that already have images. Writing needs the token from a preview the user has seen.' },
  { q: 'Can it make brand assets, not only illustrations?', a: 'Yes. Scenes can hold dither fields, mesh gradients, ASCII fills, seals, stickers, terrain and etching, and render_board turns a name, tagline, mark and inks into a nine-tile brand board, and render_poster makes eight branding posters from one brand spec. The agent reads the format with scene_guide or render_board guide: true.' },
  { q: 'Which clients work?', a: 'Any MCP client that runs local stdio servers: Claude Code, Claude Desktop, Cursor, Windsurf, Cline and others. Agents without MCP can call the same features through the levni CLI.' },
];
const jsonld = [
  { '@type': 'SoftwareApplication', name: 'Levni MCP server', applicationCategory: 'DesignApplication', operatingSystem: 'macOS, Linux, Windows (Node.js 20+)', url: `${SITE.url}/mcp/`, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, publisher: { '@id': `${SITE.ortakAlan}/#organization` } },
  { '@type': 'FAQPage', mainEntity: faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<Base og="/og/mcp.png" title="MCP server: give your agent a design studio" description="Connect Levni to Claude, Cursor or any MCP client: the agent draws illustrations, covers, icons, charts, brand assets, brand boards and branding posters, reads the layout critic and saves the files. Free and local." jsonld={jsonld}>
  <article class="wrap page">
    <header class="brand-hero no-art">
    <p class="eyebrow">Levni for agents</p>
    <h1>Give your agent a <em class="accent">design studio</em>.</h1>
    <p class="lede">Connect Levni and your assistant can make branding posters, brand boards, sticker sheets, dithered heroes, ASCII cards, 3D icons and covers. It finds the drawings, writes the scene, reads the critic’s notes and saves the file. Free, local, no image model.</p>
    </header>

    <h2 id="makes">What your agent can make</h2>
    <ul class="strip">{strip.map((t) => (
      <li><a href={`/gallery/#${t.g}`}><img src={`/g/${t.g}/${t.id}-s.webp`} width="640" height="359" alt={t.alt} loading="lazy" decoding="async" /></a><strong>{t.label}</strong><span>{t.note}</span></li>
    ))}</ul>
    <p class="small">Start with <code>render_poster</code> for poster series or <code>render_board</code> for brand boards, or paste one of the <a href="#prompts">brand-asset prompts</a>. Every tile links to its gallery tab, and every kind of asset has a <a href="/make/">free maker</a> to try in the browser first.</p>

    <aside class="free-note">
      <b>Free on the plan you already have.</b> Levni draws on your machine, so a $20 Claude or ChatGPT plan is enough: Claude Code or Claude Desktop with Claude, Codex with ChatGPT. No image credits, no API key, no second bill. Want to see it first? <a href="/editor/">Open the editor</a>.
    </aside>

    <h2 id="setup">Set it up</h2>
    <div class="setup">
      <div><h3>Claude Code</h3><pre><code>{`claude mcp add levni -- npx -y ${pkg} mcp`}</code></pre></div>
      <div><h3>Claude Desktop, Cursor and others</h3><p class="small">In <code>claude_desktop_config.json</code>, <code>.cursor/mcp.json</code> or your client’s MCP settings:</p><pre><code>{json()}</code></pre></div>
    </div>
    <div class="setup setup-one"><div><h3>Codex</h3><p class="small">In <code>~/.codex/config.toml</code>:</p><pre><code>{codex}</code></pre></div></div>
    <p>Then ask: <q>Illustrate this article with Levni, show me two options, and fix what the critic reports.</q> Node.js 20 or newer is the only requirement. The best first prompts are <a href="#prompts">just below</a>.</p>

    <h2 id="prompts">Things to ask your agent</h2>
    <p>Paste any of these into Claude Code, Claude Desktop, Cursor or another client with Levni connected. Swap in your own title, product or colours.</p>
    <ol class="prompts">{prompts.map(([t, p]) => (<li><h3>{t}</h3><p>{p}</p></li>))}</ol>

    <h2 id="tools">What the agent can do</h2>
    <p>Seven tools, <code>render_poster</code> and <code>render_board</code> among them. Each takes plain JSON and returns text, an image or both, so a client that can show images lets the agent look at its own work. Nothing leaves your machine.</p>
    <ul class="tool-list">{tools.map(([n, input, back, tag]) => (
      <li>
        <h3><code>{n}</code> <span class="tag">{tag}</span></h3>
        <p><strong>Goes in.</strong> {input}</p>
        <p><strong>Comes back.</strong> {back}</p>
      </li>
    ))}</ul>
    <p class="small">With Ghost credentials in the environment, three more tools appear (<a href="#ghost">below</a>). Agents without MCP use the same features through the <code>levni</code> CLI: <code>levni render</code>, <code>levni board</code> and <code>levni poster</code>.</p>

    <h2 id="session">How a session goes</h2>
    <ol class="session">
      <li><strong>You ask.</strong> “Make a brand board for Feneri, a ferry company, with a lighthouse mark and these four colours.”</li>
      <li><strong>The agent reads the format.</strong> <code>scene_guide</code>, or <code>render_board</code> with <code>guide: true</code> for boards, once.</li>
      <li><strong>It finds the pieces.</strong> <code>list_props</code> for “lighthouse”, then <code>show_props</code> to see the variants side by side and pick one.</li>
      <li><strong>It draws.</strong> <code>render_scene</code> or <code>render_board</code> returns a preview and, for scenes, the critic’s notes. The agent looks at the picture.</li>
      <li><strong>It fixes and repeats.</strong> A note such as “title overlaps the rocket” becomes a changed <code>x</code>; <code>critique_scene</code> confirms without another image. Most scenes settle in two or three rounds.</li>
      <li><strong>It saves.</strong> One last call with <code>out</code> writes the PNG or WebP, and the agent tells you the path. Same scene, same seed, same file, so you can ask for a change later.</li>
    </ol>
    <div class="shots">
      <figure class="shot">
        <img class="tezhip" src="/g/boards/01-feneri-s.webp" width="640" height="427" alt="A brand board for a ferry company, drawn by an agent from four fields: mark, wordmark, web page, palette, social card, tote, sticker, pattern and business card" loading="lazy" />
        <figcaption>One <code>render_board</code> call from four fields.</figcaption>
      </figure>
      <figure class="shot">
        <img class="tezhip" src="/g/brand/01-dither-sunset-s.webp" width="640" height="359" alt="A dithered pixel sunset an agent wrote as a scene, blue sky fading to coral behind a mustard sun" loading="lazy" />
        <figcaption>A scene an agent can write in one go: dither fields and a sun.</figcaption>
      </figure>
    </div>

    <h2 id="ghost">Ghost: images for your drafts</h2>
    <p>Add your Ghost Admin credentials to the server’s <code>env</code> and three more tools appear. The assistant finds drafts without images, designs a cover and up to one image per section, shows you the plan with previews, and writes only after you say yes.</p>
    <pre><code>{json({ GHOST_ADMIN_API_URL: 'https://your-site.com', GHOST_ADMIN_API_KEY: '<id>:<secret>' })}</code></pre>
    <dl class="tools">{ghostTools.map(([n, w]) => (<><dt><code>{n}</code></dt><dd>{w}</dd></>))}</dl>
    <ul class="rules">
      <li><strong>Drafts only.</strong> The post stays a draft; nothing is published or emailed.</li>
      <li><strong>Hands off what is done.</strong> A draft that already has any image is skipped.</li>
      <li><strong>You see it first.</strong> The token from <code>ghost_preview</code> is tied to the plan and to the draft’s last edit. Change either and the assistant has to preview again.</li>
      <li><strong>One image per section,</strong> after the heading and its first paragraph; headings match even with curly quotes.</li>
    </ul>
    <p class="small">Create the key in Ghost under Settings → Integrations → Add custom integration. Try it on a test draft first. Posts written with Ghost’s older mobiledoc editor are not supported.</p>

    <h2 id="privacy">Keys, cost and privacy</h2>
    <p>Levni has no server and no account. Drawing is free and local. Ghost keys live in your own MCP config. The optional image judge (CLI only) uses your own OpenRouter key if you choose to set one.</p>

    <h2 id="faq">Questions</h2>
    {faq.map(({ q, a }) => (<details><summary>{q}</summary><p>{a}</p></details>))}

    <p class="next"><a class="text-link" href="/features/">Everything Levni can draw</a> · <a class="text-link" href="/library/">Browse the library</a> · <a class="text-link" href={`${SITE.github}#use-it-from-an-agent-mcp`}>README</a></p>
  </article>
</Base>

<style>
  .page { max-width: 860px; margin-top: 0; }
  .eyebrow { font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent-text); margin: 0 0 12px; }
  .lede { font-size: 1.22rem; color: var(--ink-soft); }
  h2 { margin-top: 2.2em; font-size: clamp(1.8rem, 4vw, 2.4rem); }
  h3 { font-size: 1.2rem; margin-bottom: 0.4em; }
  .setup { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: 20px; }
  pre { white-space: pre; overflow-x: auto; max-width: 100%; }
  .setup > div { min-width: 0; }
  .small { font-size: 0.94rem; color: var(--ink-soft); }
  .tools { display: grid; grid-template-columns: auto 1fr; gap: 10px 16px; margin: 20px 0; }
  .tools dt code { font-size: 0.86rem; color: var(--accent-text); }
  .tools dd { margin: 0; color: var(--ink-soft); }
  .tool-list { list-style: none; padding: 0; margin: 20px 0; display: grid; gap: 18px; }
  .tool-list li { border-top: 1.5px solid var(--rule); padding-top: 14px; }
  .tool-list h3 { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; margin: 0 0 6px; }
  .tool-list h3 code { font-size: 1.05rem; color: var(--accent-text); }
  .tag { font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-soft); font-weight: 400; }
  .tool-list p { margin: 4px 0; color: var(--ink-soft); }
  .tool-list p strong { color: var(--ink); }
  .session { padding-left: 1.3em; }
  .session li { margin-bottom: 10px; color: var(--ink-soft); }
  .session li strong { color: var(--ink); }
  .strip { list-style: none; padding: 0; margin: 20px 0 14px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px 14px; }
  .strip li { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .strip img { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border: 1px solid var(--rule); background: var(--paper-2); display: block; margin-bottom: 6px; }
  .strip a:hover img { box-shadow: none; }
  .strip strong { font-size: 0.98rem; }
  .strip span { font-size: 0.86rem; color: var(--ink-soft); }
  .shots { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; margin: 24px 0; align-items: start; }
  .shots .shot { margin: 0; }
  .shots img { width: 100%; height: auto; }
  .prompts { list-style: none; padding: 0; margin: 20px 0; display: grid; gap: 12px; counter-reset: p; }
  .prompts li { counter-increment: p; border: 1px solid var(--rule); background: var(--paper-2); padding: 12px 16px 14px; }
  .prompts h3 { font-size: 1.05rem; margin: 0 0 4px; }
  .prompts h3::before { content: counter(p, decimal-leading-zero) '  '; font-family: var(--mono); font-size: 0.78rem; color: var(--accent-text); }
  .prompts p { margin: 0; font-family: var(--mono); font-size: 0.86rem; line-height: 1.55; color: var(--ink); }
  .shot { margin: 28px 0; }
  .shot img { padding: 6px; }
  figcaption { font-size: 0.92rem; color: var(--ink-soft); margin-top: 10px; }
  .rules li { margin-bottom: 6px; }
  details { border-bottom: 1px solid var(--rule); padding: 12px 2px; }
  summary { font-family: var(--display); font-size: 1.3rem; font-weight: 600; cursor: pointer; }
  details p { margin: 8px 0 0; color: var(--ink-soft); }
  .next { margin-top: 40px; }
  .text-link { font-weight: 600; }
  @media (max-width: 720px) { .strip { grid-template-columns: repeat(2, minmax(0, 1fr)); } .shots { grid-template-columns: minmax(0, 1fr); } .setup { grid-template-columns: minmax(0, 1fr); } .tools { grid-template-columns: minmax(0, 1fr); gap: 2px 0; } .tools dd { margin-bottom: 10px; } }
  .free-note { margin: 28px 0 8px; padding: 16px 18px; border-radius: 0; background: var(--indigo); color: #c9cfdb; box-shadow: inset 4px 0 0 var(--mustard); }
  .free-note b { color: var(--paper); }
  .free-note a { color: #fff; }
  .setup-one { grid-template-columns: minmax(0, 1fr); margin-top: 20px; }
</style>
