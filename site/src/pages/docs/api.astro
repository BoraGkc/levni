  ['W, H, rng, frame', 'Default canvas size, the seeded random generator, and the helper that wraps drawn markup in a canvas with paper and grain.'],
  ['loadProps()', 'All drawings as an object keyed by name.'],
  ['findProp(nameOrTag)', 'One drawing by name or tag, or null.'],
  ['expandProp(element)', 'Turns a prop element into a draw element (what compose does).'],
