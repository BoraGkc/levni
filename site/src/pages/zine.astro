---
// Levni Zine: issues drawn by Levni, read on the page, downloaded as a PDF or printed as an eight-page fold-up.
// Pages and PDFs come from scripts/render-zine.mjs (examples/zine-*.json).
import Base from '../layouts/Base.astro';
import { SITE } from '../site';
import issues from '../data/zine.json';

const gh = SITE.github;
const z = issues[0];
const pad = (n: number) => String(n).padStart(2, '0');
const pages = Array.from({ length: z.pages }, (_, i) => ({ n: i + 1, src: `/zine/${z.id}/p${pad(i + 1)}.webp`, thumb: `/zine/${z.id}/p${pad(i + 1)}-s.webp`, title: z.titles[i] }));
const steps = [
  'Print fold.pdf on one A4 sheet, landscape, at 100%.',
  'Fold it in half the long way, then open it again.',
  'Fold it in half the short way, twice, and open it: eight panels.',
  'Fold it in half the short way and cut along the red line, from the fold to the middle.',
  'Open it, fold it the long way, push the ends together so the cut opens into a diamond, and flatten it into a booklet.',
];
const faq = [
  { q: 'What is the Levni Zine?', a: 'A small magazine about the open drawing library and the people who draw for it, made entirely with Levni. Every page is a scene file in the repo, so you can open any page and change it.' },
  { q: 'Can I print and share it?', a: 'Yes. The zine is CC BY 4.0 like the drawings: print it, photocopy it, run it on a riso, hand it out. Keep the credit line on the back.' },
  { q: 'How do I get into the next issue?', a: 'Post something you made with Levni, with its scene, as a Showcase issue on GitHub. Drawings for the Folio count too: the Wanted list is on the commons page.' },
  { q: 'Can I make my own?', a: 'Write a zine.json with eight pages (cover, text, grid, list, code, any scene, back) and run npx @levni/levni zine zine.json out/. You get the pages, a PDF and the fold-up sheet.' },
];
---
<Base title="Levni Zine: a small magazine drawn by Levni, to read, print and fold" description={`Levni Zine No. ${z.id}: ${z.title} ${z.pages} pages drawn by Levni from scene files. Read it here, download the PDF, or print one A4 sheet and fold it into a booklet.`}>
  <div class="wrap zn">
    <header class="brand-hero">
      <p class="eyebrow">Levni Zine</p>
      <h1>A small magazine. Drawn, printed, folded.</h1>
      <p class="lede">Every issue is a handful of pages drawn by Levni from scene files. Read it here, keep the PDF, or print one A4 sheet and fold it into an eight-page booklet to pass around.</p>
    </header>

    <section class="zn-issue" aria-labelledby="zn-t">
      <button type="button" class="zn-cover" data-open="0" aria-label="Read the zine from the cover"><img src={pages[0].src} width="874" height="1240" alt={`Levni Zine No. ${z.id} cover: ${z.title}`} fetchpriority="high" /></button>
      <div class="zn-meta">
        <p class="zn-no">No. {z.id} · {z.date}</p>
        <h2 id="zn-t">{z.title}</h2>
        <p>{z.subtitle}</p>
        <p class="zn-acts">
          <button type="button" class="zn-btn" data-open="0">Read it here</button>
          <a class="zn-btn ghost" href={`/zine/${z.id}/zine.pdf`} download>PDF · {Math.round(z.pdfKB / 102.4) / 10} MB</a>
          {z.fold && <a class="zn-btn ghost" href={`/zine/${z.id}/fold.pdf`} download>Print and fold · A4</a>}
        </p>
        <h3>In this issue</h3>
        <ol class="zn-toc">
          {pages.map((p) => <li><button type="button" data-open={p.n - 1}><span>{pad(p.n)}</span>{p.title}</button></li>)}
        </ol>
        <p class="zn-src">Every page is a scene: <a href={`${gh}/blob/main/${z.source}`}>{z.source}</a></p>
      </div>
    </section>

    <section class="zn-sec" aria-labelledby="zn-pages">
      <h2 id="zn-pages">All {z.pages} pages</h2>
      <ul class="zn-grid">
        {pages.map((p) => <li><button type="button" data-open={p.n - 1} aria-label={`Open page ${p.n}: ${p.title}`}><img src={p.thumb} width="300" height="426" alt="" loading="lazy" decoding="async" /><span>{pad(p.n)} · {p.title}</span></button></li>)}
      </ul>
    </section>

    {z.fold && (
      <section class="zn-sec zn-fold" aria-labelledby="zn-f">
        <figure><img src={`/zine/${z.id}/fold.webp`} width="1200" height="848" alt="The fold-up sheet: eight pages on one A4 page, the top row upside down, with dashed fold lines and a red cut line in the middle" loading="lazy" decoding="async" /></figure>
        <div>
          <h2 id="zn-f">Print it, fold it</h2>
          <ol class="zn-steps">{steps.map((s) => <li>{s}</li>)}</ol>
          <p><a class="zn-btn" href={`/zine/${z.id}/fold.pdf`} download>Download the A4 sheet</a></p>
        </div>
      </section>
    )}

    <section class="zn-sec zn-make" aria-labelledby="zn-m">
      <div>
        <h2 id="zn-m">Make your own zine</h2>
        <p>Eight pages in one JSON file: a cover, text, a grid of drawings, a list, a code page, any scene you like and a back cover. Levni draws the pages, writes the PDF and lays out the fold-up sheet.</p>
        <pre><code>npx @levni/levni zine zine.json out/</code></pre>
        <p><a href="/docs/zine/">Zine guide →</a></p>
      </div>
      <div class="zn-call">
        <p class="zn-no">Wanted for No. 02</p>
        <h3>Your page could be in the next one.</h3>
        <p>A poster, a banner, a new drawing for the Folio: post it with its scene and it can land in the next issue, credited.</p>
        <p class="zn-acts"><a class="zn-btn" href={`${gh}/issues/new?template=showcase.yml`}>Send a piece</a> <a class="zn-btn ghost" href="/commons/">What is wanted</a></p>
      </div>
    </section>

    <section class="zn-sec zn-about">
      <h2>Questions</h2>
      <dl>{faq.map(({ q, a }) => (<><dt>{q}</dt><dd>{a}</dd></>))}</dl>
    </section>
  </div>

  <dialog class="zn-reader" id="zn-reader" aria-label="Zine reader">
    <div class="zn-r-top"><span id="zn-r-count"></span><button type="button" class="zn-r-x" id="zn-r-close" aria-label="Close the reader">Close ✕</button></div>
    <div class="zn-r-stage">
      <button type="button" class="zn-r-nav" id="zn-r-prev" aria-label="Previous page">←</button>
      <img id="zn-r-img" alt="" width="874" height="1240" />
      <button type="button" class="zn-r-nav" id="zn-r-next" aria-label="Next page">→</button>
    </div>
  </dialog>
  <script is:inline type="application/json" id="zn-pages-data" set:html={JSON.stringify(pages)}></script>
</Base>

<script>
  const pages: { n: number; src: string; title: string }[] = JSON.parse(document.getElementById('zn-pages-data')!.textContent || '[]');
  const dlg = document.getElementById('zn-reader') as HTMLDialogElement;
  const img = document.getElementById('zn-r-img') as HTMLImageElement;
  let at = 0;
  const show = (i: number) => {
    at = (i + pages.length) % pages.length;
    img.src = pages[at].src; img.alt = `Page ${pages[at].n}: ${pages[at].title}`;
    document.getElementById('zn-r-count')!.textContent = `${String(pages[at].n).padStart(2, '0')} / ${String(pages.length).padStart(2, '0')} · ${pages[at].title}`;
    new Image().src = pages[(at + 1) % pages.length].src; // the next page is ready before the click
  };
  document.querySelectorAll<HTMLElement>('[data-open]').forEach((b) => b.addEventListener('click', () => { show(Number(b.dataset.open)); dlg.showModal(); }));
  document.getElementById('zn-r-prev')!.addEventListener('click', () => show(at - 1));
  document.getElementById('zn-r-next')!.addEventListener('click', () => show(at + 1));
  document.getElementById('zn-r-close')!.addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') show(at + 1); if (e.key === 'ArrowLeft') show(at - 1); });
  let x0 = 0;
  img.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
  img.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) show(at + (dx < 0 ? 1 : -1)); });
</script>

<style>
  .zn-issue { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(24px, 5vw, 64px); align-items: start; margin-bottom: clamp(44px, 6vw, 72px); }
  .zn-cover { padding: 0; border: 0; background: none; cursor: zoom-in; display: block; box-shadow: 0 1px 0 var(--rule), 14px 14px 0 var(--indigo); transition: transform .2s ease; }
  .zn-cover:hover { transform: translate(-3px, -3px); }
  .zn-cover img { display: block; width: 100%; height: auto; }
  .zn-no { font: 600 12px/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--accent-text, #C2410C); margin: 0 0 12px; }
  .zn-meta h2 { margin: 0 0 12px; font-size: clamp(2rem, 4vw, 3.2rem); line-height: 1; }
  .zn-meta > p { color: var(--ink-soft); max-width: 56ch; }
  .zn-meta h3 { font: 600 12px/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; margin: 28px 0 10px; }
  .zn-acts { display: flex; gap: 10px; flex-wrap: wrap; margin: 20px 0 0; }
  .zn-btn { font: 600 12px/1 var(--mono); letter-spacing: .05em; text-transform: uppercase; padding: 14px 16px; border: 0; background: var(--indigo); color: #fff; text-decoration: none; cursor: pointer; display: inline-block; }
  .zn-btn.ghost { background: #fff; color: var(--ink); box-shadow: 0 0 0 2px var(--ink); }
  .zn-btn:focus-visible, .zn-toc button:focus-visible, .zn-grid button:focus-visible, .zn-cover:focus-visible { outline: 3px solid var(--lime); outline-offset: 3px; }
  .zn-toc { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .zn-toc button { width: 100%; display: flex; gap: 14px; align-items: baseline; padding: 10px 2px; border: 0; border-bottom: 1px solid var(--rule); background: none; font: inherit; color: var(--ink); text-align: left; cursor: pointer; }
  .zn-toc button:hover { color: var(--indigo); }
  .zn-toc span { font: 600 12px/1 var(--mono); color: var(--ink-soft); }
  .zn-src { font-size: 14px; color: var(--ink-soft); }
  .zn-sec { margin: 0 0 clamp(44px, 6vw, 72px); }
  .zn-sec > h2 { margin: 0 0 16px; }
  .zn-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(12px, 2vw, 24px); }
  .zn-grid button { padding: 0; border: 0; background: none; cursor: zoom-in; width: 100%; text-align: left; font: inherit; color: var(--ink); }
  .zn-grid img { display: block; width: 100%; height: auto; box-shadow: 0 0 0 1px var(--rule); transition: transform .2s ease; }
  .zn-grid button:hover img { transform: translateY(-3px); box-shadow: 0 0 0 2px var(--indigo); }
  .zn-grid span { display: block; margin-top: 8px; font: 600 12px/1.3 var(--mono); color: var(--ink-soft); }
  .zn-fold { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: clamp(20px, 4vw, 48px); align-items: center; }
  .zn-fold figure { margin: 0; background: #fff; padding: 10px; box-shadow: 0 0 0 1px var(--rule); }
  .zn-fold img { display: block; width: 100%; height: auto; }
  .zn-fold h2 { margin: 0 0 14px; }
  .zn-steps { margin: 0 0 18px; padding-left: 22px; display: grid; gap: 8px; color: var(--ink-soft); }
  .zn-make { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 18px; align-items: stretch; }
  .zn-make > div { background: #fff; box-shadow: 0 0 0 1px var(--rule); padding: clamp(20px, 3vw, 32px); }
  .zn-make h2 { margin: 0 0 12px; }
  .zn-make pre { margin: 14px 0; padding: 14px; background: var(--indigo-deep); color: #fff; font: 14px/1.5 var(--mono); overflow-x: auto; }
  .zn-make .zn-call { background: var(--lime); box-shadow: none; }
  .zn-call h3 { margin: 0 0 10px; font-size: 1.6rem; color: var(--indigo); }
  .zn-about { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: clamp(20px, 4vw, 56px); }
  .zn-about h2 { margin: 0; }
  .zn-about dl { margin: 0; }
  .zn-about dt { font-weight: 700; margin-top: 14px; }
  .zn-about dt:first-child { margin-top: 0; }
  .zn-about dd { margin: 6px 0 0; color: var(--ink-soft); }
  .zn-reader { border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; }
  .zn-reader::backdrop { background: rgba(20, 16, 50, .88); }
  .zn-r-top { position: fixed; top: 0; left: 0; right: 0; display: flex; justify-content: space-between; align-items: center; padding: 14px 18px; color: #fff; font: 600 12px/1 var(--mono); letter-spacing: .06em; text-transform: uppercase; z-index: 2; }
  .zn-r-x { font: inherit; letter-spacing: inherit; text-transform: inherit; background: #fff; color: var(--ink); border: 0; padding: 10px 12px; cursor: pointer; }
  .zn-r-stage { height: 100%; display: grid; grid-template-columns: auto minmax(0, auto) auto; justify-content: center; align-items: center; gap: 14px; padding: 56px 12px 20px; }
  .zn-r-stage img { display: block; max-height: calc(100vh - 90px); max-width: 100%; width: auto; height: auto; box-shadow: 0 20px 60px rgba(0,0,0,.4); }
  .zn-r-nav { font: 700 22px/1 var(--mono); width: 52px; height: 52px; border: 0; background: #fff; color: var(--ink); cursor: pointer; }
  .zn-r-nav:focus-visible, .zn-r-x:focus-visible { outline: 3px solid var(--lime); outline-offset: 2px; }
  @media (max-width: 820px) {
    .zn-issue, .zn-fold, .zn-make, .zn-about { grid-template-columns: minmax(0, 1fr); }
    .zn-cover { max-width: 420px; box-shadow: 0 1px 0 var(--rule), 8px 8px 0 var(--indigo); }
    .zn-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .zn-r-stage { grid-template-columns: minmax(0, 1fr); padding: 56px 10px 80px; }
    .zn-r-nav { position: fixed; bottom: 16px; }
    #zn-r-prev { left: 16px; } #zn-r-next { right: 16px; }
  }
  @media (prefers-reduced-motion: reduce) { .zn-cover, .zn-grid img { transition: none; } }
</style>
