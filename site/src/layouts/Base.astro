---
import { SITE } from '../site';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TryLevni from '../components/TryLevni.astro';

interface Props {
  title: string;
  description: string;
  og?: string;
  type?: 'website' | 'article';
  jsonld?: object[];
  published?: Date;
  bare?: boolean; // no header, footer or call-to-action band (the embedded editor)
  noindex?: boolean;
}
const { title, description, og = '/og/default.png', type = 'website', jsonld = [], published, bare = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogUrl = new URL(og, SITE.url).href;
const fullTitle = title === SITE.name ? `${SITE.name}: ${SITE.tagline}` : `${title} · ${SITE.name}`;

const org = {
  '@type': 'Organization',
  '@id': `${SITE.ortakAlan}/#organization`,
  name: 'Ortak Alan',
  url: SITE.ortakAlan,
};
const graph = [
  {
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    url: `${SITE.url}/`,
    name: SITE.name,
    description: SITE.description,
    publisher: { '@id': org['@id'] },
  },
  org,
  ...jsonld,
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Levni blog" href="/blog/rss.xml" />
    <meta name="theme-color" content="#4B2FD6" />
    <meta name="color-scheme" content="light" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Illustration drawn by Levni" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
    />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
  </head>
  <body>
    {!bare && <a class="skip" href="#main">Skip to content</a>}
    {!bare && <SiteHeader />}
    <main id="main">
      <slot />
    </main>
    {!bare && !['/', '/editor/'].includes(Astro.url.pathname) && <TryLevni />}
    {!bare && <SiteFooter />}
  </body>
</html>

<style is:global>
  :root {
    /* riso poster: indigo, lime, red and paper (the 2026 rebrand) */
    --indigo: #4b2fd6;
    --indigo-deep: #2b1a8f;
    --lime: #d6e521;
    --red: #ff3a44;
    --on-indigo: #e9f2d9;
    --mute-indigo: #c3b9f7;
    --pink: #ff39b4; --mint: #66dcc2; --sky: #58c4f6; --sun: #f7c744; --orange: #f28c38; --lilac: #f3c2f5;
    --paper: #f3f1ea;
    --paper-2: #ffffff;
    --ink: #1b1340;
    --ink-soft: #5b5580;
    --rule: #ddd8ee;
    --accent: #4b2fd6;
    --accent-text: #3b22c0;
    --coral: #ff3a44;
    --coral-deep: #d11f2b;  /* 5:1 under white text */
    --mustard: #d6e521;     /* now lime: highlights, primary buttons on indigo */
    --green: #1e8a57;
    /* older names the pages still use */
    --gold: var(--rule);
    --gold-deep: var(--ink-soft);
    --vermilion: var(--coral-deep);
    --vermilion-deep: var(--coral-deep);
    --turquoise-text: var(--accent-text);
    --lapis: var(--accent-text);
    --serif: 'Bricolage Grotesque', 'Helvetica Neue', Arial, sans-serif;
    --display: 'Bricolage Grotesque', 'Helvetica Neue', Arial, sans-serif;
    --mono: 'IBM Plex Mono', ui-monospace, Menlo, Consolas, monospace;
    --wrap: 1200px;
    --chamfer: polygon(0 0, 100% 0, 100% calc(100% - 14px), calc(100% - 14px) 100%, 0 100%);
  }
  * { box-sizing: border-box; }
  ::selection { background: var(--lime); color: var(--indigo); }
  html { accent-color: var(--accent); caret-color: var(--accent); scrollbar-color: var(--ink-soft) var(--paper); }
  :focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; border-radius: 0; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--serif);
    font-size: 1.06rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  img { max-width: 100%; height: auto; display: block; }
  a { color: var(--lapis); text-decoration-thickness: 1px; text-underline-offset: 3px; }
  a:hover { color: var(--vermilion); }
  h1, h2, h3 { font-family: var(--display); font-weight: 700; line-height: 1.02; letter-spacing: -0.035em; color: var(--ink); margin: 0 0 0.5em; text-wrap: balance; }
  h1 { font-size: clamp(2.6rem, 7vw, 4.8rem); font-weight: 500; letter-spacing: -0.045em; }
  h2 { font-size: clamp(2rem, 4.5vw, 3.2rem); }
  h3 { font-size: 1.5rem; letter-spacing: -0.02em; }
  em.accent, .accent { font-family: var(--display); font-style: normal; color: var(--accent); }
  h1 em, h2 em { font-style: normal; color: var(--accent); }
  code, pre { font-family: var(--mono); font-size: 0.86rem; }
  pre {
    background: var(--paper-2);
    border: 1px solid var(--rule);
    color: var(--ink);
    padding: 1.1rem 1.2rem;
    overflow-x: auto;
    line-height: 1.5;
  }
  .wrap { max-width: var(--wrap); margin: 0 auto; padding: 0 max(20px, env(safe-area-inset-right)) 0 max(20px, env(safe-area-inset-left)); }
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 12px; top: 12px; background: var(--paper-2); padding: 8px 12px; z-index: 10; }

  /* print frame: a hard ink border with an offset riso-blue plate behind it */
  .tezhip {
    border: 0;
    background: var(--paper-2);
    box-shadow: none;
    clip-path: var(--chamfer);
  }
  .kicker { font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--coral-deep); }
  .ornament { display: flex; align-items: center; justify-content: center; gap: 14px; margin: 0 auto 18px; color: var(--gold); }
  .ornament::before, .ornament::after { content: ''; height: 1px; width: min(120px, 22vw); background: currentColor; }
  .ornament img { width: 44px; height: 44px; }

  @media (max-width: 480px) {
    body { font-size: 1.08rem; }
  }
  @media (prefers-reduced-motion: reduce) { * { scroll-behavior: auto !important; transition: none !important; } }
</style>
