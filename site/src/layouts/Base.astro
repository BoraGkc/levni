---
import { SITE } from '../site';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TryLevni from '../components/TryLevni.astro';

interface Props {
  title: string;
  description: string;
  og?: string;
  type?: 'website' | 'article';
  jsonld?: object[];
  published?: Date;
  bare?: boolean; // no header, footer or call-to-action band (the embedded editor)
  noindex?: boolean;
}
const { title, description, og = '/og/default.png', type = 'website', jsonld = [], published, bare = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogUrl = new URL(og, SITE.url).href;
const fullTitle = title === SITE.name ? `${SITE.name}: ${SITE.tagline}` : `${title} · ${SITE.name}`;

const org = {
  '@type': 'Organization',
  '@id': `${SITE.ortakAlan}/#organization`,
  name: 'Ortak Alan',
  url: SITE.ortakAlan,
};
const graph = [
  {
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    url: `${SITE.url}/`,
    name: SITE.name,
    description: SITE.description,
    publisher: { '@id': org['@id'] },
  },
  org,
  ...jsonld,
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Levni blog" href="/blog/rss.xml" />
    <meta name="theme-color" content="#4B2FD6" />
    <meta name="color-scheme" content="light" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Illustration drawn by Levni" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
    />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
  </head>
  <body>
    {!bare && <a class="skip" href="#main">Skip to content</a>}
    {!bare && <SiteHeader />}
    <main id="main">
      <slot />
    </main>
    {!bare && !['/', '/editor/'].includes(Astro.url.pathname) && <TryLevni />}
    {!bare && <SiteFooter />}
  </body>
</html>

<style is:global>
  :root {
    /* riso poster: indigo, lime, red and paper (the 2026 rebrand) */
    --indigo: #4b2fd6;
    --indigo-deep: #2b1a8f;
    --lime: #d6e521;
    --red: #ff3a44;
    --on-indigo: #e9f2d9;
    --mute-indigo: #c3b9f7;
    --pink: #ff39b4; --mint: #66dcc2; --sky: #58c4f6; --sun: #f7c744; --orange: #f28c38; --lilac: #f3c2f5;
    --paper: #f3f1ea;
    --paper-2: #ffffff;
    --ink: #1b1340;
    --ink-soft: #5b5580;
    --rule: #ddd8ee;
    --accent: #4b2fd6;
    --accent-text: #3b22c0;
    --coral: #ff3a44;
    --coral-deep: #d11f2b;  /* 5:1 under white text */
    --mustard: #d6e521;     /* now lime: highlights, primary buttons on indigo */
    --green: #1e8a57;
    /* older names the pages still use */
    --gold: var(--rule);
    --gold-deep: var(--ink-soft);
    --vermilion: var(--coral-deep);
    --vermilion-deep: var(--coral-deep);
    --turquoise-text: var(--accent-text);
    --lapis: var(--accent-text);
    --serif: 'Bricolage Grotesque', 'Helvetica Neue', Arial, sans-serif;
    --display: 'Bricolage Grotesque', 'Helvetica Neue', Arial, sans-serif;
    --mono: 'IBM Plex Mono', ui-monospace, Menlo, Consolas, monospace;
    --wrap: 1200px;
    --chamfer: polygon(0 0, 100% 0, 100% calc(100% - 14px), calc(100% - 14px) 100%, 0 100%);
  }
  * { box-sizing: border-box; }
  ::selection { background: var(--lime); color: var(--indigo); }
  html { accent-color: var(--accent); caret-color: var(--accent); scrollbar-color: var(--ink-soft) var(--paper); }
  :focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; border-radius: 0; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--serif);
    font-size: 1.06rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  img { max-width: 100%; height: auto; display: block; }
  a { color: var(--lapis); text-decoration-thickness: 1px; text-underline-offset: 3px; }
  a:hover { color: var(--vermilion); }
  h1, h2, h3 { font-family: var(--display); font-weight: 700; line-height: 1.02; letter-spacing: -0.035em; color: var(--ink); margin: 0 0 0.5em; text-wrap: balance; }
  h1 { font-size: clamp(2.6rem, 7vw, 4.8rem); font-weight: 500; letter-spacing: -0.045em; }
  h2 { font-size: clamp(2rem, 4.5vw, 3.2rem); }
  h3 { font-size: 1.5rem; letter-spacing: -0.02em; }
  em.accent, .accent { font-family: var(--display); font-style: normal; color: var(--accent); }
  h1 em, h2 em { font-style: normal; color: var(--accent); }
  code, pre { font-family: var(--mono); font-size: 0.86rem; }
  pre {
    background: var(--paper-2);
    border: 1px solid var(--rule);
    color: var(--ink);
    padding: 1.1rem 1.2rem;
    overflow-x: auto;
    line-height: 1.5;
  }
  .wrap { max-width: var(--wrap); margin: 0 auto; padding: 0 max(20px, env(safe-area-inset-right)) 0 max(20px, env(safe-area-inset-left)); }
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 12px; top: 12px; background: var(--paper-2); padding: 8px 12px; z-index: 10; }

  /* print frame: a hard ink border with an offset riso-blue plate behind it */
  .tezhip {
    border: 0;
    background: var(--paper-2);
    box-shadow: none;
    clip-path: var(--chamfer);
  }
  .kicker { font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--coral-deep); }
  .ornament { display: flex; align-items: center; justify-content: center; gap: 14px; margin: 0 auto 18px; color: var(--gold); }
  .ornament::before, .ornament::after { content: ''; height: 1px; width: min(120px, 22vw); background: currentColor; }
  .ornament img { width: 44px; height: 44px; }


  /* ===== brand hero: the indigo band that opens every inner page ===== */
  main .brand-hero { position: relative; background: var(--indigo); color: var(--on-indigo); box-shadow: 0 0 0 100vmax var(--indigo); clip-path: inset(0 -100vmax); padding-top: clamp(40px, 6vw, 72px); padding-bottom: clamp(44px, 6vw, 72px); margin-top: 0 !important; margin-bottom: clamp(36px, 5vw, 56px); }
  main .brand-hero:not(.no-art) { padding-right: clamp(0px, 30vw, 360px); }
  main .brand-hero:not(.no-art)::after { content: ''; position: absolute; right: 0; top: 50%; transform: translateY(-50%); width: clamp(180px, 24vw, 300px); aspect-ratio: 1; background: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20viewBox%3D%220%200%20300%20300%22%3E%3Ccircle%20cx%3D%22120%22%20cy%3D%2210%22%20r%3D%227%22%20fill%3D%22%23E8522F%22/%3E%3Ccircle%20cx%3D%22146%22%20cy%3D%2210%22%20r%3D%227%22%20fill%3D%22%23F3C2F5%22/%3E%3Ccircle%20cx%3D%22172%22%20cy%3D%2210%22%20r%3D%227%22%20fill%3D%22%2358C4F6%22/%3E%3Ccircle%20cx%3D%22198%22%20cy%3D%2210%22%20r%3D%227%22%20fill%3D%22%23F28C38%22/%3E%3Ccircle%20cx%3D%22224%22%20cy%3D%2210%22%20r%3D%227%22%20fill%3D%22%23F7C744%22/%3E%3Ccircle%20cx%3D%22250%22%20cy%3D%2210%22%20r%3D%227%22%20fill%3D%22%23E66BF0%22/%3E%3Ccircle%20cx%3D%22276%22%20cy%3D%2210%22%20r%3D%227%22%20fill%3D%22%23F7C744%22/%3E%3Ccircle%20cx%3D%22120%22%20cy%3D%2236%22%20r%3D%227%22%20fill%3D%22%23E8522F%22/%3E%3Ccircle%20cx%3D%22146%22%20cy%3D%2236%22%20r%3D%227%22%20fill%3D%22%23F3C2F5%22/%3E%3Ccircle%20cx%3D%22172%22%20cy%3D%2236%22%20r%3D%227%22%20fill%3D%22%2358C4F6%22/%3E%3Ccircle%20cx%3D%22198%22%20cy%3D%2236%22%20r%3D%227%22%20fill%3D%22%23F28C38%22/%3E%3Ccircle%20cx%3D%22224%22%20cy%3D%2236%22%20r%3D%227%22%20fill%3D%22%23F7C744%22/%3E%3Ccircle%20cx%3D%22250%22%20cy%3D%2236%22%20r%3D%227%22%20fill%3D%22%23E66BF0%22/%3E%3Ccircle%20cx%3D%22276%22%20cy%3D%2236%22%20r%3D%227%22%20fill%3D%22%23F7C744%22/%3E%3Ccircle%20cx%3D%22120%22%20cy%3D%2262%22%20r%3D%227%22%20fill%3D%22%23E8522F%22/%3E%3Ccircle%20cx%3D%22146%22%20cy%3D%2262%22%20r%3D%227%22%20fill%3D%22%23F3C2F5%22/%3E%3Ccircle%20cx%3D%22172%22%20cy%3D%2262%22%20r%3D%227%22%20fill%3D%22%2358C4F6%22/%3E%3Ccircle%20cx%3D%22198%22%20cy%3D%2262%22%20r%3D%227%22%20fill%3D%22%23F28C38%22/%3E%3Ccircle%20cx%3D%22224%22%20cy%3D%2262%22%20r%3D%227%22%20fill%3D%22%23F7C744%22/%3E%3Ccircle%20cx%3D%22250%22%20cy%3D%2262%22%20r%3D%227%22%20fill%3D%22%23E66BF0%22/%3E%3Ccircle%20cx%3D%22276%22%20cy%3D%2262%22%20r%3D%227%22%20fill%3D%22%23F7C744%22/%3E%3Cpath%20d%3D%22M140%20110H300V290H260L240%20270V110Z%22%20fill%3D%22%23fff%22/%3E%3Cpath%20d%3D%22M18%20120H180V282H0V138Z%22%20fill%3D%22%23D6E521%22/%3E%3Cpath%20d%3D%22M180%20200H240V250H180Z%22%20fill%3D%22%234B2FD6%22/%3E%3Cg%20transform%3D%22translate%2848%20144%29%20scale%2814.5%29%22%20fill%3D%22%234B2FD6%22%3E%3Crect%20x%3D%220%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%223%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%226%22%20y%3D%220%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%220%22%20y%3D%221%22%20width%3D%222%22%20height%3D%221%22/%3E%3Crect%20x%3D%223%22%20y%3D%221%22%20width%3D%221%22%20height%3D%221%22/%3E%3Crect%20x%3D%225%22%20y%3D%221%22%20width%3D%222%22%20height%3D%221%22/%3E%3Crect%20x%3D%220%22%20y%3D%222%22%20width%3D%227%22%20height%3D%222%22/%3E%3Crect%20x%3D%221%22%20y%3D%224%22%20width%3D%225%22%20height%3D%221%22/%3E%3Crect%20x%3D%222%22%20y%3D%225%22%20width%3D%223%22%20height%3D%221%22/%3E%3Crect%20x%3D%223%22%20y%3D%226%22%20width%3D%221%22%20height%3D%223%22/%3E%3Crect%20x%3D%221%22%20y%3D%227%22%20width%3D%222%22%20height%3D%221%22/%3E%3Crect%20x%3D%224%22%20y%3D%226%22%20width%3D%222%22%20height%3D%221%22/%3E%3C/g%3E%3C/svg%3E") center / contain no-repeat; pointer-events: none; }
  @media (max-width: 860px) { main .brand-hero:not(.no-art) { padding-right: 0; } main .brand-hero:not(.no-art)::after { display: none; } }
  main .brand-hero h1 { color: #fff; font-weight: 400; font-size: clamp(2.7rem, 6vw, 5.2rem); line-height: 0.96; letter-spacing: -0.045em; max-width: 14ch; }
  main .brand-hero h1 em, main .brand-hero .accent { color: var(--lime); }
  main .brand-hero .eyebrow, main .brand-hero .kicker { font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--lime); margin: 0 0 14px; }
  main .brand-hero .eyebrow::before, main .brand-hero .kicker::before { content: '{'; }
  main .brand-hero .eyebrow::after, main .brand-hero .kicker::after { content: '}'; }
  main .brand-hero p, main .brand-hero .lede { color: var(--mute-indigo); }
  main .brand-hero a { color: var(--lime); }
  main .brand-hero a:hover { color: #fff; }
  main .brand-hero strong, main .brand-hero b { color: #fff; }
  main .brand-hero code { color: #fff; background: rgba(255, 255, 255, 0.1); }
  main .brand-hero .chips a, main .brand-hero nav a, main .brand-hero .jump a { background: transparent; border: 1px solid rgba(255, 255, 255, 0.32); color: var(--on-indigo); font-family: var(--mono); font-size: 0.74rem; letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none; }
  main .brand-hero nav a:hover, main .brand-hero .jump a:hover { background: var(--lime); border-color: var(--lime); color: var(--indigo); }
  main .brand-hero small { color: inherit; opacity: 0.7; }
  .riso-dots { display: flex; gap: 12px; margin-top: 28px; }
  .riso-dots i { width: 12px; height: 12px; border-radius: 50%; display: block; }
  @media (max-width: 480px) {
    body { font-size: 1.08rem; }
  }
  @media (prefers-reduced-motion: reduce) { * { scroll-behavior: auto !important; transition: none !important; } }
</style>
