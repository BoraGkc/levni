---
import { SITE } from '../site';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TryLevni from '../components/TryLevni.astro';

interface Props {
  title: string;
  description: string;
  og?: string;
  type?: 'website' | 'article';
  jsonld?: object[];
  published?: Date;
  bare?: boolean; // no header, footer or call-to-action band (the embedded editor)
  noindex?: boolean;
}
const { title, description, og = '/og/default.png', type = 'website', jsonld = [], published, bare = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogUrl = new URL(og, SITE.url).href;
const fullTitle = title === SITE.name ? `${SITE.name}: ${SITE.tagline}` : `${title} · ${SITE.name}`;

const org = {
  '@type': 'Organization',
  '@id': `${SITE.ortakAlan}/#organization`,
  name: 'Ortak Alan',
  url: SITE.ortakAlan,
};
const graph = [
  {
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    url: `${SITE.url}/`,
    name: SITE.name,
    description: SITE.description,
    publisher: { '@id': org['@id'] },
  },
  org,
  ...jsonld,
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Levni blog" href="/blog/rss.xml" />
    <meta name="theme-color" content="#F4F2EC" />
    <meta name="color-scheme" content="light" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Illustration drawn by Levni" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,600;0,6..72,700;1,6..72,500;1,6..72,600&family=Figtree:wght@400;500;600;700&display=swap"
    />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
  </head>
  <body>
    {!bare && <a class="skip" href="#main">Skip to content</a>}
    {!bare && <SiteHeader />}
    <main id="main">
      <slot />
    </main>
    {!bare && !['/', '/editor/'].includes(Astro.url.pathname) && <TryLevni />}
    {!bare && <SiteFooter />}
  </body>
</html>

<style is:global>
  :root {
    /* riso print: the Ortak Alan house palette */
    --paper: #f4f2ec;
    --paper-2: #fbfaf6;
    --ink: #14181f;
    --ink-soft: #4a5160;
    --rule: #d9d5cb;
    --accent: #0b57d0;      /* riso blue */
    --accent-text: #0a3fb0;
    --coral: #f2603f;
    --coral-deep: #c2401f;  /* 4.9:1 under white text */
    --mustard: #f2c230;
    --green: #1e783f;
    /* older names the pages still use */
    --gold: var(--rule);
    --gold-deep: var(--ink-soft);
    --vermilion: var(--coral-deep);
    --vermilion-deep: var(--coral-deep);
    --turquoise-text: var(--accent-text);
    --lapis: var(--accent-text);
    --serif: 'Figtree', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --display: 'Newsreader', Georgia, serif;
    --mono: ui-monospace, Menlo, Consolas, monospace;
    --wrap: 1120px;
  }
  * { box-sizing: border-box; }
  ::selection { background: var(--mustard); color: var(--ink); }
  html { accent-color: var(--accent); caret-color: var(--accent); scrollbar-color: var(--ink-soft) var(--paper); }
  :focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; border-radius: 4px; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--serif);
    font-size: 1.06rem;
    line-height: 1.6;
  }
  img { max-width: 100%; height: auto; display: block; }
  a { color: var(--lapis); text-decoration-thickness: 1px; text-underline-offset: 3px; }
  a:hover { color: var(--vermilion); }
  h1, h2, h3 { font-family: var(--display); font-weight: 600; line-height: 1.1; color: var(--ink); margin: 0 0 0.5em; }
  h1 { font-size: clamp(2.6rem, 7vw, 4.6rem); }
  h2 { font-size: clamp(2rem, 4.5vw, 3rem); }
  h3 { font-size: 1.6rem; }
  em.accent, .accent { font-family: var(--display); font-style: italic; color: var(--vermilion); }
  code, pre { font-family: var(--mono); font-size: 0.86rem; }
  pre {
    background: var(--paper-2);
    border: 1px solid var(--gold);
    padding: 1.1rem 1.2rem;
    overflow-x: auto;
    line-height: 1.5;
  }
  .wrap { max-width: var(--wrap); margin: 0 auto; padding: 0 20px; }
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 12px; top: 12px; background: var(--paper-2); padding: 8px 12px; z-index: 10; }

  .site-header { border-bottom: 2px solid var(--ink); background: var(--paper); }
  .header-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 68px; flex-wrap: wrap; }
  .wordmark { display: flex; align-items: center; gap: 6px; text-decoration: none; color: var(--ink); }
  .wordmark img { width: 40px; height: 40px; }
  .wordmark span { font-family: var(--display); font-style: italic; font-weight: 600; font-size: 1.7rem; }
  nav { display: flex; gap: 6px 18px; flex-wrap: wrap; font-size: 1.02rem; }
  nav a { color: var(--ink); text-decoration: none; padding: 10px 0; }
  nav a:hover { color: var(--vermilion); }


  /* print frame: a hard ink border with an offset riso-blue plate behind it */
  .tezhip {
    border: 2px solid var(--ink);
    background: var(--paper-2);
    box-shadow: 6px 6px 0 var(--accent);
  }
  .ornament { display: flex; align-items: center; justify-content: center; gap: 14px; margin: 0 auto 18px; color: var(--gold); }
  .ornament::before, .ornament::after { content: ''; height: 1px; width: min(120px, 22vw); background: currentColor; }
  .ornament img { width: 44px; height: 44px; }

  @media (max-width: 480px) {
    body { font-size: 1.08rem; }
  }
  @media (prefers-reduced-motion: reduce) { * { scroll-behavior: auto !important; transition: none !important; } }
</style>
