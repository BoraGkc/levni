{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Levni scene",
  "description": "A scene is an ordered list of elements drawn on a 1200x673 canvas. Full field reference: docs/scene.md",
  "type": "object",
  "properties": {
    "seed": {
      "type": "integer",
      "default": 1
    },
    "background": {
      "$ref": "#/$defs/color",
      "default": "paper"
    },
    "clip": {
      "$ref": "#/$defs/rect"
    },
    "hand": {
      "type": "boolean",
      "default": true
    },
    "plateShift": {
      "type": "number",
      "default": 3.2
    },
    "boil": {
      "type": "integer"
    },
    "t": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "locale": {
      "type": "string",
      "default": "en"
    },
    "elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/element"
      }
    },
    "style": {
      "enum": [
        "riso",
        "miniature"
      ],
      "default": "riso"
    },
    "finish": {
      "enum": [
        "crayon",
        "soft"
      ],
      "default": "crayon"
    },
    "grain": {
      "type": "number",
      "default": 0.16
    }
  },
  "required": [
    "elements"
  ],
  "$defs": {
    "color": {
      "anyOf": [
        {
          "enum": [
            "blue",
            "ink",
            "coral",
            "mustard",
            "green",
            "paper",
            "white",
            "dark",
            "tone",
            "tone-coral",
            "tone-green",
            "tone-mustard",
            "none"
          ]
        },
        {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      ]
    },
    "rect": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "point": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "path": {
      "type": "object",
      "properties": {
        "d": {
          "type": "string",
          "description": "SVG path data in a 0..100 box"
        },
        "fill": {
          "$ref": "#/$defs/color"
        },
        "stroke": {
          "$ref": "#/$defs/color"
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "description": "line width in output pixels"
        },
        "dash": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/point"
            }
          ]
        },
        "taper": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "number"
            }
          ]
        },
        "rule": {
          "enum": [
            "evenodd",
            "nonzero"
          ]
        }
      },
      "required": [
        "d"
      ]
    },
    "element": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "prop",
            "draw",
            "icon",
            "ascii",
            "iso",
            "panel",
            "disc",
            "glyphs",
            "waves",
            "hills",
            "skyline",
            "halftone",
            "flowfield",
            "hatch",
            "confetti",
            "marks",
            "crowd",
            "isotype",
            "person",
            "people",
            "sheet",
            "window",
            "bubble",
            "stack",
            "tree",
            "plant",
            "cloud",
            "sunburst",
            "rose",
            "spiro",
            "flag",
            "badge",
            "ticks",
            "arrow",
            "line",
            "shape",
            "brush",
            "label",
            "ribbon",
            "tube",
            "image",
            "bars",
            "linechart",
            "pie",
            "donut",
            "isochart"
          ]
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "size": {
          "type": "number"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "rot": {
          "type": "number"
        },
        "crop": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "pose": {
          "enum": ["standing","walking","running","sitting","pointing","waving","raising-arm","holding","carrying","reading","phone","thinking","cheering","kneeling","leaning"],
          "description": "person: body pose"
        },
        "facing": {
          "enum": ["left", "right", "alternate"],
          "description": "person: facing (alternate is for people)"
        },
        "accent": {
          "$ref": "#/$defs/color"
        },
        "accentKind": {
          "enum": ["scarf", "bag"]
        },
        "hold": {
          "type": "string",
          "description": "person with pose holding: name of a library prop drawn at the hands"
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": true
    }
  }
}
