{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Levni scene",
  "description": "A scene is an ordered list of elements drawn on a canvas (default 1200x673, see format/canvas). Full field reference: docs/scene.md",
  "type": "object",
  "properties": {
    "seed": {
      "type": "integer",
      "default": 1
    },
    "background": {
      "$ref": "#/$defs/color",
      "default": "paper"
    },
    "clip": {
      "$ref": "#/$defs/rect"
    },
    "hand": {
      "type": "boolean",
      "default": true
    },
    "plateShift": {
      "type": "number",
      "default": 3.2
    },
    "boil": {
      "type": "integer"
    },
    "t": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "locale": {
      "type": "string",
      "default": "en"
    },
    "elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/element"
      }
    },
    "style": {
      "description": "Style pack name, or your own inks: house colour name -> hex.",
      "oneOf": [
        {
          "enum": [
            "riso",
            "miniature"
          ]
        },
        {
          "type": "object",
          "propertyNames": {
            "enum": [
              "paper",
              "white",
              "ink",
              "blue",
              "coral",
              "green",
              "mustard",
              "dark",
              "tone",
              "tone-coral",
              "tone-green",
              "tone-mustard"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        }
      ]
    },
    "finish": {
      "enum": [
        "crayon",
        "soft"
      ],
      "default": "crayon"
    },
    "grain": {
      "type": "number",
      "default": 0.16
    },
    "format": {
      "enum": [
        "cover",
        "og",
        "square",
        "story",
        "youtube"
      ],
      "default": "cover"
    },
    "canvas": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 64,
        "maximum": 8192
      },
      "minItems": 2,
      "maxItems": 2
    },
    "reflow": {
      "type": "boolean",
      "default": false
    },
    "reflowFrom": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2,
      "default": [
        1200,
        673
      ]
    },
    "title": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "kicker": {
          "type": "string"
        },
        "brand": {
          "type": "string"
        },
        "position": {
          "enum": [
            "bottom",
            "top",
            "left",
            "band"
          ],
          "default": "bottom"
        },
        "font": {
          "anyOf": [
            {
              "enum": [
                "serif",
                "sans",
                "mono"
              ]
            },
            {
              "type": "object",
              "required": [
                "file"
              ],
              "properties": {
                "file": {
                  "type": "string"
                },
                "weight": {
                  "type": "number"
                },
                "width": {
                  "type": "number"
                }
              }
            }
          ],
          "default": "serif"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "kickerColor": {
          "$ref": "#/$defs/color"
        },
        "band": {
          "$ref": "#/$defs/color"
        }
      }
    }
  },
  "required": [
    "elements"
  ],
  "$defs": {
    "color": {
      "anyOf": [
        {
          "enum": [
            "blue",
            "ink",
            "coral",
            "mustard",
            "green",
            "paper",
            "white",
            "dark",
            "tone",
            "tone-coral",
            "tone-green",
            "tone-mustard",
            "none"
          ]
        },
        {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      ]
    },
    "rect": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "point": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "path": {
      "type": "object",
      "properties": {
        "d": {
          "type": "string",
          "description": "SVG path data in a 0..100 box"
        },
        "fill": {
          "$ref": "#/$defs/color"
        },
        "stroke": {
          "$ref": "#/$defs/color"
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "description": "line width in output pixels"
        },
        "dash": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/point"
            }
          ]
        },
        "taper": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "number"
            }
          ]
        },
        "rule": {
          "enum": [
            "evenodd",
            "nonzero"
          ]
        }
      },
      "required": [
        "d"
      ]
    },
    "element": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "prop",
            "draw",
            "icon",
            "ascii",
            "iso",
            "panel",
            "disc",
            "glyphs",
            "waves",
            "hills",
            "skyline",
            "halftone",
            "flowfield",
            "hatch",
            "confetti",
            "marks",
            "crowd",
            "isotype",
            "person",
            "people",
            "sheet",
            "window",
            "bubble",
            "stack",
            "tree",
            "plant",
            "cloud",
            "sunburst",
            "rose",
            "spiro",
            "flag",
            "badge",
            "ticks",
            "arrow",
            "line",
            "shape",
            "brush",
            "label",
            "ribbon",
            "tube",
            "image",
            "soft3d",
            "ribbon3d",
            "tube3d",
            "torus3d",
            "sphere3d",
            "capsule3d",
            "blob3d",
            "cubes3d",
            "extrude3d",
            "bars",
            "linechart",
            "pie",
            "donut",
            "isochart"
          ]
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "size": {
          "type": "number"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "rot": {
          "type": "number"
        },
        "crop": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "pose": {
          "enum": ["standing","walking","running","sitting","pointing","waving","raising-arm","holding","carrying","reading","phone","thinking","cheering","kneeling","leaning"],
          "description": "person: body pose"
        },
        "facing": {
          "enum": ["left", "right", "alternate"],
          "description": "person: facing (alternate is for people)"
        },
        "accent": {
          "$ref": "#/$defs/color"
        },
        "accentKind": {
          "enum": ["scarf", "bag"]
        },
        "hold": {
          "type": "string",
          "description": "person with pose holding: name of a library prop drawn at the hands"
        },
        "id": {
          "type": "string",
          "description": "a handle other elements can point at with in.ref"
        },
        "in": {
          "type": "object",
          "description": "place this element in a named slot of an earlier prop (docs/scene.md, Slots)",
          "properties": {
            "ref": { "type": "string", "description": "id of an earlier element" },
            "prop": { "type": "string", "description": "name of a prop; the most recent one is used" },
            "slot": { "type": "string" }
          },
          "required": ["slot"]
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "preset": {
          "type": "string",
          "description": "soft3d: auto, ribbon, wave, mobius, spiral, knot, rings, orbit, pebbles, stack. ribbon3d / tube3d: loop, s-curve, wave, spiral, mobius, knot, ring"
        },
        "palette": {
          "description": "soft3d cover theme: aqua, sunset, mint-night, lilac, mono-blue, or { background: [a, b], stops: [...] }",
          "anyOf": [
            { "enum": ["aqua", "sunset", "mint-night", "lilac", "mono-blue"] },
            { "type": "object" }
          ]
        },
        "rotate": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3,
          "description": "soft 3D: [rx, ry, rz] in degrees, x first, then y, then z"
        },
        "objects": {
          "type": "array",
          "items": { "type": "object" },
          "description": "soft3d: shapes sharing one camera and one depth sort (torus, sphere, capsule, blob, cubes, ribbon, tube), each with x, y, z, size, rotate"
        },
        "depth": {
          "type": "number",
          "description": "extrude3d: thickness as a fraction of size (default 0.16)"
        },
        "lines": {
          "enum": ["raised", "none"],
          "description": "extrude3d: draw the prop's ink lines as a raised rim (default) or leave them out"
        },
        "twist": {
          "type": "number",
          "description": "ribbon3d: turns along the length (a closed band with 0.5 is a Möbius strip)"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": true
    }
  }
}
